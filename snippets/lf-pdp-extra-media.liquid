{%- doc -%}
  Fills dead space in left media column with product video + image, or 2 product images.
  Desktop only — hidden on mobile.

  @param {product} product - the current product object
{%- enddoc -%}

{%- liquid
  assign _vids   = product.media | where: 'media_type', 'video'
  assign _imgs   = product.media | where: 'media_type', 'image'
  assign _show   = false
  if _vids.size > 0
    assign _show = true
  elsif _imgs.size > 1
    assign _show = true
  endif
-%}

{%- if _show -%}
  <div class="lf-extra-media">

    {%- if _vids.size > 0 -%}

      {%- assign _vid = _vids.first -%}
      <div class="lf-extra-media__cell lf-extra-media__cell--video">
        <video class="lf-em-video" autoplay muted loop playsinline>
          {%- for src in _vid.sources -%}
            <source src="{{ src.url }}" type="{{ src.mime_type }}">
          {%- endfor -%}
        </video>
        <button class="lf-em-sound-btn" aria-label="Toggle sound" type="button">
          <svg class="lf-em-icon-muted" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
          </svg>
          <svg class="lf-em-icon-sound" viewBox="0 0 24 24" aria-hidden="true" style="display:none">
            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
          </svg>
        </button>
      </div>

      {%- assign _side = nil -%}
      {%- if _imgs.size > 1 -%}
        {%- assign _side = _imgs[1] -%}
      {%- elsif _imgs.size == 1 -%}
        {%- assign _side = _imgs[0] -%}
      {%- endif -%}
      {%- if _side != nil -%}
        <div class="lf-extra-media__cell">
          <img
            src="{{ _side | image_url: width: 700 }}"
            alt="{{ _side.alt | default: product.title | escape }}"
            loading="lazy"
            width="700"
            height="700"
          >
        </div>
      {%- endif -%}

    {%- else -%}

      <div class="lf-extra-media__cell">
        <img
          src="{{ _imgs[1] | image_url: width: 700 }}"
          alt="{{ _imgs[1].alt | default: product.title | escape }}"
          loading="lazy"
          width="700"
          height="700"
        >
      </div>
      {%- if _imgs.size > 2 -%}
        <div class="lf-extra-media__cell">
          <img
            src="{{ _imgs[2] | image_url: width: 700 }}"
            alt="{{ _imgs[2].alt | default: product.title | escape }}"
            loading="lazy"
            width="700"
            height="700"
          >
        </div>
      {%- endif -%}

    {%- endif -%}

  </div>
{%- endif -%}

{% stylesheet %}

.lf-extra-media {
  display: none;
}

@media screen and (min-width: 900px) {
  .lf-extra-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px;
    margin-top: 8px;
  }

  .lf-extra-media__cell {
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #f5f3f0;
  }

  .lf-extra-media__cell img,
  .lf-extra-media__cell video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lf-extra-media__cell--video {
    position: relative;
  }

  .lf-em-sound-btn {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    background: rgba(0, 0, 0, 0.48);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: background 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .lf-em-sound-btn:hover {
    background: rgba(0, 0, 0, 0.72);
  }

  .lf-em-sound-btn svg {
    width: 16px;
    height: 16px;
    fill: #fff;
    display: block;
  }
}

{% endstylesheet %}

<script>
(function () {
  document.querySelectorAll('.lf-extra-media__cell--video').forEach(function (cell) {
    var video = cell.querySelector('.lf-em-video');
    var btn   = cell.querySelector('.lf-em-sound-btn');
    if (!video || !btn) return;
    var iconMuted = btn.querySelector('.lf-em-icon-muted');
    var iconSound = btn.querySelector('.lf-em-icon-sound');

    btn.addEventListener('click', function () {
      video.muted = !video.muted;
      iconMuted.style.display = video.muted ? '' : 'none';
      iconSound.style.display = video.muted ? 'none' : '';
      btn.setAttribute('aria-label', video.muted ? 'Unmute video' : 'Mute video');
    });
  });
})();
</script>
