{%- liquid
  assign bc_col = collection | default: nil
  if bc_col == nil and request.page_type == 'product'
    assign bc_col = product.collections.first
  endif
-%}

{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'article' -%}
<nav class="breadcrumb page-width" aria-label="Breadcrumb">
  <ol class="breadcrumb__list">
    <li class="breadcrumb__item">
      <a class="breadcrumb__link" href="/">Home</a>
    </li>

    {%- if request.page_type == 'product' -%}
      {%- if bc_col != blank -%}
        <li class="breadcrumb__item breadcrumb__sep" aria-hidden="true">/</li>
        <li class="breadcrumb__item">
          <a class="breadcrumb__link" href="{{ bc_col.url }}">{{ bc_col.title }}</a>
        </li>
      {%- endif -%}
      <li class="breadcrumb__item breadcrumb__sep" aria-hidden="true">/</li>
      <li class="breadcrumb__item breadcrumb__current" aria-current="page">{{ product.title }}</li>

    {%- elsif request.page_type == 'collection' -%}
      <li class="breadcrumb__item breadcrumb__sep" aria-hidden="true">/</li>
      <li class="breadcrumb__item breadcrumb__current" aria-current="page">{{ collection.title }}</li>

    {%- elsif request.page_type == 'article' -%}
      <li class="breadcrumb__item breadcrumb__sep" aria-hidden="true">/</li>
      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="{{ blog.url }}">{{ blog.title }}</a>
      </li>
      <li class="breadcrumb__item breadcrumb__sep" aria-hidden="true">/</li>
      <li class="breadcrumb__item breadcrumb__current" aria-current="page">{{ article.title }}</li>
    {%- endif -%}
  </ol>
</nav>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ shop.url }}"
    }
    {%- if request.page_type == 'product' -%}
      {%- if bc_col != blank -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ bc_col.title | json }},
      "item": "{{ shop.url }}{{ bc_col.url }}"
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": "{{ shop.url }}{{ product.url }}"
    }
      {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": "{{ shop.url }}{{ product.url }}"
    }
      {%- endif -%}
    {%- elsif request.page_type == 'collection' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": "{{ shop.url }}{{ collection.url }}"
    }
    {%- elsif request.page_type == 'article' -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": "{{ shop.url }}{{ blog.url }}"
    }
    ,{
      "@type": "ListItem",
      "position": 3,
      "name": {{ article.title | json }},
      "item": "{{ shop.url }}{{ article.url }}"
    }
    {%- endif -%}
  ]
}
</script>

<style>
  .breadcrumb { padding: 12px 0 0; }
  .breadcrumb__list { display: flex; flex-wrap: wrap; align-items: center; list-style: none; margin: 0; padding: 0; gap: 4px; }
  .breadcrumb__item { font-size: 0.72rem; letter-spacing: 0.03em; color: #999; }
  .breadcrumb__sep { color: #ccc; }
  .breadcrumb__current { color: #555; }
  .breadcrumb__link { color: #999; text-decoration: none; }
  .breadcrumb__link:hover { color: #222; text-decoration: underline; }
</style>
{%- endif -%}
