{% doc %}
Stock status with delivery date, payment icons, and three USP icons.
@param {string} uid - Unique id for this instance
@param {object} [variant] - Selected variant
@param {string} [status_text] - In-stock label
@param {string} [pre_date_text] - Text before the delivery date
@param {number} [delivery_days] - End of delivery window in days
@param {string} [usp_1] - First USP
@param {string} [usp_2] - Second USP
@param {string} [usp_3] - Third USP
@param {string} [part] - `stock` (above ATC), `rest` (payments + USPs), or `all`
@example
{% render 'pdp-buy-trust', uid: section.id, variant: product.selected_or_first_available_variant %}
{% enddoc %}

{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  assign in_label = status_text | default: 'In stock'
  assign status_text = in_label
  assign pre_date_text = pre_date_text | default: 'Order now for delivery'
  assign delivery_days = delivery_days | default: 8
  assign usp_1 = usp_1 | default: 'Genuine products'
  assign usp_2 = usp_2 | default: 'Expert-curated'
  assign usp_3 = usp_3 | default: 'Tracked UK dispatch'
  assign stock_mod = 'in'
  assign extra_hidden = false
  if v.available == false
    assign status_text = 'Sold out'
    assign stock_mod = 'out'
    assign extra_hidden = true
  elsif v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and v.inventory_quantity > 0 and v.inventory_quantity <= 10
    assign status_text = 'Only ' | append: v.inventory_quantity | append: ' left in stock'
    assign stock_mod = 'low'
  endif
-%}

<div
  class="pdp-buy-trust"
  id="pdp-buy-trust-{{ uid }}"
  data-in-label="{{ in_label | escape }}"
  data-out-label="Sold out"
>
  <div class="pdp-trust-stock pdp-trust-stock--{{ stock_mod }}">
    <span class="pdp-trust-dot" aria-hidden="true"></span>
    <span class="pdp-trust-stock-text">
      <strong class="pdp-trust-status">{{ status_text }}</strong>
      <span class="pdp-trust-extra"{% if extra_hidden %} hidden{% endif %}>
        {{ pre_date_text }}
        <span class="pdp-trust-date" data-delivery-days="{{ delivery_days }}">…</span>
      </span>
    </span>
  </div>

  <div class="WI_paymentIcons">
    <ul class="payment-icons" aria-label="Accepted payment methods">
      {%- assign active_payments = 'american_express,apple_pay,google_pay,master,paypal,shop_pay,unionpay,visa' | split: ',' -%}
      {%- for type in active_payments -%}
        <li>{{ type | payment_type_svg_tag: class: 'dp-payment-icon' }}</li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="pdp-trust-icons">
    {%- if usp_1 != blank -%}
      <div class="pdp-trust-icon-item">
        <span class="pdp-trust-icon-svg" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <span>{{ usp_1 }}</span>
      </div>
    {%- endif -%}
    {%- if usp_2 != blank -%}
      <div class="pdp-trust-icon-item">
        <span class="pdp-trust-icon-svg" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3"/><path d="M4 20c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
        </span>
        <span>{{ usp_2 }}</span>
      </div>
    {%- endif -%}
    {%- if usp_3 != blank -%}
      <div class="pdp-trust-icon-item">
        <span class="pdp-trust-icon-svg" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="1.5"/><circle cx="18.5" cy="18.5" r="1.5"/></svg>
        </span>
        <span>{{ usp_3 }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

{% javascript %}
  window.pdpTrustFillDates = function () {
    document.querySelectorAll('.pdp-trust-date[data-delivery-days]').forEach(function (el) {
      if (el.getAttribute('data-filled') === '1') return;
      var endDays = parseInt(el.getAttribute('data-delivery-days'), 10) || 8;
      var startDays = Math.max(1, endDays - 2);
      var today = new Date();
      var start = new Date(today);
      start.setDate(today.getDate() + startDays);
      var end = new Date(today);
      end.setDate(today.getDate() + endDays);
      var month = end.toLocaleString('en-GB', { month: 'short' }).toLowerCase();
      el.textContent = start.getDate() + ' - ' + end.getDate() + ' ' + month + ', ' + end.getFullYear();
      el.setAttribute('data-filled', '1');
    });
  };

  window.pdpTrustRefresh = function (uid, variant) {
    var root = typeof uid === 'string' ? document.getElementById('pdp-buy-trust-' + uid) : uid;
    if (!root || !variant) return;
    var wrap = root.querySelector('.pdp-trust-stock');
    var status = root.querySelector('.pdp-trust-status');
    var extra = root.querySelector('.pdp-trust-extra');
    if (!wrap || !status) return;
    var inLabel = root.getAttribute('data-in-label') || 'In stock';
    var outLabel = root.getAttribute('data-out-label') || 'Sold out';
    wrap.classList.remove('pdp-trust-stock--in', 'pdp-trust-stock--out', 'pdp-trust-stock--low');
    if (variant.available === false) {
      wrap.classList.add('pdp-trust-stock--out');
      status.textContent = outLabel;
      if (extra) extra.hidden = true;
      return;
    }
    var qty = typeof variant.inventory_quantity === 'number' ? variant.inventory_quantity : null;
    if (qty !== null && qty > 0 && qty <= 10) {
      wrap.classList.add('pdp-trust-stock--low');
      status.textContent = 'Only ' + qty + ' left in stock';
    } else {
      wrap.classList.add('pdp-trust-stock--in');
      status.textContent = inLabel;
    }
    if (extra) extra.hidden = false;
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', window.pdpTrustFillDates);
  } else {
    window.pdpTrustFillDates();
  }
{% endjavascript %}

{% stylesheet %}
  .pdp-buy-trust {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }

  .pdp-trust-stock {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 13px;
    line-height: 1.35;
    color: #141414;
  }

  .pdp-trust-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #26d07c;
    box-shadow: 0 0 0 3px #d9fbe8;
    flex-shrink: 0;
  }

  .pdp-trust-stock--out .pdp-trust-dot {
    background: #bbb;
    box-shadow: none;
  }

  .pdp-trust-stock--low .pdp-trust-dot {
    background: #c0392b;
    box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.18);
  }

  .pdp-trust-stock-text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .pdp-trust-status {
    font-weight: 700;
  }

  .pdp-trust-extra[hidden] {
    display: none;
  }

  .pdp-trust-date {
    font-weight: 400;
  }

  .WI_paymentIcons {
    margin-top: 2px;
  }

  .WI_paymentIcons .payment-icons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 6px;
  }

  .WI_paymentIcons .payment-icons li {
    display: flex;
    align-items: center;
  }

  .WI_paymentIcons .dp-payment-icon {
    height: 24px;
    width: auto;
    display: block;
  }

  .pdp-trust-icons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding-top: 2px;
  }

  .pdp-trust-icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 6px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 600;
    color: #141414;
  }

  .pdp-trust-icon-svg {
    width: 22px;
    height: 22px;
    color: #141414;
  }

  .pdp-trust-icon-svg svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 600px) {
    .pdp-buy-trust {
      align-items: stretch;
    }

    .pdp-trust-stock,
    .WI_paymentIcons .payment-icons {
      justify-content: flex-start;
    }

    .pdp-trust-icons {
      gap: 6px;
      width: 100%;
    }

    .pdp-trust-icon-item {
      font-size: 10px;
    }
  }
{% endstylesheet %}
