{%- doc -%}
  Renders the trust 2×2 grid + privilege card(s) below the product gallery.
  Desktop only — hidden via CSS on mobile (right panel shows instead).

  @param {string} priv_b      - brand name (nil if no offer for this brand)
  @param {string} priv_titles - pipe-separated gift titles (e.g. "Gift A|Gift B")
  @param {string} priv_spends - pipe-separated spend thresholds (e.g. "£100|£150")
{%- enddoc -%}

<div class="lf-left-extras">

  <div class="lf-trust-grid">
    <div class="lf-trust-cell">
      <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 2L3 7v5c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V7l-9-5zm-1 13l-3-3 1.41-1.41L11 12.17l4.59-4.58L17 9l-6 6z"/>
      </svg>
      <span class="lf-tc-text">Authentic professional skincare</span>
    </div>
    <div class="lf-trust-cell">
      <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM15.1 8H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
      </svg>
      <span class="lf-tc-text">Secure checkout</span>
    </div>
    <div class="lf-trust-cell">
      <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-.5 1.5l1.96 2.5H17V9.5h2.5zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm2.22-3c-.55-.61-1.35-1-2.22-1s-1.67.39-2.22 1H3v-9h12v9H8.22zm9.78 3c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
      </svg>
      <span class="lf-tc-text">UK tracked delivery</span>
    </div>
    <div class="lf-trust-cell">
      <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
      </svg>
      <span class="lf-tc-text">Flexible payment options</span>
    </div>
  </div>


</div>
