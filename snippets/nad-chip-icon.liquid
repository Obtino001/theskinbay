{%- comment -%} shared chip/pillar icon by name — used by hero chips (per-product highlights) {%- endcomment -%}
{%- case icon -%}
  {%- when 'bolt' -%}<svg viewBox="0 0 24 24"><path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z"/></svg>
  {%- when 'sparkle' -%}<svg viewBox="0 0 24 24"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/></svg>
  {%- when 'brain' or 'gem' -%}<svg viewBox="0 0 24 24"><path d="M6 9.5 12 4l6 5.5-6 10.5z"/><path d="M6 9.5h12"/></svg>
  {%- when 'drop' -%}<svg viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>
  {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/></svg>
  {%- when 'clock' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
  {%- when 'molecule' -%}<svg viewBox="0 0 24 24"><circle cx="6" cy="6.5" r="2.2"/><circle cx="18" cy="7" r="2.2"/><circle cx="9.5" cy="17.5" r="2.2"/><circle cx="17" cy="16.5" r="2.2"/><path d="M8 7l7.8 .6M8.1 16l7.4-7M11.7 17.3l3.6-.5"/></svg>
  {%- when 'star' -%}<svg viewBox="0 0 24 24"><path d="M12 3l2.5 6 6.5.5-5 4 1.6 6.3L12 16.9 6.9 19.8 8.5 13.5l-5-4 6.5-.5z"/></svg>
  {%- when 'flame' -%}<svg viewBox="0 0 24 24"><path d="M12 3c1 4-3 5-3 9a3 3 0 0 0 6 0c0-1.5-1-2-1-3 2 1 3 3 3 5a5 5 0 0 1-10 0c0-4.5 4-6 5-11z"/></svg>
  {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14z"/><path d="M5 19c4-4 7-6 10-7"/></svg>
  {%- when 'sun' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"/></svg>
  {%- else -%}<svg viewBox="0 0 24 24"><path d="M5 12l4 4 10-10"/></svg>
{%- endcase -%}
