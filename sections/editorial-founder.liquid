{%- style -%}
  .founder-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: #1a1a1a;
    font-family: 'Lato', sans-serif;
  }

  .founder-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr; /* Equal split for balance */
    gap: 80px;
    align-items: center; /* Centers image and text vertically */
  }

  /* Typography */
  .founder-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 30px 0;
    letter-spacing: -0.02em;
  }

  .founder-bio {
    font-family: 'Lato', sans-serif;
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    line-height: 1.6;
    text-align: left;
  }

  .founder-bio p {
    margin-bottom: 25px;
    color: #444;
  }

  /* Visuals */
  .founder-visuals {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .main-founder-img {
    width: 100%;
    max-width: 460px;
    height: auto;
    display: block;
    aspect-ratio: 1/1;
    object-fit: cover;
    border-radius: 50%;
  }

  /* Signature Block */
  .signature-wrapper {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(0,0,0,.1);
  }

  .sig-name {
    display: block;
    font-family: 'Lato', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #111;
    margin-bottom: 8px;
  }

  .sig-sub {
    font-family: 'Lato', sans-serif;
    font-size: 0.8125rem;
    font-weight: 400;
    color: rgba(0,0,0,0.5);
    line-height: 1.5;
    letter-spacing: 0;
  }

  @media screen and (max-width: 990px) {
    .founder-container { grid-template-columns: 1fr; gap: 40px; }
    .main-founder-img { max-width: 280px; }
    .founder-title { font-size: clamp(1.75rem, 5vw, 2.5rem); }
  }
{%- endstyle -%}

<section class="founder-section-{{ section.id }}">
  <div class="founder-container">
    
    <!-- Left Column: Image -->
    <div class="founder-visuals">
      {% if section.settings.main_image != blank %}
        {{
          section.settings.main_image
          | image_url: width: 1000
          | image_tag:
            widths: '400, 700, 1000, 1400',
            sizes: '(min-width: 750px) 50vw, 100vw',
            alt: 'Emmalee Fitton',
            class: 'main-founder-img',
            loading: 'lazy'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'main-founder-img' }}
      {% endif %}
    </div>

    <!-- Right Column: Content -->
    <div class="founder-content">
      <h2 class="founder-title">{{ section.settings.heading }}</h2>
      
      <div class="founder-bio">
        {{ section.settings.bio_content }}
      </div>

      <div class="signature-wrapper">
         <span class="sig-name">{{ section.settings.founder_name }}</span>
         <span class="sig-sub">{{ section.settings.founder_sub }}</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Founder Clean Editorial",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR FOUNDER"
    },
    {
      "type": "richtext",
      "id": "bio_content",
      "label": "Biography",
      "default": "<p>TheSkinBay was started in 2020 by Emmalee because she is a master in knowledge in skincare and scent. After years in one-to-one situations where she consulted about skin and products, gaining this knowledge she decided to open a store of her specialist buys, stocking only the best in beauty.</p><p>As a dedicated family lady with 2 beautiful girls and a loving partner, she built this empire on the love of consultation. Every person who leaves her treatment with a smile is why she started it all.</p>"
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Name",
      "default": "EMMALEE FITTON"
    },
    {
      "type": "text",
      "id": "founder_sub",
      "label": "Position",
      "default": "FOUNDER & SKINCARE MASTER"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 30, "max": 80, "step": 2, "unit": "px", "label": "Heading Size", "default": 48
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Heading Weight",
      "options": [
        {"value": "400", "label": "Normal"},
        {"value": "700", "label": "Bold"},
        {"value": "900", "label": "Black"}
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 14, "max": 20, "step": 1, "unit": "px", "label": "Bio Text Size", "default": 16
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Bio Text Weight",
      "options": [
        {"value": "300", "label": "Light"},
        {"value": "400", "label": "Normal"}
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Spacing & Colors"
    },
    {
      "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff"
    },
    {
      "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top Padding", "default": 80
    },
    {
      "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom Padding", "default": 80
    }
  ],
  "presets": [
    {
      "name": "Founder Clean Editorial"
    }
  ]
}
{% endschema %}