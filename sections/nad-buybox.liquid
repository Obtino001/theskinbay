      .pgp-tag { display:inline-flex; align-items:center; gap:6px; font-size:9.5px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:#b08d3f; } .pgp-tag svg { width:13px; height:13px; }
      .pgp-row { display:grid; grid-template-columns:1fr 24px 1fr; align-items:start; gap:6px; padding:20px 18px; }
      .pgp-item { display:flex; gap:12px; align-items:flex-start; min-width:0; } .pgp-img { flex-shrink:0; display:block; } .pgp-img img { width:84px; height:84px; object-fit:cover; border-radius:4px; display:block; }
