    <span style="font-size:20px; font-weight:600;" id="StickyPrice-{{sb_uid}}">{{ current_variant.price | money }}</span>
    <button class="omni-btn omni-btn-checkout" style="width:auto; padding: 12px 30px; border-radius:4px;" onclick="omniAction('now')">CHECKOUT</button>
  </div>
</div>

<script>
const prodData = JSON.parse(document.querySelector('.omni-perfect-{{sb_uid}}').dataset.productJson);
let selOptions = [{% for option in product.options_with_values %}'{{ option.selected_value | escape }}',{% endfor %}];
let subDiscount = { val: 0, type: '' };
let currentSlide = 0;

function omniUpdateVariant(btn, val, idx) {
  const group = btn.closest('.omni-opt-group');
  group.querySelectorAll('button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById(`LabelVal-{{sb_uid}}-${idx}`).innerText = val;
  selOptions[idx] = val;
  const variant = prodData.variants.find(v => JSON.stringify(v.options) === JSON.stringify(selOptions));
  if(variant) {
    document.getElementById('VariantId-{{sb_uid}}').value = variant.id;
    omniRefreshPrice(variant);
    if(variant.featured_image) {
      const imgIdx = prodData.images.findIndex(img => img.includes(variant.featured_image.src.split('/').pop().split('?')[0]));
      if(imgIdx !== -1) omniJump(imgIdx);
    }
  }
}

function omniUpdateSub(card, planId, discVal, discType) {
  document.querySelectorAll('.omni-sub-card').forEach(c => c.classList.remove('active'));
  card.classList.add('active');
  document.getElementById('SellingPlan-{{sb_uid}}').value = planId;
  subDiscount = { val: parseFloat(discVal || 0), type: discType || '' };
  const variant = prodData.variants.find(v => v.id == document.getElementById('VariantId-{{sb_uid}}').value);
  omniRefreshPrice(variant);
}

function omniRefreshPrice(variant) {
  let finalPrice = variant.price;
  if(subDiscount.val > 0) {
    if(subDiscount.type === 'percentage') finalPrice = finalPrice * (1 - (subDiscount.val / 100));
    else finalPrice = finalPrice - (subDiscount.val * 100);
  }
  const fmt = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }).format(finalPrice / 100);
  document.getElementById('Price-{{sb_uid}}').innerText = fmt;
  document.getElementById('StickyPrice-{{sb_uid}}').innerText = fmt;
  var _sb = document.getElementById('SaveBadge-{{sb_uid}}');
  if (_sb) {
    var _cap = variant.compare_at_price || 0;
    if (_cap > finalPrice) { _sb.textContent = 'Save ' + Math.round((_cap - finalPrice) / _cap * 100) + '%'; _sb.style.display = ''; }
    else { _sb.style.display = 'none'; }
  }
}

function omniJump(i) {
  currentSlide = i;
  const track = document.getElementById('Track-{{sb_uid}}');
  const stage = document.getElementById('Stage-{{sb_uid}}');
  if(window.innerWidth > 768) {
    const dslide = track.querySelectorAll('.omni-slide')[i];
    if(dslide) dslide.scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else {
    const slide = stage.querySelectorAll('.omni-slide')[i];
    stage.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
  }
  document.querySelectorAll('.omni-thumb').forEach((t, idx) => { t.classList.toggle('active', idx === i); });
}

function omniMove(dir) {
  const count = prodData.images.length;
  currentSlide = (currentSlide + dir + count) % count;
  omniJump(currentSlide);
}

function omniThumbScroll(dir) {
  const rail = document.getElementById('ThumbsRail-{{sb_uid}}');
  if(!rail) return;
  rail.scrollBy({ left: dir * Math.max(220, rail.clientWidth * 0.7), behavior: 'smooth' });
}
function omniThumbSync() {
  const wrap = document.getElementById('ThumbsWrap-{{sb_uid}}');
  const rail = document.getElementById('ThumbsRail-{{sb_uid}}');
  if(!wrap || !rail) return;
  wrap.classList.toggle('is-scrollable', rail.scrollWidth > rail.clientWidth + 2);
}
window.addEventListener('load', omniThumbSync);
window.addEventListener('resize', omniThumbSync);
setTimeout(omniThumbSync, 400);

function omniTab(btn) {
  const item = btn.closest('.omni-acc-item');
  const isActive = item.classList.contains('active');
  document.querySelectorAll('.omni-acc-item').forEach(el => el.classList.remove('active'));
  if(!isActive) item.classList.add('active');
}

window.addEventListener('scroll', () => {
  const trigger = document.getElementById('Trigger-{{sb_uid}}');
  const sticky = document.getElementById('Sticky-{{sb_uid}}');
  if(trigger && sticky) sticky.classList.toggle('visible', trigger.getBoundingClientRect().top < 0);
});

async function omniAction(type) {
  const vid = document.getElementById('VariantId-{{sb_uid}}').value;
  const plan = document.getElementById('SellingPlan-{{sb_uid}}').value;
  const btn = document.getElementById('AddBtn-{{sb_uid}}');

  if(type === 'bag') {
    btn.disabled = true; btn.innerText = "ADDING...";
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ items: [{ id: vid, quantity: 1, selling_plan: plan || null }] })
      });
      if(res.ok) {
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        btn.innerText = "ADDED!";
        setTimeout(() => { btn.disabled = false; btn.innerText = "ADD TO BAG"; }, 2000);
      }
    } catch (e) { btn.disabled = false; btn.innerText = "ADD TO BAG"; }
  } else {
    let url = `/cart/${vid}:1`;
    if(plan) url += `?selling_plan=${plan}`;
    window.location.href = url;
  }
}

/* ═══ LIGHTBOX / ZOOM VIEWER ═══ */
(function(){
  var LB, IMG, STAGE, CT, idx=0, scale=1, tx=0, ty=0, drag=false, sx=0, sy=0, pinchDist=0;
  var srcs = [];
  {% for image in product.images %}srcs.push("{{ image | image_url: width: 2048 }}");{% endfor %}
  function build(){
    if(LB) return;
    LB=document.createElement('div'); LB.className='omni-lb';
    LB.innerHTML='<button class="omni-lb-x" aria-label="Close">&times;</button>'
      +'<button class="omni-lb-arrow omni-lb-p" aria-label="Previous">&#8249;</button>'
      +'<div class="omni-lb-stage"><img class="omni-lb-img" draggable="false" alt=""></div>'
      +'<button class="omni-lb-arrow omni-lb-n" aria-label="Next">&#8250;</button>'
      +'<div class="omni-lb-ct"></div>'
      +'<div class="omni-lb-hint">Scroll or double-click to zoom &middot; drag to pan</div>';
    document.body.appendChild(LB);
    IMG=LB.querySelector('.omni-lb-img'); STAGE=LB.querySelector('.omni-lb-stage'); CT=LB.querySelector('.omni-lb-ct');
    LB.querySelector('.omni-lb-x').onclick=close;
    LB.querySelector('.omni-lb-p').onclick=function(e){e.stopPropagation();nav(-1);};
    LB.querySelector('.omni-lb-n').onclick=function(e){e.stopPropagation();nav(1);};
    LB.addEventListener('click',function(e){ if(e.target===LB||e.target===STAGE) close(); });
    STAGE.addEventListener('wheel',function(e){ e.preventDefault(); zoomAt(e.deltaY<0?1.18:0.85, e.clientX, e.clientY); },{passive:false});
    STAGE.addEventListener('dblclick',function(e){ if(scale>1){reset();} else { zoomAt(2.6, e.clientX, e.clientY);} });
    STAGE.addEventListener('mousedown',function(e){ if(scale<=1)return; drag=true; sx=e.clientX-tx; sy=e.clientY-ty; STAGE.style.cursor='grabbing'; });
    window.addEventListener('mousemove',function(e){ if(!drag)return; tx=e.clientX-sx; ty=e.clientY-sy; apply(); });
    window.addEventListener('mouseup',function(){ drag=false; if(STAGE) STAGE.style.cursor=scale>1?'grab':'zoom-in'; });
    STAGE.addEventListener('touchstart',function(e){ if(e.touches.length===2){ pinchDist=dist(e.touches);} else if(scale>1){ drag=true; sx=e.touches[0].clientX-tx; sy=e.touches[0].clientY-ty; } },{passive:true});
    STAGE.addEventListener('touchmove',function(e){ if(e.touches.length===2){ e.preventDefault(); var d=dist(e.touches); zoomAt(d/pinchDist, (e.touches[0].clientX+e.touches[1].clientX)/2,(e.touches[0].clientY+e.touches[1].clientY)/2); pinchDist=d; } else if(drag){ tx=e.touches[0].clientX-sx; ty=e.touches[0].clientY-sy; apply(); } },{passive:false});
    STAGE.addEventListener('touchend',function(){ drag=false; });
    document.addEventListener('keydown',function(e){ if(!LB.classList.contains('open'))return; if(e.key==='Escape')close(); if(e.key==='ArrowLeft')nav(-1); if(e.key==='ArrowRight')nav(1); });
  }
  function dist(t){ return Math.hypot(t[0].clientX-t[1].clientX, t[0].clientY-t[1].clientY); }
  function apply(){ IMG.style.transform='translate('+tx+'px,'+ty+'px) scale('+scale+')'; }
  function reset(){ scale=1; tx=0; ty=0; apply(); STAGE.style.cursor='zoom-in'; }
  function zoomAt(f,cx,cy){ var ns=Math.min(5,Math.max(1,scale*f)); var r=IMG.getBoundingClientRect(); var ox=cx-(r.left+r.width/2); var oy=cy-(r.top+r.height/2); tx=(tx-ox)*(ns/scale)+ox; ty=(ty-oy)*(ns/scale)+oy; scale=ns; if(scale<=1){tx=0;ty=0;} apply(); STAGE.style.cursor=scale>1?'grab':'zoom-in'; }
  function set(){ IMG.src=srcs[idx]||''; CT.textContent=(idx+1)+' / '+srcs.length; reset(); }
  function nav(d){ idx=(idx+d+srcs.length)%srcs.length; set(); }
  function close(){ LB.classList.remove('open'); document.body.style.overflow=''; }
  window.omniZoom=function(i){ build(); idx=i; set(); LB.classList.add('open'); document.body.style.overflow='hidden'; };
})();
</script>
<style>
  .omni-lb{position:fixed;inset:0;background:rgba(12,12,12,.95);z-index:100000;display:none;align-items:center;justify-content:center;}
