      .pgp-title-link:hover { text-decoration:underline; }
      .pgp-price { font-size:12.5px; font-weight:700; color:#141414; margin:0; }
      .pgp-plus { display:flex; align-items:center; justify-content:center; padding-top:28px; color:#b7ae9e; font-size:18px; }
      .pgp-reason { padding:12px 18px; background:#f9f3ed; border-top:1px solid #efe9df; font-size:11.5px; line-height:1.6; color:#6b6459; }
