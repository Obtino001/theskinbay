  .omni-lb-arrow:hover{background:rgba(255,255,255,.22);}
  .omni-lb-p{left:24px;} .omni-lb-n{right:24px;}
  .omni-lb-ct{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);color:#fff;font-size:12px;letter-spacing:.12em;opacity:.7;}
