  @media(max-width:600px){.omni-lb-arrow{width:42px;height:42px;font-size:24px;}.omni-lb-p{left:12px;}.omni-lb-n{right:12px;}.omni-lb-hint{display:none;}.omni-lb-img{max-width:96vw;}}
</style>

