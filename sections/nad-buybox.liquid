      <script>
      (function(){
        var mount=document.getElementById('omni-gift-mount-{{sb_uid}}'); if(!mount) return;
        var handle=mount.dataset.handle, cols=(mount.dataset.collections||'').split(',').filter(Boolean);
        function esc(s){return (s==null?'':String(s)).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
        function match(offers){for(var i=0;i<offers.length;i++){var o=offers[i]; if(o.collection && cols.indexOf(o.collection)>-1) return o; if(o.product && o.product===handle) return o;} return null;}
        function apply(offers){var o=match(offers||[]); mount.innerHTML = o ? '<div class="omni-gift"><span class="omni-gift-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></span><div class="omni-gift-body"><p class="omni-gift-eyebrow">Complimentary Gift</p>'+(o.title?'<p class="omni-gift-title">'+esc(o.title)+'</p>':'')+(o.offer?'<p class="omni-gift-offer">'+esc(o.offer)+'</p>':'')+'</div><a href="'+esc(o.url||'/pages/gifts')+'" class="omni-gift-cta">View</a></div>' : '';}
        try{var c=sessionStorage.getItem('tsbGiftOffers'); if(c) apply(JSON.parse(c));}catch(e){}
        fetch('/pages/gifts',{credentials:'same-origin'}).then(function(r){return r.text();}).then(function(html){
          var el=new DOMParser().parseFromString(html,'text/html').getElementById('tsb-gift-offers'); if(!el) return;
          var offers=JSON.parse(el.textContent||'[]');
          try{sessionStorage.setItem('tsbGiftOffers',JSON.stringify(offers));}catch(e){}
          apply(offers);
        }).catch(function(){});
      })();
      </script>

      {% if section.settings.payment_icons != blank %}
