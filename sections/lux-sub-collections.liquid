{% schema %}
{
  "name": "Lux Category Bar",
  "settings": [
    { "type": "text",  "id": "heading", "label": "Heading", "default": "Shop by Brand + Category" },
    { "type": "text",  "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "color", "id": "bg_color",   "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text",       "default": "#0c0c0c" }
  ],
  "presets": [{ "name": "Lux Category Bar" }]
}
{% endschema %}

{% assign sub_colls = collection.metafields.custom.sub_collections_liquid.value %}
{% if sub_colls == blank %}
  {% assign sub_colls = collection.metafields.custom.sub_collections.value %}
{% endif %}

{% if sub_colls != blank %}

<style>
  .lsc3-wrap{background:{{ section.settings.bg_color }};padding:14px 20px 46px;}
  .lsc3-head{max-width:1320px;margin:0 auto 4px;display:flex;align-items:baseline;justify-content:space-between;gap:18px;padding:0 2px;}
  .lsc3-eyebrow{font-family:var(--font-body--family), sans-serif;font-size:12px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:#8a857c;margin:0;}
  .lsc3-view-all{font-family:var(--font-body--family), sans-serif;font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#8a857c;text-decoration:none;border-bottom:1px solid rgba(0,0,0,.18);padding-bottom:1px;transition:color .15s,border-color .15s;white-space:nowrap;}
  .lsc3-view-all:hover{color:#0c0c0c;border-color:#0c0c0c;}

  .lsc3-carousel{position:relative;max-width:1320px;margin:18px auto 0;}
  .lsc3-viewport{overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;cursor:grab;scrollbar-width:none;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;}
  .lsc3-viewport::-webkit-scrollbar{display:none;}
  .lsc3-viewport:active{cursor:grabbing;}
  .lsc3-strip{display:flex;gap:14px;padding:4px 2px;}

  .lsc3-card{flex:0 0 210px;position:relative;display:block;overflow:hidden;aspect-ratio:4/5;border-radius:16px;scroll-snap-align:start;text-decoration:none;background:#1c1c1c;}
  .lsc3-img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .7s cubic-bezier(.25,.46,.45,.94);}
  .lsc3-card:hover .lsc3-img{transform:scale(1.06);}
  .lsc3-ph{position:absolute;inset:0;background:linear-gradient(160deg,#2a2320,#4a3d33);}
  .lsc3-initial{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--font-body--family), sans-serif;font-size:2.4rem;font-weight:300;color:rgba(255,255,255,.5);letter-spacing:.05em;}
  .lsc3-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.62) 0%,rgba(0,0,0,.12) 55%,rgba(0,0,0,0) 100%);}
  .lsc3-label{position:absolute;left:0;right:0;bottom:0;padding:16px 16px 18px;display:flex;flex-direction:column;gap:4px;z-index:2;}
  .lsc3-name{font-family:var(--font-body--family), sans-serif;font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.4);line-height:1.25;}
  .lsc3-shop{font-family:var(--font-body--family), sans-serif;font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,0);transition:color .3s;}
  .lsc3-card:hover .lsc3-shop{color:rgba(255,255,255,.85);}

  .lsc3-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:42px;height:42px;border-radius:50%;border:1.5px solid rgba(20,20,20,.14);background:#fff;color:#141414;font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,.1);transition:background .2s,color .2s;}
  .lsc3-arrow:hover{background:#141414;color:#fff;}
  .lsc3-arrow--prev{left:-10px;}.lsc3-arrow--next{right:-10px;}

  @media (max-width:749px){
    .lsc3-wrap{padding:8px 12px 34px;}
    .lsc3-card{flex:0 0 150px;border-radius:14px;}
    .lsc3-strip{gap:10px;}
    .lsc3-arrow{display:none;}
    .lsc3-name{font-size:12px;}
  }
</style>

<div class="lsc3-wrap">
  <div class="lsc3-head">
    {%- if section.settings.heading != blank -%}
      <p class="lsc3-eyebrow">{{ section.settings.heading }}</p>
    {%- endif -%}
    <a href="{{ collection.url }}" class="lsc3-view-all">{{ section.settings.view_all_label | default: 'View all' }}</a>
  </div>

  <div class="lsc3-carousel">
    <button type="button" class="lsc3-arrow lsc3-arrow--prev" aria-label="Scroll left" data-lsc3-prev>&#8249;</button>
    <div class="lsc3-viewport" id="lsc3-vp-{{ section.id }}">
      <div class="lsc3-strip" role="list">
        {%- for sub in sub_colls -%}
          {%- assign sub_image = sub.image | default: sub.products.first.featured_image -%}
          <a href="{{ sub.url }}" class="lsc3-card" role="listitem" aria-label="{{ sub.title | escape }}">
            {%- if sub_image != blank -%}
              {{ sub_image | image_url: width: 640 | image_tag:
                  loading: 'lazy', class: 'lsc3-img',
                  alt: sub.title, width: 420, height: 525 }}
            {%- else -%}
              <div class="lsc3-ph"></div>
              <span class="lsc3-initial">{{ sub.title | slice: 0, 1 | upcase }}</span>
            {%- endif -%}
            <div class="lsc3-overlay"></div>
            <div class="lsc3-label">
              <span class="lsc3-name">{{ sub.title }}</span>
              <span class="lsc3-shop">Shop &rarr;</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
    <button type="button" class="lsc3-arrow lsc3-arrow--next" aria-label="Scroll right" data-lsc3-next>&#8250;</button>
  </div>
</div>

<script>
(function(){
  var vp=document.getElementById('lsc3-vp-{{ section.id }}');
  if(!vp) return;
  var wrap=vp.closest('.lsc3-carousel');
  var down=false,sx=0,sl=0,moved=false;
  vp.addEventListener('mousedown',function(e){down=true;moved=false;sx=e.pageX-vp.offsetLeft;sl=vp.scrollLeft;});
  vp.addEventListener('mouseleave',function(){down=false;});
  vp.addEventListener('mouseup',function(){down=false;});
  vp.addEventListener('mousemove',function(e){if(!down)return;e.preventDefault();moved=true;vp.scrollLeft=sl-(e.pageX-vp.offsetLeft-sx)*1.4;});
  vp.addEventListener('click',function(e){if(moved){e.preventDefault();}},true);
  function step(){var c=vp.querySelector('.lsc3-card');return c?c.offsetWidth*2+28:400;}
  var pv=wrap.querySelector('[data-lsc3-prev]'),nx=wrap.querySelector('[data-lsc3-next]');
  if(pv)pv.addEventListener('click',function(){vp.scrollBy({left:-step(),behavior:'smooth'});});
  if(nx)nx.addEventListener('click',function(){vp.scrollBy({left:step(),behavior:'smooth'});});
})();
</script>

{% endif %}
