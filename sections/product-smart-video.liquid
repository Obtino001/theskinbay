{% comment %}
  Smart Video Section for Product Pages
  Priority: 1. Metafield (YouTube) -> 2. Gallery Video (Native)
{% endcomment %}

{%- liquid
  assign video_url = product.metafields.custom.video.value
  assign gallery_video = product.media | where: 'media_type', 'video' | first
  assign external_gallery_video = product.media | where: 'media_type', 'external_video' | first
  
  assign has_video = false
  if video_url != blank
    assign has_video = true
    assign video_type = 'metafield'
  elsif gallery_video != blank
    assign has_video = true
    assign video_type = 'native'
  elsif external_gallery_video != blank
    assign has_video = true
    assign video_type = 'external_native'
  endif
-%}

{% if has_video %}
<div class="smart-video-section page-width">
  {% if section.settings.heading != blank %}
    <h2 class="smart-video-heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="video-container-facade" id="SmartVideoWrapper">
    
    {% comment %} --- SCENARIO 1: YOUTUBE METAFIELD --- {% endcomment %}
    {% if video_type == 'metafield' %}
      {% comment %} Extract Video ID from YouTube URL {% endcomment %}
      {% if video_url contains 'v=' %}
        {% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}
      {% else %}
        {% assign video_id = video_url | split: '/' | last %}
      {% endif %}

      <div class="video-facade" onclick="loadYoutube('{{ video_id }}', this)">
        <img src="https://img.youtube.com/vi/{{ video_id | escape }}/maxresdefault.jpg" 
             alt="{{ product.title | escape }}" 
             loading="lazy" 
             class="video-cover-image">
        <div class="play-button">
          <svg viewBox="0 0 24 24" width="60" height="60" fill="white"><path d="M8 5v14l11-7z"/></svg>
        </div>
      </div>

    {% comment %} --- SCENARIO 2: NATIVE GALLERY VIDEO (MP4) --- {% endcomment %}
    {% elsif video_type == 'native' %}
      {{ gallery_video | video_tag: image_size: '1024x', controls: true, autoplay: false, loop: section.settings.loop_video, preload: 'none', class: 'native-video-player' }}

    {% comment %} --- SCENARIO 3: NATIVE GALLERY (EXTERNAL) --- {% endcomment %}
    {% elsif video_type == 'external_native' %}
      <div class="external-video-wrapper">
        {{ external_gallery_video | external_video_tag: class: 'native-video-player' }}
      </div>
    {% endif %}
    
  </div>
</div>

<script>
  function loadYoutube(id, element) {
    var iframe = document.createElement("iframe");
    iframe.setAttribute("src", "https://www.youtube.com/embed/" + id + "?autoplay=1&rel=0");
    iframe.setAttribute("frameborder", "0");
    iframe.setAttribute("allow", "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture");
    iframe.setAttribute("allowfullscreen", "true");
    iframe.classList.add("youtube-iframe");
    
    // Clear the facade and append iframe
    element.innerHTML = "";
    element.appendChild(iframe);
    element.classList.add("is-loaded");
  }
</script>

<style>
  .smart-video-section {
    margin: 60px auto;
    max-width: {{ section.settings.max_width }}px;
    padding: 0 20px;
  }
  .smart-video-heading {
    font-family: var(--font-heading--family), serif;
    font-weight: 400;
    text-align: center;
    margin-bottom: 20px;
    font-size: 24px;
  }
  
  /* Facade & Container Styling */
  .video-container-facade {
    position: relative;
    width: 100%;
    /* 16:9 Aspect Ratio Keeper */
    padding-bottom: 56.25%; 
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    background: #000;
  }

  .video-facade {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .video-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    transition: opacity 0.3s ease, transform 0.5s ease;
  }
  
  .video-facade:hover .video-cover-image {
    opacity: 0.7;
    transform: scale(1.05);
  }

  .play-button {
    position: absolute;
    z-index: 2;
    background: rgba(0,0,0,0.6);
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, background 0.3s ease;
    backdrop-filter: blur(5px);
  }

  .video-facade:hover .play-button {
    transform: scale(1.1);
    background: rgba(255, 0, 0, 0.8); /* YouTube Red on hover */
  }

  /* Actual Players */
  .youtube-iframe, .native-video-player, .external-video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>
{% endif %}

{% schema %}
{
  "name": "Smart Product Video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "See it in Action"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Width",
      "default": 1200
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Loop Native Videos",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Smart Product Video"
    }
  ]
}
{% endschema %}