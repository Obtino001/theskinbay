{% comment %}
  Skin Bay Microneedling Section (Updated)
  Removed Process Section + Added Full Editability
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap');

  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .sb-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    font-family: 'Lato', sans-serif;
  }

  /* Section Padding */
  .sb-wrapper {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Typography */
  .sb-title {
    font-size: 3rem;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
  }

  .sb-subtitle {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 1rem;
    color: {{ section.settings.accent_color }};
    display: block;
  }

  .sb-body {
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: {{ section.settings.text_color }};
  }

  .sb-heading-2 {
    font-size: 1.8rem;
    font-weight: 400;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: {{ section.settings.heading_color }};
  }

  /* Brand-font header banners (SEO heading kept, visually hidden) */
  .mn-hbanner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 12px;}
  .mn-hbanner-left{display:block;width:100%;max-width:440px;height:auto;margin:0 0 12px;}
  .mn-hvh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}

  /* Layout Grids */
  .sb-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .sb-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  /* Feature Cards */
  .sb-card {
    background: {{ section.settings.card_bg }};
    padding: 2rem;
    border: 1px solid {{ section.settings.border_color }};
    text-align: center;
    transition: transform 0.3s ease;
    height: 100%;
  }
  
  .sb-card:hover {
    transform: translateY(-5px);
  }

  .sb-card h3 {
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    color: {{ section.settings.heading_color }};
  }

  /* Button */
  .sb-btn {
    display: inline-block;
    padding: 15px 40px;
    background-color: {{ section.settings.accent_color }};
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 500;
    margin-top: 2rem;
    transition: opacity 0.3s ease;
  }
  
  .sb-btn:hover {
    opacity: 0.8;
  }

  /* Editorial Image styling */
  .sb-image-container {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 400px;
  }

  .sb-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mobile Responsive */
  @media only screen and (max-width: 749px) {
    .sb-wrapper {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }
    
    .sb-grid-2, .sb-grid-3 {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sb-title {
      font-size: 2.2rem;
    }

    .sb-image-container {
      min-height: 300px;
      order: -1; 
    }
    
    .sb-card {
      padding: 1.5rem;
    }
  }
</style>

<div class="sb-wrapper">
  <div class="sb-container">
    
    <!-- Hero Section -->
    <div class="sb-grid-2">
      <div>
        {% if section.settings.subtitle != blank %}
          <span class="sb-subtitle">{{ section.settings.subtitle }}</span>
        {% endif %}
        <img class="mn-hbanner-left" src="{{ 'mn-h-title.png' | asset_url }}" alt="Microneedling">
        <h1 class="sb-title mn-hvh">{{ section.settings.title }}</h1>
        <div class="sb-body">{{ section.settings.intro_text }}</div>
        {% if section.settings.show_cta %}
          <a href="{{ section.settings.cta_link }}" class="sb-btn">{{ section.settings.cta_text }}</a>
        {% endif %}
      </div>
      <div class="sb-image-container">
        {% if section.settings.hero_image %}
          {{ section.settings.hero_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>

    <!-- What is it Section -->
    <div style="margin-top: 5rem;">
      <img class="mn-hbanner" src="{{ 'mn-h-def.png' | asset_url }}" alt="What is Microneedling?">
      <h2 class="sb-heading-2 mn-hvh" style="text-align: center;">{{ section.settings.definition_title }}</h2>
      <div class="sb-body" style="max-width: 800px; margin: 0 auto; text-align: center;">
        {{ section.settings.definition_text }}
      </div>
    </div>

    <!-- Benefits Grid -->
    <div style="margin-top: 5rem;">
      <img class="mn-hbanner" src="{{ 'mn-h-ben.png' | asset_url }}" alt="Skin Concerns Microneedling Treats">
      <h2 class="sb-heading-2 mn-hvh" style="text-align: center;">{{ section.settings.benefits_title }}</h2>
      <div class="sb-grid-3">
        {% for block in section.blocks %}
          <div class="sb-card">
            <h3>{{ block.settings.benefit_title }}</h3>
            <p>{{ block.settings.benefit_desc }}</p>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Safety & Recovery -->
    <div style="margin-top: 5rem; background: {{ section.settings.card_bg }}; padding: 3rem; border: 1px solid {{ section.settings.border_color }};">
      <img class="mn-hbanner" src="{{ 'mn-h-recovery.png' | asset_url }}" alt="Recovery &amp; Aftercare">
      <h2 class="sb-heading-2 mn-hvh" style="margin-top: 0; text-align: center;">{{ section.settings.recovery_title }}</h2>
      <div class="sb-body" style="text-align: center; max-width: 800px; margin: 0 auto;">
        {{ section.settings.recovery_text }}
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Skin Bay Microneedling",
  "settings": [
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent/Button Color",
      "default": "#D4Af37"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The Skin Bay Treatments"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Title",
      "default": "Microneedling"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro Paragraph",
      "default": "<p>Experience the ultimate in skin rejuvenation. Microneedling, also known as collagen induction therapy, is a minimally invasive cosmetic procedure designed to treat skin concerns by stimulating natural collagen production.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Book Consultation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Definition Section"
    },
    {
      "type": "text",
      "id": "definition_title",
      "label": "Definition Heading",
      "default": "What is Microneedling?"
    },
    {
      "type": "richtext",
      "id": "definition_text",
      "label": "Definition Text",
      "default": "<p>At The Skin Bay, we use microneedling to help you achieve a smoother, firmer, and more toned complexion. By using sterilized, fine needles to create micro-punctures in the skin, we trigger the body's natural healing response. This process increases the production of collagen and elastin, the essential proteins that keep your skin looking youthful and radiant.</p>"
    },
    {
      "type": "header",
      "content": "Benefits Section"
    },
    {
      "type": "text",
      "id": "benefits_title",
      "label": "Benefits Heading",
      "default": "Skin Concerns We Treat"
    },
    {
      "type": "header",
      "content": "Recovery Section"
    },
    {
      "type": "text",
      "id": "recovery_title",
      "label": "Recovery Heading",
      "default": "Recovery & Aftercare"
    },
    {
      "type": "richtext",
      "id": "recovery_text",
      "label": "Recovery Text",
      "default": "<p>Recovery time is minimal. Most clients experience minor redness and irritation similar to a mild sunburn for a few days. You may notice your skin feeling tighter and looking more radiant as it heals. Full results typically develop over a few weeks as your collagen levels increase. Always wear sunscreen and keep your skin hydrated post-treatment.</p>"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Desktop)",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_top_m",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_m",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Skin Benefit",
      "settings": [
        {
          "type": "text",
          "id": "benefit_title",
          "label": "Benefit Title",
          "default": "Enlarged Pores"
        },
        {
          "type": "textarea",
          "id": "benefit_desc",
          "label": "Description",
          "default": "Refines skin texture and visibly reduces the appearance of large pores."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skin Bay Microneedling",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "benefit_title": "Acne Scars",
            "benefit_desc": "Effective for treating varied types of acne scarring for a smoother surface."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_title": "Fine Lines",
            "benefit_desc": "Softens the appearance of fine lines and wrinkles by boosting elasticity."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "benefit_title": "Uneven Tone",
            "benefit_desc": "Helps reduce hyperpigmentation and sun damage for a unified complexion."
          }
        }
      ]
    }
  ]
}
{% endschema %}