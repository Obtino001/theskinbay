<style>
  .lf-bl *, .lf-bl *::before, .lf-bl *::after { box-sizing: border-box; }
  .lf-bl a { text-decoration: none; }
  .lf-bl-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; }

  .lf-bl-section { padding: 72px 0; background: {{ section.settings.bg_color }}; border-top: 1px solid rgba(0,0,0,.06); }
  .lf-bl-header { text-align: center; margin-bottom: 48px; }
  .lf-bl-eyebrow {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.35);
    display: block;
    margin-bottom: 10px;
  }
  .lf-bl-heading {
    font-family: var(--font-heading--family), serif;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 400;
    color: #111;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .lf-bl-heading em { font-style: italic; }
  .lf-bl-banner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 6px;}.lf-bl-vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
  .lf-bl-body {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(0,0,0,0.45);
    line-height: 1.7;
    margin: 12px 0 0;
  }
  .lf-bl-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1px;
    background: rgba(0,0,0,.07);
    border: 1px solid rgba(0,0,0,.07);
  }
  .lf-bl-item {
    background: {{ section.settings.bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px 24px;
    min-height: 96px;
  }
  .lf-bl-link { display: flex; align-items: center; justify-content: center; width: 100%; }
  .lf-bl-logo {
    max-width: 110px;
    max-height: 52px;
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    filter: grayscale(100%) opacity(0.5);
    transition: filter 0.25s ease;
  }
  .lf-bl-item:hover .lf-bl-logo { filter: grayscale(0%) opacity(1); }
  @media (max-width: 1023px) { .lf-bl-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 749px) {
    .lf-bl-section { padding: 48px 0; }
    .lf-bl-inner { padding: 0 20px; }
    .lf-bl-grid { grid-template-columns: repeat(3, 1fr); }
    .lf-bl-item { padding: 20px 16px; min-height: 76px; }
    .lf-bl-logo { max-width: 80px; max-height: 38px; }
  }
</style>

<div class="lf-bl">
  <section class="lf-bl-section">
    <div class="lf-bl-inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="lf-bl-header">
          {%- if section.settings.header_image != blank -%}
            <img class="lf-bl-banner" src="{{ section.settings.header_image | asset_url }}" alt="{{ section.settings.heading | strip_html | escape }}">
            {%- if section.settings.heading != blank -%}
              <h2 class="lf-bl-heading lf-bl-vh">{{ section.settings.heading }}</h2>
            {%- endif -%}
          {%- else -%}
            {%- if section.settings.eyebrow != blank -%}
              <span class="lf-bl-eyebrow">{{ section.settings.eyebrow }}</span>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="lf-bl-heading">{{ section.settings.heading }}</h2>
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <p class="lf-bl-body">{{ section.settings.body }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="lf-bl-grid">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              <div class="lf-bl-item" {{ block.shopify_attributes }}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="lf-bl-link">
                    <img src="{{ block.settings.image | image_url: width: 220 }}" alt="{{ block.settings.name | escape }}" class="lf-bl-logo" loading="lazy">
                  </a>
                {%- else -%}
                  <img src="{{ block.settings.image | image_url: width: 220 }}" alt="{{ block.settings.name | escape }}" class="lf-bl-logo" loading="lazy">
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="lf-bl-item" {{ block.shopify_attributes }}>
                <span style="font-family:var(--font-body--family), sans-serif;font-size:0.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(0,0,0,.22);">{{ block.settings.name }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Brand Logos",
  "tag": "div",
  "settings": [
    { "type": "color",    "id": "bg_color", "label": "Background", "default": "#faf8f5" },
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow",    "default": "Our Brands" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Trusted by dermatologists." },
    { "type": "text", "id": "header_image", "label": "Header banner asset (brand-font PNG)" },
    { "type": "textarea", "id": "body",    "label": "Body text" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text",         "id": "name",  "label": "Brand name" },
        { "type": "url",          "id": "link",  "label": "Collection link (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Brand Logos" }]
}
{% endschema %}
