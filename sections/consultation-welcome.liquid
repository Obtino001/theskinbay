{%- comment -%} Consultation welcome hero, founder-led, warm, responsive (no image cropping) {%- endcomment -%}
<section class="cw" data-section-id="{{ section.id }}">
  <div class="cw-inner">
    <div class="cw-photo"><img src="{{ 'email-founder-emmalee.jpg' | asset_url }}" alt="Emmalee Fitton, Founder of The Skin Bay" width="170" height="170" loading="eager"></div>
    <p class="cw-eyebrow cw-vh">Personal Skin Consultation</p>
    <img class="cw-banner" src="{{ 'consultation-h-hero.png' | asset_url }}" alt="Your skincare, guided">
    <h1 class="cw-title cw-vh">We&rsquo;re here to help with your skincare journey</h1>
    <p class="cw-body">And we want you to know, no question is too small. Whatever stage you&rsquo;re at, reach out and we&rsquo;ll help you find the best products for your skin. This is your journey, and we&rsquo;re with you every step of the way.</p>
    <p class="cw-sign">, Emmalee, Founder</p>
    <a class="cw-btn" href="https://mediprodirect.book.app/book-now/availability?services=W3sicyI6MTUxMzM2MH1d">Book a Consultation</a>
    <p class="cw-note">&pound;20 to book &middot; fully redeemable against your first order &middot; 45-min private 1:1</p>
  </div>
</section>

<style>
  .cw{background:#F9F3ED;}
  .cw-banner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 22px;}
  .cw-vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
  .cw-inner{max-width:720px;margin:0 auto;padding:64px 24px 60px;text-align:center;}
  .cw-photo img{width:170px;height:170px;border-radius:50%;object-fit:cover;display:block;margin:0 auto 26px;box-shadow:0 6px 20px rgba(0,0,0,.1);}
  .cw-eyebrow{font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:12px;color:#8a8377;margin:0 0 12px;}
  .cw-title{font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:clamp(30px,4.5vw,46px);line-height:1.12;margin:0 0 18px;color:#141414;}
  .cw-body{font-family:'Lato',sans-serif;font-size:17px;line-height:1.65;color:#4d4840;margin:0 auto 18px;max-width:600px;}
  .cw-sign{font-family:'Playfair Display',cursive;font-weight:700;font-size:26px;color:#141414;margin:0 0 30px;}
  .cw-btn{display:inline-block;font-family:'Lato',sans-serif;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;background:#141414;color:#fff;padding:16px 44px;border-radius:999px;transition:opacity .25s ease;}
  .cw-btn:hover{opacity:.82;}
  .cw-note{font-family:'Lato',sans-serif;font-size:13px;color:#8a8377;margin:18px 0 0;}
  @media (max-width:749px){
    .cw-inner{padding:48px 18px 46px;}
    .cw-photo img{width:132px;height:132px;margin-bottom:20px;}
    .cw-body{font-size:15.5px;}
    .cw-btn{width:100%;padding:16px 24px;}
  }
</style>

{% schema %}
{
  "name": "Consultation Welcome",
  "settings": [],
  "presets": [{ "name": "Consultation Welcome" }]
}
{% endschema %}
