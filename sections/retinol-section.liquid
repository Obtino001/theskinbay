    {
      "name": "Skin Bay Retinol",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "benefit_title": "Cellular Renewal",
            "benefit_desc": "Accelerates the skin's natural turnover process to shed dead cells and reveal fresher skin."
