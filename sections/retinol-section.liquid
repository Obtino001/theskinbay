      "default": "#333333"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent/Button Color",
      "default": "#3F2A56"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card/Box Background",
      "default": "#f9f8fa"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#eee"
