    },
    {
      "type": "header",
      "content": "Typography: Body Text"
    },
    {
      "type": "range",
      "id": "body_size_d",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Desktop Size",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_size_m",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
