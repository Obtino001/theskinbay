    },
    {
      "type": "textarea",
      "id": "quote_text_2",
      "label": "Quote Paragraph 2",
      "default": "\"You wake up five years younger, you do feel good. I found them on a website called The Skin Bay.\""
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author",
      "default": "ABBEY CLANCY"
    },
    {
      "type": "header",
      "content": "Masks Grid Area"
    },
    {
      "type": "text",
      "id": "masks_heading",
      "label": "Masks Heading",
      "default": "SHOP THE SECRET"
    },
    {
      "type": "header",
      "content": "Video Area Settings"
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Video Heading",
      "default": "SEE IT IN ACTION"
    },
    {
      "type": "header",
      "content": "3 Bottom Images"
    },
    {
      "type": "image_picker",
      "id": "bottom_img_1",
      "label": "Bottom Image 1"
    },
    {
      "type": "image_picker",
      "id": "bottom_img_2",
      "label": "Bottom Image 2"
    },
    {
      "type": "image_picker",
      "id": "bottom_img_3",
      "label": "Bottom Image 3"
    },
    {
      "type": "header",
      "content": "Featured Collection Settings"
    },
    {
      "type": "text",
      "id": "collection_heading",
      "label": "Collection Heading",
      "default": "DISCOVER MORE FROM CLINICCARE"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select a Collection"
    }
  ],
  "blocks":[
    {
      "type": "mask",
      "name": "ClinicCare Mask",
      "settings":[
        {
          "type": "image_picker",
          "id": "mask_image",
          "label": "Mask Image"
        },
        {
          "type": "text",
          "id": "mask_title",
          "label": "Mask Title",
          "default": "EGF Glow Mask"
        },
        {
          "type": "textarea",
          "id": "mask_desc",
