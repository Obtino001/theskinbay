{% comment %}
  Dynamic Curated Bundle Section
  - Pulls the main product from the current template.
  - Pulls the secondary "Bundle Product" from the 'custom.bundle_product' Metafield.
  - Adds both to cart via AJAX.
{% endcomment %}

{%- assign main_product = product -%}
{%- assign bundle_product = main_product.metafields.custom.bundle_product.value -%}

{% comment %} Only show if a bundle product is assigned in Metafields and is available {% endcomment %}
{% if bundle_product != blank and bundle_product.available %}

  {%- assign total_price = main_product.price | plus: bundle_product.price -%}
  {%- assign total_compare_price = main_product.compare_at_price | default: main_product.price | plus: bundle_product.compare_at_price | default: bundle_product.price -%}
  {%- assign savings = total_compare_price | minus: total_price -%}

  <style>
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background-color: {{ section.settings.bg_color }};
      margin-top: {{ section.settings.margin_top }}px;
    }

    .bundle-container {
      max-width: 1200px;
      margin: 0 auto;
      border: 1px solid #e5e5e5;
      display: flex;
      flex-wrap: wrap;
      background: #fff;
      padding: 0;
    }

    /* Left Side: Product List */
    .bundle-items {
      flex: 1 1 600px;
      padding: 30px;
      border-right: 1px solid #e5e5e5;
    }

    .bundle-header {
      font-size: {{ section.settings.header_size }}px;
      margin-bottom: 20px;
      font-family: 'Playfair Display', Georgia, serif;
      color: {{ section.settings.text_color }};
      font-style: italic;
    }

    .bundle-item-row {
      display: flex;
      align-items: center;
      gap: 20px;
      margin-bottom: 15px;
    }

    .bundle-img {
      width: 80px;
      height: 80px;
      object-fit: contain;
      border: 1px solid #f0f0f0;
      border-radius: 4px;
    }

    .bundle-info {
      display: flex;
      flex-direction: column;
    }

    .bundle-label {
      font-size: 0.85rem;
      color: #666;
      margin-bottom: 4px;
    }

    .bundle-title {
      font-weight: 600;
      color: {{ section.settings.text_color }};
      margin-bottom: 5px;
      text-decoration: none;
      font-size: 1rem;
    }

    .bundle-prices {
      font-weight: bold;
    }

    .bundle-old-price {
      text-decoration: line-through;
      color: #999;
      margin-right: 8px;
    }

    .bundle-current-price {
      color: {{ section.settings.text_color }};
    }

    .bundle-savings {
      color: {{ section.settings.accent_color }};
      font-weight: bold;
      margin-left: 10px;
    }

    .bundle-plus {
      text-align: center;
      font-size: 24px;
      color: #ccc;
      padding: 10px 0;
      width: 80px; /* Align with image */
    }

    /* Right Side: CTA */
    .bundle-cta {
      flex: 0 0 350px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      padding: 40px;
      background-color: #fcfcfc;
    }

    .total-label {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 5px;
      color: {{ section.settings.text_color }};
    }

    .total-price-display {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 20px;
      color: {{ section.settings.text_color }};
    }

    .bundle-btn {
      width: 100%;
      background-color: {{ section.settings.btn_bg_color }};
      color: {{ section.settings.btn_text_color }};
      border: 1px solid {{ section.settings.btn_border_color }};
      padding: 15px 20px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.3s;
    }

    .bundle-btn:hover {
      opacity: 0.9;
    }

    .bundle-error {
      color: red;
      font-size: 0.9rem;
      margin-top: 10px;
      display: none;
    }

    @media (max-width: 749px) {
      .bundle-container {
        flex-direction: column;
      }
      .bundle-items {
        border-right: none;
        border-bottom: 1px solid #e5e5e5;
      }
      .bundle-cta {
        flex: auto;
        align-items: center;
        text-align: center;
        padding: 30px;
      }
      .bundle-cta .bundle-btn {
         width: 100%;
      }
    }
  </style>

  <div class="bundle-container">
    <!-- Left: Items -->
    <div class="bundle-items">
      <h2 class="bundle-header">{{ section.settings.heading }}</h2>

      <!-- Main Product (This Item) -->
      <div class="bundle-item-row">
        <img src="{{ main_product.featured_image | image_url: width: 200 }}" alt="{{ main_product.featured_image.alt | escape }}" class="bundle-img" loading="lazy" width="200">
        <div class="bundle-info">
          <span class="bundle-label">This item</span>
          <div class="bundle-title">{{ main_product.title }}</div>
          <div class="bundle-prices">
            {% if main_product.compare_at_price > main_product.price %}
              <span class="bundle-old-price">{{ main_product.compare_at_price | money }}</span>
            {% endif %}
            <span class="bundle-current-price">{{ main_product.price | money }}</span>
            {% if main_product.compare_at_price > main_product.price %}
              <span class="bundle-savings">({{ main_product.compare_at_price | minus: main_product.price | times: 100.0 | divided_by: main_product.compare_at_price | round }}% Off)</span>
            {% endif %}
          </div>
        </div>
      </div>

      <div class="bundle-plus">+</div>

      <!-- Bundle Product (From Metafield) -->
      <div class="bundle-item-row">
        <a href="{{ bundle_product.url }}">
          <img src="{{ bundle_product.featured_image | image_url: width: 200 }}" alt="{{ bundle_product.featured_image.alt | escape }}" class="bundle-img" loading="lazy" width="200">
        </a>
        <div class="bundle-info">
          <span class="bundle-label">{{ section.settings.bundle_label }}</span>
          <a href="{{ bundle_product.url }}" class="bundle-title">{{ bundle_product.title }}</a>
          <div class="bundle-prices">
            {% if bundle_product.compare_at_price > bundle_product.price %}
              <span class="bundle-old-price">{{ bundle_product.compare_at_price | money }}</span>
            {% endif %}
            <span class="bundle-current-price">{{ bundle_product.price | money }}</span>
            {% if bundle_product.compare_at_price > bundle_product.price %}
              <span class="bundle-savings">({{ bundle_product.compare_at_price | minus: bundle_product.price | times: 100.0 | divided_by: bundle_product.compare_at_price | round }}% Off)</span>
            {% endif %}
          </div>
        </div>
      </div>
    </div>

    <!-- Right: CTA -->
    <div class="bundle-cta">
      <div class="total-label">Total Price:</div>
      <div class="total-price-display">{{ total_price | money }}</div>
      
      <button id="add-bundle-{{ section.id }}" class="bundle-btn">
        {{ section.settings.btn_text }}
      </button>
      <div id="bundle-error-{{ section.id }}" class="bundle-error"></div>
    </div>
  </div>

  <script>
    document.getElementById('add-bundle-{{ section.id }}').addEventListener('click', function(e) {
      e.preventDefault();
      const btn = this;
      const errorMsg = document.getElementById('bundle-error-{{ section.id }}');
      
      btn.innerText = 'Adding...';
      errorMsg.style.display = 'none';

      const itemsToAdd = [
        {
          id: {{ main_product.selected_or_first_available_variant.id }},
          quantity: 1
        },
        {
          id: {{ bundle_product.selected_or_first_available_variant.id }},
          quantity: 1
        }
      ];

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: itemsToAdd })
      })
      .then(response => response.json())
      .then(data => {
        if (data.status) throw new Error(data.description || 'Error');
        window.location.href = '/cart';
      })
      .catch((error) => {
        console.error(error);
        btn.innerText = '{{ section.settings.btn_text }}';
        errorMsg.innerText = "One of the items is currently unavailable.";
        errorMsg.style.display = 'block';
      });
    });
  </script>

{% endif %}

{% schema %}
{
  "name": "Curated Bundle (Dynamic)",
  "settings": [
    {
      "type": "paragraph",
      "content": "To use this section, create a Product Metafield definition: 'custom.bundle_product' (Type: Product). Then assign a product in the Admin for each item."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Perfectly Paired"
    },
    {
      "type": "text",
      "id": "bundle_label",
      "label": "Label for 2nd Item",
      "default": "Recommended Item"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Discount Text Color",
      "default": "#8a2be2"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Label",
      "default": "ADD BOTH TO BASKET"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background",
      "default": "#d3d3d3"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Button Border",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "header_size",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Curated Bundle (Dynamic)"
    }
  ],
  "templates": ["product"]
}
{% endschema %}