{%- comment -%} Rewards, Earn & Redeem — brand-style replacement for the Joy app inline block {%- endcomment -%}
<style>
  .tsb-earn{background:{{ section.settings.bg_color | default: '#ffffff' }};padding:{{ section.settings.pad_top | default: 84 }}px 24px {{ section.settings.pad_bottom | default: 84 }}px;}
  .tsb-earn__wrap{max-width:1040px;margin:0 auto;text-align:center;}
  .tsb-earn__banner{display:block;width:100%;max-width:380px;height:auto;margin:0 auto 34px;}
  .tsb-earn__grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-bottom:26px;}
  .tsb-earn__card{background:#F9F3ED;border:1px solid #ece1d3;border-radius:16px;padding:40px 32px;display:flex;flex-direction:column;align-items:center;}
  .tsb-earn__ic{width:52px;height:52px;margin-bottom:20px;color:#141414;}
  .tsb-earn__ic svg{width:100%;height:100%;display:block;}
  .tsb-earn__k{font-family:'Lato',sans-serif;font-size:.6rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#9a8f74;margin-bottom:12px;}
  .tsb-earn__big{font-family:'Playfair Display',Georgia,serif;font-size:clamp(1.7rem,3.4vw,2.3rem);color:#141414;line-height:1.1;margin:0 0 12px;}
  .tsb-earn__big span{display:block;font-size:1rem;color:#6a6357;margin-top:6px;letter-spacing:.01em;}
  .tsb-earn__desc{font-family:'Lato',sans-serif;font-size:.95rem;line-height:1.7;color:#5c564c;margin:0;max-width:300px;}
  .tsb-earn__note{background:#141414;color:#f6efe2;border-radius:16px;padding:26px 30px;font-family:'Lato',sans-serif;font-size:.92rem;line-height:1.75;text-align:left;display:flex;gap:16px;align-items:flex-start;}
  .tsb-earn__note svg{flex:0 0 auto;width:26px;height:26px;margin-top:2px;}
  .tsb-earn__note strong{color:#fff;}
  .tsb-earn__note em{font-style:normal;color:#EADEB0;font-weight:700;}
  @media (max-width:749px){.tsb-earn__grid{grid-template-columns:1fr;}.tsb-earn__note{flex-direction:column;gap:10px;}}
</style>

<section class="tsb-earn">
  <div class="tsb-earn__wrap">
    <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;padding:0;margin:-1px;border:0;">How BayPoints work: earn and redeem</h2>
    <img class="tsb-earn__banner" src="{{ 'rwd-h-earn.png' | asset_url }}" alt="Earn and redeem BayPoints" loading="lazy" width="1500" height="340">

    <div class="tsb-earn__grid">
      <div class="tsb-earn__card">
        <span class="tsb-earn__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.2c-.5-.9-1.5-1.5-2.6-1.5-1.7 0-3 1.3-3 2.9 0 1.2.8 1.9 1.9 2.4 1.3.5 2.2 1 2.2 2.2 0 1.1-1 2-2.3 2-1.1 0-2.1-.6-2.5-1.6M12 6.3v1.4M12 16.4v1.4"/></svg>
        </span>
        <span class="tsb-earn__k">Earn</span>
        <p class="tsb-earn__big">{{ section.settings.earn_value | default: '1 point' }}<span>{{ section.settings.earn_sub | default: 'for every £2 you spend' }}</span></p>
        <p class="tsb-earn__desc">{{ section.settings.earn_desc | default: 'Collect a BayPoint for every £2 spent with us. Points stack up automatically at checkout.' }}</p>
      </div>
      <div class="tsb-earn__card">
        <span class="tsb-earn__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3.5" y="8.5" width="17" height="12" rx="1.5"/><path d="M3.5 12.5h17M12 8.5v12"/><path d="M12 8.5C12 6 10.5 4.5 8.8 4.5 7.5 4.5 6.7 5.4 6.7 6.5 6.7 7.9 8.4 8.5 12 8.5Zm0 0C12 6 13.5 4.5 15.2 4.5c1.3 0 2.1.9 2.1 2 0 1.4-1.7 2-5.3 2Z"/></svg>
        </span>
        <span class="tsb-earn__k">Redeem</span>
        <p class="tsb-earn__big">{{ section.settings.redeem_value | default: '100 points' }}<span>{{ section.settings.redeem_sub | default: '= £5 off voucher' }}</span></p>
        <p class="tsb-earn__desc">{{ section.settings.redeem_desc | default: 'Turn 100 BayPoints into a £5 off voucher to spend on your next order.' }}</p>
      </div>
    </div>

    <div class="tsb-earn__note">
      <svg viewBox="0 0 24 24" fill="none" stroke="#EADEB0" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/></svg>
      <span>{{ section.settings.note_html | default: '<strong>Good to know:</strong> You earn and redeem BayPoints on full-price, sale and markdown items. Points <em>cannot</em> be earned or redeemed on bundles, gift items, or exclusive bundle deals (where you already save a percentage and receive complimentary extras).' }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rewards, Earn & Redeem",
  "tag": "div",
  "settings": [
    { "type": "text",     "id": "earn_value",   "label": "Earn value",   "default": "1 point" },
    { "type": "text",     "id": "earn_sub",     "label": "Earn subtext", "default": "for every £2 you spend" },
    { "type": "textarea", "id": "earn_desc",    "label": "Earn description", "default": "Collect a BayPoint for every £2 spent with us. Points stack up automatically at checkout." },
    { "type": "text",     "id": "redeem_value", "label": "Redeem value", "default": "100 points" },
    { "type": "text",     "id": "redeem_sub",   "label": "Redeem subtext","default": "= £5 off voucher" },
    { "type": "textarea", "id": "redeem_desc",  "label": "Redeem description", "default": "Turn 100 BayPoints into a £5 off voucher to spend on your next order." },
    { "type": "html",     "id": "note_html",    "label": "Exclusions note (HTML)", "default": "<strong>Good to know:</strong> You earn and redeem BayPoints on full-price, sale and markdown items. Points <em>cannot</em> be earned or redeemed on bundles, gift items, or exclusive bundle deals (where you already save a percentage and receive complimentary extras)." },
    { "type": "color",    "id": "bg_color",     "label": "Background", "default": "#ffffff" },
    { "type": "range",    "id": "pad_top",      "label": "Padding top", "min": 40, "max": 140, "step": 4, "default": 84, "unit": "px" },
    { "type": "range",    "id": "pad_bottom",   "label": "Padding bottom", "min": 40, "max": 140, "step": 4, "default": 84, "unit": "px" }
  ],
  "presets": [{ "name": "Rewards, Earn & Redeem" }]
}
{% endschema %}
