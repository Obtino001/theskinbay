{% comment %} Wishlist page — client-side, reads localStorage 'sb_wishlist' saved by the PDP heart {% endcomment %}
<section class="sb-wl">
  <div class="sb-wl__inner">
    {%- if section.settings.header_image != blank -%}
      <img class="sb-wl__banner" src="{{ section.settings.header_image | asset_url }}" alt="{{ section.settings.heading | default: 'My Wishlist' | strip_html | escape }}">
      <h1 class="sb-wl__title sb-wl__vh">{{ section.settings.heading | default: 'My Wishlist' }}</h1>
    {%- else -%}
      <h1 class="sb-wl__title">{{ section.settings.heading | default: 'My Wishlist' }}</h1>
    {%- endif -%}
    <p class="sb-wl__count" id="sbWlCount"></p>
    <div class="sb-wl__grid" id="sbWlGrid" role="list"></div>
    <div class="sb-wl__empty" id="sbWlEmpty" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
      <p class="sb-wl__empty-h">Your wishlist is empty</p>
      <p class="sb-wl__empty-s">Tap the heart on any product to save it here for later.</p>
      <a class="sb-wl__cta" href="/collections/all">Start shopping</a>
    </div>
  </div>
</section>

<script>
(function () {
  var KEY = 'sb_wishlist';
  var grid = document.getElementById('sbWlGrid'),
      empty = document.getElementById('sbWlEmpty'),
      countEl = document.getElementById('sbWlCount');
  if (!grid) return;
  function read() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
  function write(l) { try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {} if (window.sbUpdateWishCount) window.sbUpdateWishCount(); }
  function money(p) { return '£' + (p / 100).toFixed(2); }
  function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }

  // Self-heal: saved wishlist image URLs are snapshots taken when hearted; if the product
  // image was later re-uploaded the old URL 404s. On failure, re-fetch the live image,
  // swap it in, and rewrite the saved snapshot so it's fixed permanently.
  window.sbWlHeal = function (img) {
    var h = img.getAttribute('data-heal');
    if (!h || img.dataset.healing) return;
    img.dataset.healing = '1';
    fetch('/products/' + h + '.js').then(function (r) { return r.json(); }).then(function (prod) {
      var src = prod.featured_image || (prod.images && prod.images[0]);
      if (!src) return;
      if (src.indexOf('//') === 0) src = 'https:' + src;
      var sized = src + (src.indexOf('?') > -1 ? '&' : '?') + 'width=400';
      img.src = sized;
      try {
        var l = JSON.parse(localStorage.getItem(KEY) || '[]');
        l.forEach(function (x) {
          if (x.handle === h) {
            x.img = sized;
            if (prod.price != null) x.price = prod.price;
            if (prod.compare_at_price != null) x.cprice = prod.compare_at_price;
          }
        });
        localStorage.setItem(KEY, JSON.stringify(l));
      } catch (e) {}
    }).catch(function () {});
  };

  function render() {
    var l = read();
    countEl.textContent = l.length ? (l.length + (l.length === 1 ? ' item saved' : ' items saved')) : '';
    if (!l.length) { grid.innerHTML = ''; empty.hidden = false; return; }
    empty.hidden = true;
    grid.innerHTML = l.map(function (p) {
      var sale = p.cprice && p.cprice > p.price;
      return '<div class="sb-wl__card" role="listitem">'
        + '<button class="sb-wl__remove" aria-label="Remove from wishlist" data-h="' + esc(p.handle) + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg></button>'
        + '<a class="sb-wl__img" href="' + esc(p.url) + '"><img loading="lazy" src="' + esc(p.img || '') + '" alt="' + esc(p.title) + '" data-heal="' + esc(p.handle) + '" onerror="sbWlHeal(this)"></a>'
        + '<div class="sb-wl__info">'
        + (p.vendor ? '<span class="sb-wl__brand">' + esc(p.vendor) + '</span>' : '')
        + '<a class="sb-wl__name" href="' + esc(p.url) + '">' + esc(p.title) + '</a>'
        + '<span class="sb-wl__price">' + (sale ? '<s>' + money(p.cprice) + '</s> ' : '') + '<span' + (sale ? ' class="sb-wl__sale"' : '') + '>' + money(p.price) + '</span></span>'
        + '<button class="sb-wl__atb" data-h="' + esc(p.handle) + '">Add to bag</button>'
        + '</div></div>';
    }).join('');
    grid.querySelectorAll('img[data-heal]').forEach(function (im) { if (!im.getAttribute('src')) sbWlHeal(im); });
  }

  grid.addEventListener('click', function (e) {
    var rm = e.target.closest('.sb-wl__remove');
    if (rm) { write(read().filter(function (x) { return x.handle !== rm.dataset.h; })); render(); return; }
    var atb = e.target.closest('.sb-wl__atb');
    if (atb) { addToBag(atb); }
  });

  function addToBag(btn) {
    var handle = btn.dataset.h, orig = btn.textContent;
    btn.disabled = true; btn.textContent = 'Adding…';
    fetch('/products/' + handle + '.js').then(function (r) { return r.json(); }).then(function (prod) {
      var v = (prod.variants || []).filter(function (x) { return x.available; })[0] || (prod.variants || [])[0];
      if (!v) throw new Error('no variant');
      return fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: [{ id: v.id, quantity: 1 }] }) });
    }).then(function (r) {
      if (!r.ok) throw new Error('add failed');
      btn.textContent = 'Added ✓';
      document.documentElement.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      if (typeof window.openCart === 'function') { try { window.openCart(); } catch (e) {} }
      setTimeout(function () { btn.textContent = orig; btn.disabled = false; }, 2000);
    }).catch(function () {
      btn.textContent = 'Unavailable'; setTimeout(function () { btn.textContent = orig; btn.disabled = false; }, 2000);
    });
  }

  render();
  window.addEventListener('storage', function (e) { if (e.key === KEY) render(); });
})();
</script>

{% stylesheet %}
.sb-wl { padding: 44px 0 70px; }
.sb-wl__inner { max-width: 1560px; margin: 0 auto; padding: 0 40px; }
.sb-wl__title { font-family: var(--font-heading--family, 'Recoleta'), serif; font-weight: 400; font-size: 2rem; letter-spacing: .01em; margin: 0 0 4px; color: #0c0c0c; }
.sb-wl__banner { display: block; width: 100%; max-width: 680px; height: auto; margin: 0 0 12px; }
.sb-wl__vh { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.sb-wl__count { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .6875rem; letter-spacing: .12em; text-transform: uppercase; color: rgba(0,0,0,.45); margin: 0 0 30px; }
.sb-wl__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px 28px; }
.sb-wl__card { position: relative; display: flex; flex-direction: column; }
.sb-wl__remove { position: absolute; top: 8px; right: 8px; z-index: 2; width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,.92); border: 1px solid rgba(0,0,0,.08); box-shadow: 0 2px 8px rgba(0,0,0,.08); cursor: pointer; display: flex; align-items: center; justify-content: center; color: #4a4a4a; transition: color .15s, background .15s; }
.sb-wl__remove:hover { color: #b3122b; background: #fff; }
.sb-wl__remove svg { width: 14px; height: 14px; }
.sb-wl__img { display: block; aspect-ratio: 1/1; background: #f6f4f0; overflow: hidden; }
.sb-wl__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .55s ease; }
.sb-wl__card:hover .sb-wl__img img { transform: scale(1.04); }
.sb-wl__info { padding: 14px 2px 0; display: flex; flex-direction: column; gap: 5px; }
.sb-wl__brand { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .5625rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(0,0,0,.4); }
.sb-wl__name { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .8125rem; line-height: 1.4; color: #1a1a1a; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sb-wl__name:hover { text-decoration: underline; }
.sb-wl__price { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .8125rem; color: #0c0c0c; }
.sb-wl__price s { color: rgba(0,0,0,.4); margin-right: 5px; }
.sb-wl__sale { color: #b3122b; }
.sb-wl__atb { margin-top: 8px; padding: 10px 12px; background: #0c0c0c; color: #fff; border: none; font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .625rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; cursor: pointer; transition: background .18s ease; }
.sb-wl__atb:hover { background: #333; }
.sb-wl__atb:disabled { opacity: .6; cursor: default; }
.sb-wl__empty { text-align: center; padding: 60px 20px 40px; color: #6a6a6a; }
.sb-wl__empty svg { width: 46px; height: 46px; color: #cbb98f; margin-bottom: 18px; }
.sb-wl__empty-h { font-family: var(--font-heading--family, 'Recoleta'), serif; font-size: 1.3rem; color: #0c0c0c; margin: 0 0 6px; }
.sb-wl__empty-s { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .8125rem; margin: 0 0 22px; }
.sb-wl__cta { display: inline-block; padding: 13px 34px; background: #0c0c0c; color: #fff; text-decoration: none; font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .6875rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
@media screen and (max-width: 989px) { .sb-wl__grid { grid-template-columns: repeat(3, 1fr); gap: 28px 20px; } }
@media screen and (max-width: 749px) {
  .sb-wl__inner { padding: 0 16px; }
  .sb-wl__grid { grid-template-columns: repeat(2, 1fr); gap: 22px 14px; }
  .sb-wl__title { font-size: 1.5rem; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist Page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "My Wishlist" },
    { "type": "text", "id": "header_image", "label": "Header banner asset (brand-font PNG)" }
  ],
  "presets": [{ "name": "Wishlist Page" }]
}
{% endschema %}
