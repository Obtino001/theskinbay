<style>
  .lf-hp *, .lf-hp *::before, .lf-hp *::after { box-sizing: border-box; }
  .lf-hp a { text-decoration: none; }
  .lf-inner { max-width: 1560px; margin: 0 auto; padding: 0 40px; }
  .lf-btn {
    display: inline-block; padding: 16px 44px;
    font-family: var(--font-body--family), sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; text-decoration: none; border-radius: 0;
    transition: background .18s, color .18s, border-color .18s;
    cursor: pointer; white-space: nowrap; line-height: 1; border: 1px solid transparent;
  }
  .lf-btn--dark  { background: #000; color: #fff; border-color: #000; }
  .lf-btn--dark:hover  { background: transparent; color: #000; }
  .lf-btn--ghost { background: transparent; color: rgba(255,255,255,.85); border-color: rgba(255,255,255,.35); }
  .lf-btn--ghost:hover { border-color: #fff; background: #fff; color: #000; }

  /* ── Hero slider ─────────────────────────────────────────── */
  .lf-hero { position: relative; overflow: hidden; min-height: 54vh; max-height: 60vh; }
  .lf-hero__slides { display: grid; }
  .lf-hero__slide {
    grid-area: 1 / 1;
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 54vh; max-height: 60vh; overflow: hidden;
    opacity: 0; transition: opacity .65s ease; pointer-events: none;
    background: var(--slide-bg, #000);
  }
  .lf-hero__slide--active { opacity: 1; pointer-events: auto; z-index: 1; }
  .lf-hero__text {
    display: flex; flex-direction: column; justify-content: center;
    padding: 48px clamp(28px,4vw,68px) 48px clamp(20px,4vw,68px);
    position: relative; z-index: 1;
  }
  .lf-hero__eyebrow {
    font-family: var(--font-body--family), sans-serif;
    font-size: .68rem; font-weight: 700; letter-spacing: .24em;
    text-transform: uppercase; color: rgba(255,255,255,.95); margin-bottom: 16px; display: block;
    text-shadow: 0 1px 6px rgba(0,0,0,.45);
  }
  .lf-hero__heading {
    font-family: var(--font-heading--family), serif;
    font-size: clamp(2.5rem,4.8vw,5.25rem); font-weight: 400; line-height: 1.04;
    letter-spacing: -.02em; color: #fff; margin: 0 0 20px;
    text-shadow: 0 2px 18px rgba(0,0,0,.3);
  }
  .lf-hero__heading em { font-style: italic; }
  .lf-hero__body {
    font-size: 1rem; color: #fff; font-weight: 500; line-height: 1.6;
    margin-bottom: 30px; max-width: 420px;
    text-shadow: 0 1px 10px rgba(0,0,0,.5);
  }
  .lf-hero__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .lf-hero__ctas .lf-btn { font-size: 12px; padding: 16px 46px; letter-spacing: .18em; }
  /* Dark text theme, for pale/light banner backgrounds */
  .lf-hero__slide--dark .lf-hero__eyebrow { color: rgba(20,20,20,.72); text-shadow: none; }
  .lf-hero__slide--dark .lf-hero__heading { color: #141414; text-shadow: none; }
  .lf-hero__slide--dark .lf-hero__body { color: #3a352e; text-shadow: none; font-weight: 400; }
  .lf-hero__slide--dark .lf-btn--ghost { color: #141414; border-color: rgba(20,20,20,.35); }
  .lf-hero__slide--dark .lf-btn--ghost:hover { background: #141414; color: #fff; border-color: #141414; }
  .lf-hero__image { position: relative; overflow: hidden; min-height: 54vh; max-height: 60vh; }
  .lf-hero__image img {
    width: 100%; height: 100%; object-fit: cover; object-position: center 58%;
    display: block; position: absolute; inset: 0;
  }
  .lf-hero__image::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    width: 140px; z-index: 2; pointer-events: none;
    background: linear-gradient(to right, var(--slide-bg,#000000) 0%, transparent 100%);
  }
  .lf-hero__image-placeholder { position: absolute; inset: 0; }
  /* Controls */
  .lf-hero__arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 20;
    background: rgba(0,0,0,.18); border: 1px solid rgba(255,255,255,.22); color: #fff;
    width: 44px; height: 44px; border-radius: 0;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background .2s ease; padding: 0;
  }
  .lf-hero__arrow:hover { background: rgba(0,0,0,.38); }
  .lf-hero__arrow--prev { left: 18px; }
  .lf-hero__arrow--next { right: 18px; }
  .lf-hero__arrow svg { width: 18px; height: 18px; stroke-width: 2; display: block; }
  .lf-hero__dots {
    position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
    z-index: 20; display: flex; gap: 8px; align-items: center;
  }
  .lf-hero__dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: rgba(255,255,255,.38); border: none; cursor: pointer; padding: 0;
    transition: background .25s ease, transform .25s ease;
  }
  .lf-hero__dot--active { background: #fff; transform: scale(1.4); }
  .lf-hero--single .lf-hero__arrow,
  .lf-hero--single .lf-hero__dots { display: none; }

  /* ── Category strip ──────────────────────────────────────── */
  .lf-cat-strip {
    display: flex; align-items: center; background: #fff;
    border-bottom: 1px solid rgba(0,0,0,.07);
  }
  .lf-cat-arrow {
    flex: 0 0 auto; width: 40px; min-height: 48px;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer;
    color: #000; opacity: .55; transition: opacity .18s; padding: 0 6px;
  }
  .lf-cat-arrow:hover { opacity: 1; }
  .lf-cat-arrow svg { width: 14px; height: 14px; stroke-width: 2; }
  .lf-cat-viewport {
    flex: 1; overflow-x: auto; overflow-y: hidden; scrollbar-width: none;
    cursor: grab; display: flex; justify-content: center;
  }
  .lf-cat-viewport::-webkit-scrollbar { display: none; }
  .lf-cat-viewport:active { cursor: grabbing; }
  .lf-cat-track { display: flex; gap: 9px; padding: 12px 24px; flex-shrink: 0; align-items: center; }
  .lf-cat-pill {
    flex: 0 0 auto; background: #0c0c0c; color: #fff !important;
    text-decoration: none !important;
    font-family: var(--font-body--family), sans-serif;
    font-size: 11px; font-weight: 700; letter-spacing: .13em;
    text-transform: uppercase; padding: 11px 24px; white-space: nowrap;
    border-radius: 2px;
    transition: transform .22s cubic-bezier(.25,.46,.45,.94), box-shadow .22s ease, background .18s;
  }
  .lf-cat-pill:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(0,0,0,.2); background: #2a2a2a; }

  @media (max-width: 1199px) {
    .lf-hero, .lf-hero__slide { min-height: 48vh; max-height: 52vh; }
    .lf-hero__image { min-height: 48vh; max-height: 52vh; }
  }
  @media (max-width: 899px) {
    .lf-hero, .lf-hero__slide { min-height: unset; max-height: unset; }
    .lf-hero__slide { grid-template-columns: 1fr; }
    .lf-hero__arrow { top: 19vh; width: 38px; height: 38px; }
    .lf-hero__image { order: -1; height: 38vh; min-height: unset; max-height: unset; }
    .lf-hero__image img { object-position: center 35%; }
    .lf-hero__image::before { display: none; }
    /* premium seamless blend from image into the text panel */
    .lf-hero__image::after { content:''; position:absolute; left:0; right:0; bottom:0; height:90px; z-index:3; pointer-events:none; background: linear-gradient(to top, var(--slide-bg,#0c0c0c), transparent); }
    .lf-hero__text { order: 1; padding: 22px 24px 30px; margin-top: -1px; }
    .lf-cat-arrow { display: none; }
    .lf-cat-track { padding: 11px 16px; gap: 8px; }
    .lf-cat-pill { font-size: 10px; padding: 9px 18px; }
  }
  @media (max-width: 749px) {
    .lf-hero__heading { font-size: clamp(1.9rem,7vw,2.5rem); margin-bottom: 12px; }
    .lf-hero__body { font-size: .9rem; margin-bottom: 22px; }
    .lf-hero__ctas { gap: 10px; }
  }
</style>

<div class="lf-hp">
  {%- assign _slides = section.blocks | where: 'type', 'slide' -%}
  {%- assign _slide_count = _slides | size -%}

  <section class="lf-hero{% if _slide_count <= 1 %} lf-hero--single{% endif %}" id="lf-hero-{{ section.id }}">
    <div class="lf-hero__slides" id="lf-hero-slides-{{ section.id }}">

      {%- if _slide_count > 0 -%}
        {%- for block in _slides -%}
          {%- assign _bg = block.settings.bg_color | default: '#000000' -%}
          {%- assign _is_first = forloop.first -%}
          {%- if block.settings.image != blank -%}
            {%- assign _img_alt = block.settings.image.alt | default: block.settings.heading -%}
          {%- else -%}
            {%- assign _img_alt = block.settings.heading | default: 'TheSkinBay' -%}
          {%- endif -%}
          <div class="lf-hero__slide{% if _is_first %} lf-hero__slide--active{% endif %}{% if block.settings.text_theme == 'dark' %} lf-hero__slide--dark{% endif %}"
               style="--slide-bg:{{ _bg }};"
               {{ block.shopify_attributes }}>
            <div class="lf-hero__text" style="background:{{ _bg }};">
              {%- if block.settings.eyebrow != blank -%}
                <span class="lf-hero__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              <h2 class="lf-hero__heading">{{ block.settings.heading | default: 'Expert skincare.' }}</h2>
              {%- if block.settings.body != blank -%}
                <p class="lf-hero__body">{{ block.settings.body }}</p>
              {%- endif -%}
              <div class="lf-hero__ctas">
                {%- if block.settings.cta1_label != blank -%}
                  <a href="{{ block.settings.cta1_link | default: '/collections/all' }}" class="lf-btn lf-btn--dark">{{ block.settings.cta1_label }}</a>
                {%- endif -%}
                {%- if block.settings.cta2_label != blank -%}
                  <a href="{{ block.settings.cta2_link | default: '#' }}" class="lf-btn lf-btn--ghost">{{ block.settings.cta2_label }}</a>
                {%- endif -%}
              </div>
            </div>
            <div class="lf-hero__image" style="background:{{ _bg }};">
              {%- if block.settings.image != blank -%}
                {%- if _is_first -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
                  sizes="(max-width: 749px) 100vw, 50vw"
                  alt="{{ _img_alt | escape }}"
                  loading="eager"
                  fetchpriority="high"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}">
                {%- else -%}
                <img
                  data-src="{{ block.settings.image | image_url: width: 1200 }}"
                  data-srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
                  sizes="(max-width: 749px) 100vw, 50vw"
                  alt="{{ _img_alt | escape }}"
                  loading="lazy"
                  fetchpriority="low"
                  class="lf-hero__lazyimg"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}">
                {%- endif -%}
              {%- else -%}
                {%- if _is_first -%}
                <img
                  src="{{ 'SPF Banner Theskinbay.png' | asset_url }}"
                  alt="{{ _img_alt | escape }}"
                  loading="eager"
                  fetchpriority="high">
                {%- else -%}
                <img
                  data-src="{{ 'SPF Banner Theskinbay.png' | asset_url }}"
                  alt="{{ _img_alt | escape }}"
                  loading="lazy"
                  fetchpriority="low"
                  class="lf-hero__lazyimg">
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="lf-hero__slide lf-hero__slide--active" style="--slide-bg:#000000;">
          <div class="lf-hero__text" style="background:#000000;">
            <span class="lf-hero__eyebrow">{{ section.settings.eyebrow | default: 'Premium Medical Skincare' }}</span>
            <h1 class="lf-hero__heading">{{ section.settings.heading | default: 'Expert skincare,<br><em>clinically curated.</em>' }}</h1>
            <p class="lf-hero__body">{{ section.settings.body | default: 'Professional-grade skincare trusted by dermatologists.' }}</p>
            <div class="lf-hero__ctas">
              <a href="{{ section.settings.cta1_link | default: '/collections/all' }}" class="lf-btn lf-btn--dark">{{ section.settings.cta1_label | default: 'Shop All' }}</a>
              {%- if section.settings.cta2_label != blank -%}
                <a href="{{ section.settings.cta2_link | default: '#' }}" class="lf-btn lf-btn--ghost">{{ section.settings.cta2_label }}</a>
              {%- endif -%}
            </div>
          </div>
          <div class="lf-hero__image" style="background:#000000;">
            {%- assign _fb_img = section.settings.fallback_image -%}
            {%- if _fb_img != blank -%}
              <img
                src="{{ _fb_img | image_url: width: 1200 }}"
                srcset="{{ _fb_img | image_url: width: 800 }} 800w, {{ _fb_img | image_url: width: 1200 }} 1200w, {{ _fb_img | image_url: width: 1600 }} 1600w"
                sizes="(max-width: 749px) 100vw, 50vw"
                alt="{{ _fb_img.alt | escape }}"
                loading="eager"
                fetchpriority="high"
                width="{{ _fb_img.width }}"
                height="{{ _fb_img.height }}">
            {%- else -%}
              <img src="{{ 'SPF Banner Theskinbay.png' | asset_url }}" alt="TheSkinBay" loading="eager" fetchpriority="high">
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if _slide_count > 1 -%}
      <button class="lf-hero__arrow lf-hero__arrow--prev" aria-label="Previous slide">
        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-linecap="round"><path d="M11 3L5 9L11 15"/></svg>
      </button>
      <button class="lf-hero__arrow lf-hero__arrow--next" aria-label="Next slide">
        <svg viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-linecap="round"><path d="M7 3L13 9L7 15"/></svg>
      </button>
      <div class="lf-hero__dots" role="tablist">
        {%- for block in _slides -%}
          <button class="lf-hero__dot{% if forloop.first %} lf-hero__dot--active{% endif %}"
                  role="tab" aria-label="Slide {{ forloop.index }}"
                  data-dot="{{ forloop.index0 }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>

  {%- comment -%}── Category strip ──────────────────────────────────────{%- endcomment -%}
  {%- assign _cats = section.blocks | where: 'type', 'category_pill' -%}
  {%- if _cats.size > 0 or section.settings.show_default_categories -%}
  <div class="lf-cat-strip">
    <button class="lf-cat-arrow lf-cat-arrow--prev" aria-label="Previous"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor"><path d="M9 2L4 7L9 12"/></svg></button>
    <div class="lf-cat-viewport" id="lf-cat-vp-{{ section.id }}">
      <div class="lf-cat-track">
        {%- if _cats.size > 0 -%}
          {%- for block in _cats -%}
            <a href="{{ block.settings.link | default: '/collections/all' }}" class="lf-cat-pill" {{ block.shopify_attributes }}>{{ block.settings.label | default: 'Category' }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="/collections/new-in" class="lf-cat-pill">New In</a>
          <a href="/collections/best-sellers" class="lf-cat-pill">Best Sellers</a>
          <a href="/collections/bundle-deals" class="lf-cat-pill">Bundles</a>
          <a href="/collections/skincare" class="lf-cat-pill">Skincare</a>
          <a href="/collections/suncare" class="lf-cat-pill">Suncare</a>
          <a href="/collections/body-care" class="lf-cat-pill">Bodycare</a>
          <a href="/collections/self-tanning" class="lf-cat-pill">Self Tanning</a>
          <a href="/collections/make-up" class="lf-cat-pill">Makeup</a>
          <a href="/collections/health-wellness" class="lf-cat-pill">Wellness</a>
        {%- endif -%}
      </div>
    </div>
    <button class="lf-cat-arrow lf-cat-arrow--next" aria-label="Next"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor"><path d="M5 2L10 7L5 12"/></svg></button>
  </div>
  {%- endif -%}
</div>

<script>
(function() {
  var sid = '{{ section.id }}';
  // ── Hero slider ───────────────────────────────────
  var hero = document.getElementById('lf-hero-' + sid);
  if (hero) {
    var slides = hero.querySelectorAll('.lf-hero__slide');
    var dots   = hero.querySelectorAll('.lf-hero__dot');
    var prev   = hero.querySelector('.lf-hero__arrow--prev');
    var next   = hero.querySelector('.lf-hero__arrow--next');
    var cur = 0, total = slides.length, timer;
    // Slides 2..N carry data-src to keep them off the LCP critical path; hydrate them
    // just-in-time on advance, and (guaranteed) after load during idle so none stay blank.
    function hydrate(slide) {
      if (!slide) return;
      var im = slide.querySelector('img[data-src]');
      if (!im) return;
      if (im.dataset.srcset) im.setAttribute('srcset', im.dataset.srcset);
      im.setAttribute('src', im.dataset.src);
      im.removeAttribute('data-src'); im.removeAttribute('data-srcset');
    }
    function hydrateAll() { for (var h = 0; h < slides.length; h++) hydrate(slides[h]); }
    window.addEventListener('load', function () {
      if ('requestIdleCallback' in window) requestIdleCallback(hydrateAll, { timeout: 3000 });
      else setTimeout(hydrateAll, 700);
    });
    if (total > 1) {
      function goTo(i) {
        slides[cur].classList.remove('lf-hero__slide--active');
        dots[cur] && dots[cur].classList.remove('lf-hero__dot--active');
        cur = (i + total) % total;
        hydrate(slides[cur]);
        hydrate(slides[(cur + 1) % total]);
        slides[cur].classList.add('lf-hero__slide--active');
        dots[cur] && dots[cur].classList.add('lf-hero__dot--active');
      }
      function start() { timer = setInterval(function(){ goTo(cur+1); }, {{ section.settings.autoplay_speed | default: 6000 }}); }
      function stop()  { clearInterval(timer); }
      if (prev) prev.addEventListener('click', function(){ stop(); goTo(cur-1); start(); });
      if (next) next.addEventListener('click', function(){ stop(); goTo(cur+1); start(); });
      dots.forEach(function(d){ d.addEventListener('click', function(){ stop(); goTo(+this.dataset.dot); start(); }); });
      hero.addEventListener('mouseenter', stop);
      hero.addEventListener('mouseleave', start);
      var tx = 0;
      hero.addEventListener('touchstart', function(e){ tx = e.touches[0].clientX; }, {passive:true});
      hero.addEventListener('touchend', function(e){
        var dx = e.changedTouches[0].clientX - tx;
        if (Math.abs(dx) > 40){ stop(); goTo(dx < 0 ? cur+1 : cur-1); start(); }
      }, {passive:true});
      start();
    }
  }
  // ── Category strip drag ───────────────────────────
  var vp = document.getElementById('lf-cat-vp-' + sid);
  if (vp) {
    var down = false, sx = 0, sl = 0;
    vp.addEventListener('mousedown', function(e){ down=true; sx=e.pageX-vp.offsetLeft; sl=vp.scrollLeft; });
    vp.addEventListener('mouseleave', function(){ down=false; });
    vp.addEventListener('mouseup',   function(){ down=false; });
    vp.addEventListener('mousemove', function(e){ if(!down) return; e.preventDefault(); vp.scrollLeft=sl-(e.pageX-vp.offsetLeft-sx); });
    var prev2 = vp.closest('.lf-cat-strip').querySelector('.lf-cat-arrow--prev');
    var next2 = vp.closest('.lf-cat-strip').querySelector('.lf-cat-arrow--next');
    if (prev2) prev2.addEventListener('click', function(){ vp.scrollBy({left:-220,behavior:'smooth'}); });
    if (next2) next2.addEventListener('click', function(){ vp.scrollBy({left:220,behavior:'smooth'}); });
  }
})();
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Fallback (when no slides added)" },
    { "type": "image_picker", "id": "fallback_image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Pre-heading", "default": "Premium Medical Skincare" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Expert skincare,<br><em>clinically curated.</em>" },
    { "type": "textarea", "id": "body", "label": "Body text", "default": "Professional-grade skincare trusted by dermatologists." },
    { "type": "text", "id": "cta1_label", "label": "Button 1 label", "default": "Shop All" },
    { "type": "url",  "id": "cta1_link",  "label": "Button 1 link" },
    { "type": "text", "id": "cta2_label", "label": "Button 2 label" },
    { "type": "url",  "id": "cta2_link",  "label": "Button 2 link" },
    { "type": "header", "content": "Slider settings" },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay interval (ms)", "min": 3000, "max": 9000, "step": 500, "default": 6000 },
    { "type": "header", "content": "Category strip" },
    { "type": "checkbox", "id": "show_default_categories", "label": "Show default category pills", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Banner image" },
        { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#e8722a" },
        { "type": "select", "id": "text_theme", "label": "Text colour", "default": "light", "options": [ { "value": "light", "label": "Light (white)" }, { "value": "dark", "label": "Dark (charcoal)" } ], "info": "Choose Dark on pale/light banner backgrounds so the text stays readable." },
        { "type": "text", "id": "eyebrow", "label": "Pre-heading" },
        { "type": "textarea", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body text" },
        { "type": "text", "id": "cta1_label", "label": "Button 1 label" },
        { "type": "url",  "id": "cta1_link",  "label": "Button 1 link" },
        { "type": "text", "id": "cta2_label", "label": "Button 2 label" },
        { "type": "url",  "id": "cta2_link",  "label": "Button 2 link" }
      ]
    },
    {
      "type": "category_pill",
      "name": "Category Pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop Now" },
        { "type": "url",  "id": "link",  "label": "Link" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "Hero Slider" }]
}
{% endschema %}
