<style>
  .lf-sub *, .lf-sub *::before, .lf-sub *::after { box-sizing: border-box; }
  .lf-sub a { text-decoration: none; }

  /* ── Hero ───────────────────────────────────────────── */
  .lf-sub-hero { background: #0b1225; padding: 88px 40px 80px; text-align: center; }
  .lf-sub-eyebrow {
    font-family: 'Lato', sans-serif; font-size: 0.625rem; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: rgba(255,255,255,0.4);
    display: block; margin-bottom: 18px;
  }
  .lf-sub-hero-heading {
    font-family: 'Playfair Display', Georgia, serif; font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 400; color: #fff; margin: 0 0 18px; line-height: 1.08; letter-spacing: -0.02em;
  }
  .lf-sub-hero-body {
    font-family: 'Lato', sans-serif; font-size: 1rem; color: rgba(255,255,255,0.55);
    line-height: 1.7; max-width: 560px; margin: 0 auto;
  }
  .lf-sub-banner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 22px;}
  .lf-sub-banner-int{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 40px;}
  .lf-sub-vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
  .lf-sub-hero-link {
    display: inline-block; margin-top: 26px; font-family: 'Lato', sans-serif; font-size: 0.75rem;
    font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.85);
    border-bottom: 1px solid rgba(255,255,255,0.35); padding-bottom: 4px; transition: color .18s, border-color .18s;
  }
  .lf-sub-hero-link:hover { color: #fff; border-color: #fff; }

  /* ── Benefit banner ─────────────────────────────────── */
  .lf-sub-benefit {
    background: #faf8f5; border-top: 3px solid #1a1a1a; border-bottom: 1px solid #e7e0d6;
    padding: 28px 40px; text-align: center;
  }
  .lf-sub-benefit-inner {
    max-width: 900px; margin: 0 auto; display: flex; align-items: center;
    justify-content: center; gap: 14px; flex-wrap: wrap;
  }
  .lf-sub-benefit-icon { width: 28px; height: 28px; color: #1a1a1a; flex-shrink: 0; }
  .lf-sub-benefit-icon svg { width: 100%; height: 100%; display: block; }
  .lf-sub-benefit-text { font-family: 'Lato', sans-serif; font-size: 0.9375rem; font-weight: 700; color: #1a1a1a; letter-spacing: 0.01em; }
  .lf-sub-benefit-sub { font-family: 'Lato', sans-serif; font-size: 0.875rem; color: #6b6459; margin-top: 4px; }

  /* ── Shared section shells ──────────────────────────── */
  .lf-sub-sec { padding: 80px 40px; border-top: 1px solid rgba(0,0,0,.06); }
  .lf-sub-sec-white { background: #fff; }
  .lf-sub-sec-cream { background: #faf8f5; }
  .lf-sub-inner { max-width: 1200px; margin: 0 auto; }
  .lf-sub-sec-eyebrow {
    font-family: 'Lato', sans-serif; font-size: 0.5rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(0,0,0,0.35); display: block; margin-bottom: 10px; text-align: center;
  }
  .lf-sub-sec-heading {
    font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 400;
    color: #111; margin: 0 0 52px; line-height: 1.1; letter-spacing: -0.015em; text-align: center;
  }
  .lf-sub-sec-heading em { font-style: italic; }

  /* ── How it works grid ──────────────────────────────── */
  .lf-sub-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: rgba(0,0,0,.07); border: 1px solid rgba(0,0,0,.07);
  }
  .lf-sub-card { background: #fff; padding: 40px 32px 36px; display: flex; flex-direction: column; }
  .lf-sub-card-num {
    font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; font-weight: 400;
    color: #0b1225; line-height: 1; margin-bottom: 18px;
  }
  .lf-sub-card-name { font-family: 'Playfair Display', Georgia, serif; font-size: 1.375rem; font-weight: 400; color: #111; margin: 0 0 14px; line-height: 1.15; }
  .lf-sub-card-desc { font-family: 'Lato', sans-serif; font-size: 0.875rem; color: rgba(0,0,0,0.55); line-height: 1.75; margin: 0; }

  /* ── Manage: portal button + step columns ───────────── */
  .lf-sub-portal-cta { text-align: center; margin: 0 0 56px; }
  .lf-sub-btn {
    font-family: 'Lato', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: #fff; background: #1a1a1a; border: 1px solid #1a1a1a;
    padding: 15px 40px; display: inline-block; transition: background .18s, color .18s;
  }
  .lf-sub-btn:hover { background: #333; }
  .lf-sub-btn-ghost { color: #1a1a1a; background: transparent; }
  .lf-sub-btn-ghost:hover { background: rgba(0,0,0,0.05); }
  .lf-sub-portal-note { font-family: 'Lato', sans-serif; font-size: 0.8125rem; color: rgba(0,0,0,0.45); margin: 16px auto 0; max-width: 560px; line-height: 1.6; }
  .lf-sub-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(0,0,0,.07); border: 1px solid rgba(0,0,0,.07); }
  .lf-sub-step { background: #faf8f5; padding: 36px 30px; }
  .lf-sub-step-tag {
    font-family: 'Lato', sans-serif; font-size: 0.5rem; font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(0,0,0,0.3); margin-bottom: 12px; display: block;
  }
  .lf-sub-step-name { font-family: 'Playfair Display', Georgia, serif; font-size: 1.375rem; font-weight: 400; color: #111; margin: 0 0 20px; }
  .lf-sub-step ol, .lf-sub-step ul { margin: 0; padding: 0; list-style: none; }
  .lf-sub-step li {
    font-family: 'Lato', sans-serif; font-size: 0.8125rem; line-height: 1.5; color: #4a453d;
    padding: 9px 0 9px 26px; position: relative; border-top: 1px solid #ece5da;
  }
  .lf-sub-step li:first-child { border-top: 0; }
  .lf-sub-step ol { counter-reset: s; }
  .lf-sub-step ol li::before {
    counter-increment: s; content: counter(s); position: absolute; left: 0; top: 8px;
    font-family: 'Lato', sans-serif; font-size: 0.5625rem; font-weight: 700; color: #fff; background: #1a1a1a;
    width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  }
  .lf-sub-step ul li::before { content: ''; position: absolute; left: 4px; top: 15px; width: 6px; height: 6px; background: #1a1a1a; border-radius: 50%; }

  /* ── Info strip ─────────────────────────────────────── */
  .lf-sub-info-inner {
    max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: rgba(0,0,0,.07); border: 1px solid rgba(0,0,0,.07);
  }
  .lf-sub-info-item { background: #faf8f5; padding: 32px 28px; display: flex; flex-direction: column; gap: 8px; }
  .lf-sub-info-icon { width: 28px; height: 28px; color: #0b1225; margin-bottom: 6px; }
  .lf-sub-info-icon svg { width: 100%; height: 100%; display: block; }
  .lf-sub-info-title { font-family: 'Lato', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #111; margin: 0; }
  .lf-sub-info-text { font-family: 'Lato', sans-serif; font-size: 0.875rem; color: rgba(0,0,0,0.5); line-height: 1.7; margin: 0; }
  .lf-sub-info-text a { color: #0b1225; border-bottom: 1px solid rgba(11,18,37,0.3); padding-bottom: 1px; }
  .lf-sub-info-text a:hover { border-color: #0b1225; }

  /* ── FAQ ────────────────────────────────────────────── */
  .lf-sub-faq-inner { max-width: 820px; margin: 0 auto; }
  .lf-sub-faq { border-top: 1px solid rgba(0,0,0,.1); }
  .lf-sub-faq summary {
    font-family: 'Lato', sans-serif; font-size: 1rem; font-weight: 700; color: #1a1a1a;
    padding: 24px 44px 24px 0; position: relative; cursor: pointer; list-style: none; line-height: 1.4;
  }
  .lf-sub-faq summary::-webkit-details-marker { display: none; }
  .lf-sub-faq summary::after {
    content: '+'; position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
    font-family: 'Lato', sans-serif; font-size: 1.5rem; font-weight: 400; color: #1a1a1a; transition: transform .2s;
  }
  .lf-sub-faq[open] summary::after { content: '\2212'; }
  .lf-sub-faq-body { font-family: 'Lato', sans-serif; font-size: 0.9375rem; color: rgba(0,0,0,0.6); line-height: 1.75; padding: 0 44px 26px 0; margin: 0; }
  .lf-sub-faq-body a { color: #0b1225; border-bottom: 1px solid rgba(11,18,37,0.3); }

  /* ── Bottom CTA ─────────────────────────────────────── */
  .lf-sub-cta { background: #0b1225; padding: 72px 40px; text-align: center; }
  .lf-sub-cta-heading { font-family: 'Playfair Display', Georgia, serif; font-size: clamp(1.5rem, 2.5vw, 2.25rem); font-weight: 400; color: #fff; margin: 0 0 12px; line-height: 1.1; letter-spacing: -0.015em; }
  .lf-sub-cta-heading em { font-style: italic; }
  .lf-sub-cta-body { font-family: 'Lato', sans-serif; font-size: 0.9375rem; color: rgba(255,255,255,0.5); margin: 0 0 36px; line-height: 1.7; max-width: 520px; margin-left: auto; margin-right: auto; }
  .lf-sub-cta-btn {
    font-family: 'Lato', sans-serif; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: #fff; background: transparent; border: 1px solid rgba(255,255,255,0.5); padding: 14px 36px; display: inline-block;
    transition: background .18s, border-color .18s; margin: 0 6px 10px;
  }
  .lf-sub-cta-btn:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.8); }
  .lf-sub-cta-btn-solid { background: #fff; color: #0b1225; border-color: #fff; }
  .lf-sub-cta-btn-solid:hover { background: rgba(255,255,255,0.85); }

  /* ── Responsive ─────────────────────────────────────── */
  @media (max-width: 899px) {
    .lf-sub-grid, .lf-sub-steps, .lf-sub-info-inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 749px) {
    .lf-sub-hero { padding: 60px 24px 52px; }
    .lf-sub-benefit { padding: 20px 24px; }
    .lf-sub-sec { padding: 52px 20px; }
    .lf-sub-cta { padding: 52px 20px; }
  }
</style>

{%- assign portal = section.settings.portal_url | default: '/a/subscriptions/manage' -%}
{%- assign email = section.settings.support_email | default: 'info@theskinbay.co.uk' -%}
{%- comment -%} Logged-out customers hit Seal's "not logged in" dead-end, so route them via login first {%- endcomment -%}
{%- if customer -%}
  {%- assign portal_link = portal -%}
{%- else -%}
  {%- assign ret = portal | url_encode -%}
  {%- assign portal_link = routes.account_login_url | append: '?return_url=' | append: ret -%}
{%- endif -%}

<div class="lf-sub">

  {%- comment -%}── Hero ────────────────────────────────────────{%- endcomment -%}
  <section class="lf-sub-hero">
    {%- if section.settings.header_image != blank -%}
      <img class="lf-sub-banner" src="{{ section.settings.header_image | asset_url }}" alt="{{ section.settings.heading | strip_html | escape }}">
      {%- if section.settings.heading != blank -%}
        <h1 class="lf-sub-hero-heading lf-sub-vh">{{ section.settings.heading }}</h1>
      {%- endif -%}
    {%- else -%}
      <span class="lf-sub-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="lf-sub-hero-heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    <p class="lf-sub-hero-body">{{ section.settings.hero_body }}</p>
    <a href="{{ portal_link }}" class="lf-sub-hero-link">{{ section.settings.hero_link_label | default: 'Already subscribed? Manage or cancel in seconds' }} &rarr;</a>
  </section>

  {%- comment -%}── Benefit banner ──────────────────────────────{%- endcomment -%}
  <div class="lf-sub-benefit">
    <div class="lf-sub-benefit-inner">
      <div class="lf-sub-benefit-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9"/><polyline points="3 4 3 12 11 12" transform="translate(0.5 0)"/><path d="M3 8l0 4 4 0"/>
        </svg>
      </div>
      <div>
        <div class="lf-sub-benefit-text">{{ section.settings.benefit_text }}</div>
        <div class="lf-sub-benefit-sub">{{ section.settings.benefit_sub }}</div>
      </div>
    </div>
  </div>

  {%- comment -%}── How it works ────────────────────────────────{%- endcomment -%}
  <section class="lf-sub-sec lf-sub-sec-white">
    <div class="lf-sub-inner">
      <span class="lf-sub-sec-eyebrow">How it works</span>
      <img class="lf-sub-banner-int" src="{{ 'subs-h-setup.png' | asset_url }}" alt="Set it up once, never run out.">
      <h2 class="lf-sub-sec-heading lf-sub-vh">Set it up once, <em>never run out.</em></h2>
      <div class="lf-sub-grid">
        <div class="lf-sub-card">
          <div class="lf-sub-card-num">01</div>
          <h3 class="lf-sub-card-name">Choose &amp; subscribe</h3>
          <p class="lf-sub-card-desc">On any product showing the <strong>Subscribe &amp; Save</strong> option, select Subscribe instead of one-time, pick how often you would like it delivered, then add to bag and check out as normal.</p>
        </div>
        <div class="lf-sub-card">
          <div class="lf-sub-card-num">02</div>
          <h3 class="lf-sub-card-name">We deliver on repeat</h3>
          <p class="lf-sub-card-desc">Your first order ships straight away. After that we prepare and send each delivery automatically on your chosen schedule, with your subscription saving applied every single time.</p>
        </div>
        <div class="lf-sub-card">
          <div class="lf-sub-card-num">03</div>
          <h3 class="lf-sub-card-name">You stay in control</h3>
          <p class="lf-sub-card-desc">We email a reminder before every order. Skip it, change the date, swap products, update your details, pause or cancel, all from your own subscription portal in seconds.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%}── Manage your subscription ────────────────────{%- endcomment -%}
  <section class="lf-sub-sec lf-sub-sec-cream">
    <div class="lf-sub-inner">
      <span class="lf-sub-sec-eyebrow">Your subscriptions</span>
      <img class="lf-sub-banner-int" src="{{ 'subs-h-manage.png' | asset_url }}" alt="View, change or cancel any time.">
      <h2 class="lf-sub-sec-heading lf-sub-vh">View, change or cancel <em>any time.</em></h2>

      <div class="lf-sub-portal-cta">
        <a href="{{ portal_link }}" class="lf-sub-btn">{% if customer %}Manage My Subscriptions{% else %}Log In to Manage{% endif %}</a>
        <p class="lf-sub-portal-note">{% unless customer %}You will be asked to sign in first, or just use the <strong>Manage subscription</strong> link in your subscription email, no login needed. {% endunless %}Everything is self-service. Change, skip, pause or cancel in seconds, no need to contact us.</p>
      </div>

      <div class="lf-sub-steps">
        <div class="lf-sub-step">
          <span class="lf-sub-step-tag">View &amp; check</span>
          <h3 class="lf-sub-step-name">See your plan</h3>
          <ol>
            <li>Open your subscription portal using the button above, or the link in any subscription email.</li>
            <li>Sign in with your account email if you are asked to.</li>
            <li>View every active subscription: the products, your next delivery date, frequency and price.</li>
          </ol>
        </div>
        <div class="lf-sub-step">
          <span class="lf-sub-step-tag">Amend &amp; adjust</span>
          <h3 class="lf-sub-step-name">Change anything</h3>
          <ul>
            <li>Change how often it is delivered</li>
            <li>Skip or reschedule your next order</li>
            <li>Change product quantities</li>
            <li>Add or remove products</li>
            <li>Update your delivery address</li>
            <li>Update your payment card</li>
            <li>Pause and resume whenever you like</li>
          </ul>
        </div>
        <div class="lf-sub-step">
          <span class="lf-sub-step-tag">Cancel</span>
          <h3 class="lf-sub-step-name">Stop any time</h3>
          <ol>
            <li>Open your subscription portal.</li>
            <li>Select the subscription you would like to stop.</li>
            <li>Choose <strong>Cancel subscription</strong>, and that is it.</li>
          </ol>
          <p style="font-family:'Lato',sans-serif;font-size:0.75rem;color:rgba(0,0,0,0.45);line-height:1.6;margin:16px 0 0;">Cancelling is genuinely quick. No fees, no minimum term, and you never have to call or email to do it. You can reactivate later whenever you want.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%}── Info strip ──────────────────────────────────{%- endcomment -%}
  <div class="lf-sub-sec lf-sub-sec-cream" style="padding-top:0;border-top:0;">
    <div class="lf-sub-info-inner">
      <div class="lf-sub-info-item">
        <div class="lf-sub-info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </div>
        <p class="lf-sub-info-title">A reminder before every order</p>
        <p class="lf-sub-info-text">We email you ahead of each renewal, so there are no surprises. Skip or change your order before it is sent.</p>
      </div>
      <div class="lf-sub-info-item">
        <div class="lf-sub-info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
        </div>
        <p class="lf-sub-info-title">No minimum, no lock-in</p>
        <p class="lf-sub-info-text">Pause, skip or cancel whenever it suits you. You are never tied in, and there is nothing to pay to stop.</p>
      </div>
      <div class="lf-sub-info-item">
        <div class="lf-sub-info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <p class="lf-sub-info-title">Need a hand?</p>
        <p class="lf-sub-info-text">Email <a href="mailto:{{ email }}">{{ email }}</a> and we will help with anything subscription-related.</p>
      </div>
    </div>
  </div>

  {%- comment -%}── FAQ ─────────────────────────────────────────{%- endcomment -%}
  <section class="lf-sub-sec lf-sub-sec-white">
    <div class="lf-sub-faq-inner">
      <span class="lf-sub-sec-eyebrow">Good to know</span>
      <img class="lf-sub-banner-int" src="{{ 'subs-h-questions.png' | asset_url }}" alt="Subscription questions.">
      <h2 class="lf-sub-sec-heading lf-sub-vh">Subscription <em>questions.</em></h2>

      <details class="lf-sub-faq">
        <summary>What exactly is a subscription?</summary>
        <p class="lf-sub-faq-body">It is a simple way to have the products you use regularly delivered automatically, so you never run low. You choose the products and how often you want them, and we take care of the rest, sending each order on schedule with your subscription saving applied.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>How do I start a subscription?</summary>
        <p class="lf-sub-faq-body">On any product that offers it, choose the <strong>Subscribe &amp; Save</strong> option instead of a one-time purchase, select your delivery frequency, then add to bag and check out. Your subscription is created automatically from that first order.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>Do I save money by subscribing?</summary>
        <p class="lf-sub-faq-body">Yes. Every subscription order comes with a saving applied automatically, on your first order and every repeat order after it, for as long as your subscription is active.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>When and how am I charged?</summary>
        <p class="lf-sub-faq-body">Your first payment is taken at checkout. After that, each repeat order is charged automatically to your saved card on your chosen schedule. We always email you a reminder before an order is placed, so you have time to skip or change it.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>Will I be reminded before each delivery?</summary>
        <p class="lf-sub-faq-body">Always. You will receive an email ahead of every renewal. If you want to skip that order, change the date or edit the products, you can do it from your <a href="{{ portal_link }}">subscription portal</a> before it is sent.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>How do I change the frequency or skip an order?</summary>
        <p class="lf-sub-faq-body">Open your <a href="{{ portal_link }}">subscription portal</a>, select your subscription, and you can change how often it is delivered, skip the next order, or reschedule it to a date that suits you.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>Can I add, remove or swap products?</summary>
        <p class="lf-sub-faq-body">Yes. In the portal you can change quantities, add new products to your subscription, or remove ones you no longer need, all in a few taps.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>How do I update my address or payment card?</summary>
        <p class="lf-sub-faq-body">Both are updated in your <a href="{{ portal_link }}">subscription portal</a>. Change your delivery address or payment details there and it applies to your next and all future orders.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>How do I cancel, and is there a minimum term?</summary>
        <p class="lf-sub-faq-body">There is no minimum term and no cancellation fee. Open your <a href="{{ portal_link }}">subscription portal</a>, select the subscription, and choose Cancel subscription. You can also pause instead if you just need a break, and reactivate whenever you like.</p>
      </details>
      <details class="lf-sub-faq">
        <summary>I cannot find my subscription. What do I do?</summary>
        <p class="lf-sub-faq-body">Use the <strong>Manage subscription</strong> link in any subscription email we have sent you, which opens your account directly. If you are still stuck, email <a href="mailto:{{ email }}">{{ email }}</a> and we will sort it for you.</p>
      </details>
    </div>
  </section>

  {%- comment -%}── Bottom CTA ──────────────────────────────────{%- endcomment -%}
  <section class="lf-sub-cta">
    <img class="lf-sub-banner-int" src="{{ 'subs-h-cta.png' | asset_url }}" alt="Never run out again." style="margin-bottom:20px;">
    <h2 class="lf-sub-cta-heading lf-sub-vh">Never run out <em>again.</em></h2>
    <p class="lf-sub-cta-body">{{ section.settings.cta_body }}</p>
    <a href="{{ portal_link }}" class="lf-sub-cta-btn lf-sub-cta-btn-solid">{% if customer %}Manage My Subscriptions{% else %}Log In to Manage{% endif %}</a>
    <a href="{{ section.settings.shop_link | default: '/collections/all' }}" class="lf-sub-cta-btn">Shop Products</a>
  </section>

</div>

{% schema %}
{
  "name": "Subscriptions Page",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text",     "id": "header_image", "label": "Header banner asset (brand-font PNG)" },
    { "type": "text",     "id": "eyebrow",   "label": "Eyebrow", "default": "Subscribe & Save" },
    { "type": "text",     "id": "heading",   "label": "Heading", "default": "Subscriptions." },
    { "type": "textarea", "id": "hero_body", "label": "Hero body", "default": "Set up automatic deliveries of the products you love, so you never run low again. Choose your schedule, save on every order, and stay in full control. Pause, skip, change or cancel any time." },
    { "type": "text", "id": "hero_link_label", "label": "Hero quick-link label", "default": "Already subscribed? Manage or cancel in seconds" },
    { "type": "header", "content": "Benefit banner" },
    { "type": "text", "id": "benefit_text", "label": "Benefit text", "default": "Never run low again, your essentials delivered on repeat." },
    { "type": "text", "id": "benefit_sub",  "label": "Benefit sub-note", "default": "Save on every order and stay in control. Change or cancel any time." },
    { "type": "header", "content": "Links" },
    { "type": "text", "id": "portal_url",    "label": "Subscription portal URL", "default": "/a/subscriptions/manage" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "info@theskinbay.co.uk" },
    { "type": "url",  "id": "shop_link",     "label": "Shop button link" },
    { "type": "header", "content": "Bottom CTA" },
    { "type": "textarea", "id": "cta_body", "label": "CTA body", "default": "Set up a subscription on your everyday essentials and let us keep you topped up, delivered on your schedule, with a saving every time." }
  ],
  "presets": [{ "name": "Subscriptions Page" }]
}
{% endschema %}
