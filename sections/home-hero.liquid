{%- comment -%} Skin Bay homepage — branded promo hero slider (autoplay, brand fonts) {%- endcomment -%}
{%- assign slides = section.blocks | where: 'type', 'slide' -%}
<section class="home-hero" style="background:{{ section.settings.bg }};">
  <h1 class="hh-h1">{{ section.settings.seo_h1 }}</h1>
  <div class="hh-slider" id="hh-{{ section.id }}"
       data-autoplay="{% if section.settings.autoplay %}1{% else %}0{% endif %}"
       data-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
    {%- if slides.size > 0 -%}
      {%- for block in slides -%}
        {%- assign has_img = false -%}{%- if block.settings.image != blank -%}{%- assign has_img = true -%}{%- endif -%}
        <div class="hh-slide{% if forloop.first %} is-active{% endif %}"
             data-theme="{{ block.settings.text_theme | default: 'dark' }}"
             style="{% if block.settings.bg_color != blank %}background:{{ block.settings.bg_color }};{% endif %}"
             {{ block.shopify_attributes }}>
          <div class="hh-inner{% if has_img %} hh-inner--split{% endif %}">
            <div class="hh-text">
              {%- if block.settings.eyebrow != blank -%}<span class="hh-eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
              {%- if block.settings.headline_image != blank -%}
                <img class="hh-headline" src="{{ block.settings.headline_image | asset_url }}" alt="{{ block.settings.heading | default: section.settings.seo_h1 | escape }}" width="1500" height="340" {% unless forloop.first %}loading="lazy"{% endunless %}>
              {%- elsif block.settings.heading != blank -%}
                <h2 class="hh-heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.body != blank -%}<p class="hh-sub">{{ block.settings.body }}</p>{%- endif -%}
              <div class="hh-ctas">
                {%- if block.settings.cta1_label != blank -%}<a class="hh-btn hh-btn--solid" href="{{ block.settings.cta1_link }}">{{ block.settings.cta1_label }}</a>{%- endif -%}
                {%- if block.settings.cta2_label != blank -%}<a class="hh-btn hh-btn--ghost" href="{{ block.settings.cta2_link }}">{{ block.settings.cta2_label }}</a>{%- endif -%}
              </div>
            </div>
            {%- if has_img -%}
              <div class="hh-media"><img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.heading | escape }}" {% unless forloop.first %}loading="lazy"{% endunless %} width="900" height="900"></div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
    {%- if section.settings.show_arrows and slides.size > 1 -%}
      <button type="button" class="hh-arrow hh-arrow--prev" aria-label="Previous slide" data-hh-prev>&#8249;</button>
      <button type="button" class="hh-arrow hh-arrow--next" aria-label="Next slide" data-hh-next>&#8250;</button>
    {%- endif -%}
  </div>
  {%- if section.settings.show_dots and slides.size > 1 -%}
    <div class="hh-dots" role="tablist">
      {%- for block in slides -%}<button type="button" class="hh-dot{% if forloop.first %} is-active{% endif %}" data-hh-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>{%- endfor -%}
    </div>
  {%- endif -%}
  {%- if section.settings.brand_strip != blank -%}
    <div class="hh-brands"><span>{{ section.settings.brand_strip }}</span></div>
  {%- endif -%}
</section>
<style>
  .home-hero{padding:0 0 34px;text-align:center;overflow:hidden;}
  .hh-h1{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
  .hh-slider{position:relative;display:grid;}
  .hh-slide{grid-area:1/1;opacity:0;visibility:hidden;transition:opacity .6s ease;pointer-events:none;}
  .hh-slide.is-active{opacity:1;visibility:visible;pointer-events:auto;}
  .hh-inner{max-width:1240px;margin:0 auto;padding:54px 44px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;min-height:430px;}
  /* split promo: image bleeds to the outer edge, text aligned to page gutter */
  .hh-inner--split{max-width:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;align-items:stretch;gap:0;min-height:500px;text-align:left;}
  .hh-inner--split .hh-text{align-self:center;padding:48px 48px 48px clamp(24px,6vw,110px);max-width:none;}
  .hh-inner--split .hh-headline{margin-left:0;margin-right:auto;}
  .hh-inner--split .hh-ctas{justify-content:flex-start;}
  .hh-inner--split .hh-media{position:relative;min-height:500px;overflow:hidden;}
  .hh-inner--split .hh-media img{position:absolute;inset:0;width:100%;height:100%;max-height:none;max-width:none;object-fit:cover;filter:none;border-radius:0;}
  .hh-text{max-width:600px;}
  .hh-eyebrow{display:block;font-family:var(--font-body--family), sans-serif;font-size:12px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:#8a857c;margin-bottom:12px;}
  .hh-headline{display:block;width:100%;max-width:520px;height:auto;margin:0 auto;}
  .hh-heading{font-family:var(--font-heading--family), serif;font-size:clamp(30px,4.4vw,52px);font-weight:500;line-height:1.04;color:#141414;margin:0;}
  .hh-sub{font-family:var(--font-body--family), sans-serif;font-size:16px;line-height:1.6;color:#4a4a4a;margin:16px 0 0;}
  .hh-inner:not(.hh-inner--split) .hh-sub{max-width:540px;margin-left:auto;margin-right:auto;}
  .hh-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px;justify-content:center;}
  .hh-btn{display:inline-flex;align-items:center;justify-content:center;font-family:var(--font-body--family), sans-serif;font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;padding:15px 32px;border-radius:40px;text-decoration:none;transition:transform .15s ease,background .2s ease,color .2s ease;white-space:nowrap;}
  .hh-btn--solid{background:#141414;color:#fff;border:1.5px solid #141414;}
  .hh-btn--solid:hover{transform:translateY(-1px);}
  .hh-btn--ghost{background:transparent;color:#141414;border:1.5px solid rgba(20,20,20,.4);}
  .hh-btn--ghost:hover{border-color:#141414;background:#141414;color:#fff;}
  /* Light theme (white text on dark brand-colour slides) */
  .hh-slide[data-theme="light"] .hh-eyebrow{color:rgba(255,255,255,.72);}
  .hh-slide[data-theme="light"] .hh-heading{color:#fff;}
  .hh-slide[data-theme="light"] .hh-sub{color:rgba(255,255,255,.82);}
  .hh-slide[data-theme="light"] .hh-btn--solid{background:#fff;color:#141414;border-color:#fff;}
  .hh-slide[data-theme="light"] .hh-btn--solid:hover{background:rgba(255,255,255,.88);}
  .hh-slide[data-theme="light"] .hh-btn--ghost{color:#fff;border-color:rgba(255,255,255,.55);}
  .hh-slide[data-theme="light"] .hh-btn--ghost:hover{background:#fff;color:#141414;border-color:#fff;}
  .hh-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:42px;height:42px;border-radius:50%;border:1.5px solid rgba(255,255,255,.5);background:rgba(0,0,0,.28);color:#fff;font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s,border-color .2s;}
  .hh-arrow:hover{background:#000;border-color:#fff;}
  .hh-arrow--prev{left:14px;}.hh-arrow--next{right:14px;}
  .hh-dots{display:flex;justify-content:center;gap:9px;margin-top:20px;}
  .hh-dot{width:8px;height:8px;padding:0;border-radius:50%;border:none;background:rgba(20,20,20,.22);cursor:pointer;transition:background .2s,width .2s,border-radius .2s;}
  .hh-dot.is-active{background:#141414;width:22px;border-radius:5px;}
  .hh-brands{margin-top:22px;}
  .hh-brands span{font-family:var(--font-body--family), sans-serif;font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:#b0aaa0;}
  @media(max-width:899px){
    .hh-inner{padding:34px 22px;min-height:0;gap:10px;}
    .hh-inner--split{grid-template-columns:1fr;min-height:0;padding:0;text-align:center;}
    .hh-inner--split .hh-text{order:2;padding:26px 20px 30px;text-align:center;}
    .hh-inner--split .hh-headline{margin-left:auto;}
    .hh-inner--split .hh-media{order:1;min-height:0;height:340px;}
    .hh-inner--split .hh-media img{position:absolute;inset:0;}
    .hh-inner--split .hh-ctas{justify-content:center;}
    .hh-heading{font-size:clamp(26px,7vw,38px);}
    .hh-sub{font-size:15px;}
    .hh-btn{padding:14px 24px;font-size:11px;}
    .hh-arrow{width:34px;height:34px;font-size:18px;}.hh-arrow--prev{left:6px;}.hh-arrow--next{right:6px;}
    .hh-brands span{font-size:9px;letter-spacing:.12em;}
  }
</style>
<script>
(function(){
  var root=document.getElementById('hh-{{ section.id }}');
  if(!root) return;
  var slides=[].slice.call(root.querySelectorAll('.hh-slide'));
  var dots=[].slice.call(document.querySelectorAll('#shopify-section-{{ section.id }} .hh-dot'));
  if(slides.length<2) return;
  var i=0,timer=null;
  var auto=root.getAttribute('data-autoplay')==='1';
  var speed=parseInt(root.getAttribute('data-speed'),10)||5000;
  function show(n){
    i=(n+slides.length)%slides.length;
    slides.forEach(function(s,x){s.classList.toggle('is-active',x===i);});
    dots.forEach(function(d,x){d.classList.toggle('is-active',x===i);});
  }
  function next(){show(i+1);}
  function start(){if(auto){stop();timer=setInterval(next,speed);}}
  function stop(){if(timer){clearInterval(timer);timer=null;}}
  var pv=root.querySelector('[data-hh-prev]'),nx=root.querySelector('[data-hh-next]');
  if(pv)pv.addEventListener('click',function(){show(i-1);start();});
  if(nx)nx.addEventListener('click',function(){show(i+1);start();});
  dots.forEach(function(d){d.addEventListener('click',function(){show(parseInt(d.getAttribute('data-hh-dot'),10));start();});});
  root.addEventListener('mouseenter',stop);
  root.addEventListener('mouseleave',start);
  start();
})();
</script>
{% schema %}
{
  "name": "Home · Hero",
  "settings": [
    { "type": "color", "id": "bg", "label": "Section background", "default": "#ffffff" },
    { "type": "text", "id": "seo_h1", "label": "SEO H1 (hidden)", "default": "Medical-Grade Skincare & Clinic-Backed Brands at The Skin Bay" },
    { "type": "header", "content": "Slider" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-slide", "default": true },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 12, "step": 1, "unit": "s", "label": "Seconds per slide", "default": 6 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrows", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": true },
    { "type": "text", "id": "brand_strip", "label": "Brand strip (blank = hide)" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product / lifestyle image" },
        { "type": "color", "id": "bg_color", "label": "Slide background colour" },
        { "type": "select", "id": "text_theme", "label": "Text colour", "options": [ { "value": "dark", "label": "Dark (on light bg)" }, { "value": "light", "label": "Light (on dark bg)" } ], "default": "dark" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "headline_image", "label": "Headline banner asset (optional, overrides heading text)" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "cta1_label", "label": "Button 1 label" },
        { "type": "url", "id": "cta1_link", "label": "Button 1 link" },
        { "type": "text", "id": "cta2_label", "label": "Button 2 label" },
        { "type": "url", "id": "cta2_link", "label": "Button 2 link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Home · Hero" }]
}
{% endschema %}
