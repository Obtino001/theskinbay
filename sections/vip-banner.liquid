{% comment %}
  VIP Banner - Premium Layout with FX
{% endcomment %}

<style>
  /* Define Dynamic Variables based on Settings */
  #shopify-section-{{ section.id }} .vip-section-wrapper {
    --bg-color-1: {{ section.settings.bg_color_1 }};
    --bg-color-2: {{ section.settings.bg_color_2 }};
    --text-color: {{ section.settings.text_color }};
    --highlight-color: {{ section.settings.highlight_color }}; /* Gold */
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text_color }};
  }

  /* Section Wrapper with Gradient */
  #shopify-section-{{ section.id }} .vip-section-wrapper {
    background: linear-gradient(135deg, var(--bg-color-1) 0%, var(--bg-color-2) 100%);
    border-top: 4px solid var(--highlight-color);
    padding: 30px 0;
    width: 100%;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  .vip-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    font-family: var(--font-body--family), sans-serif;
    position: relative;
    z-index: 2;
  }

  /* --- 1. Image Column with Glow FX --- */
  .vip-image-col {
    flex: 0 0 auto;
    position: relative;
  }

  /* The subtle glow behind the image */
  .vip-image-col::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, var(--highlight-color) 0%, transparent 70%);
    opacity: 0.2;
    z-index: -1;
    filter: blur(20px);
  }
  
  .vip-image-col img {
    display: block;
    max-height: 140px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 10px 15px rgba(0,0,0,0.3));
    transition: transform 0.3s ease;
  }

  .vip-image-col:hover img {
    transform: scale(1.05) rotate(-2deg);
  }

  /* --- 2. Text Column --- */
  .vip-text-col {
    flex: 1;
    text-align: left;
    color: var(--text-color);
  }

  .vip-headline {
    font-family: var(--font-heading--family), serif;
    font-size: 30px;
    font-weight: 600;
    margin: 0 0 8px 0;
    color: var(--text-color);
    text-transform: none;
    letter-spacing: .2px;
    line-height: 1.15;
  }
  .vip-headline em { font-style: italic; color: var(--highlight-color); }

  /* Specific styling for the headline highlight if needed */
  .vip-headline span {
    color: var(--highlight-color);
  }

  .vip-subtext {
    font-family: var(--font-body--family), sans-serif;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: .2px;
    margin: 0;
    color: var(--text-color);
    opacity: 0.9;
  }

  .vip-subtext p {
    margin: 0;
  }

  /* The "Gold" Bold Text */
  .vip-subtext strong, 
  .vip-subtext b {
    color: var(--highlight-color);
    font-weight: 700;
    text-shadow: 0 0 10px rgba(212, 175, 55, 0.2); /* Subtle light bloom */
  }

  /* --- 3. Button Column with Sheen FX --- */
  .vip-btn-col {
    flex: 0 0 auto;
  }

  .vip-btn {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-body--family), sans-serif;
    padding: 14px 35px;
    text-decoration: none;
    font-weight: 800;
    border-radius: 50px; /* Modern pill shape */
    text-transform: uppercase;
    letter-spacing: .12em;
    display: inline-block;
    font-size: 12px;
    border: 2px solid var(--btn-bg);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    transition: all 0.3s ease;
  }

  /* The "Sheen" Animation */
  .vip-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      120deg, 
      transparent, 
      rgba(255, 255, 255, 0.6), 
      transparent
    );
    transition: none;
    animation: shine 4s infinite linear; 
  }

  @keyframes shine {
    0% { left: -100%; }
    20% { left: 100%; } /* Fast pass */
    100% { left: 100%; } /* Wait */
  }

  .vip-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.4);
    filter: brightness(1.1);
  }

  /* --- Mobile Responsive --- */
  @media (max-width: 749px) {
    .vip-container {
      flex-direction: column;
      text-align: center;
      gap: 20px;
    }

    .vip-text-col {
      text-align: center;
    }

    .vip-image-col::after {
      width: 80%; /* Reduce glow size on mobile */
      height: 80%;
    }

    .vip-image-col img {
      max-height: 130px; 
      margin: 0 auto;
    }
    
    .vip-headline {
      font-size: 20px;
    }

    .vip-btn {
      width: 100%;
      text-align: center;
      max-width: 300px;
    }
  }
</style>

{%- assign is_vip = false -%}
{%- if customer and customer.tags contains 'VIP' -%}{%- assign is_vip = true -%}{%- endif -%}
<div class="vip-section-wrapper">
  <div class="vip-container">

    <!-- 1. The Image -->
    <div class="vip-image-col">
      {% if section.settings.gift_image != blank %}
        <img src="{{ section.settings.gift_image | image_url: width: 400 }}" 
             loading="lazy" 
             alt="VIP Gift Set" 
             width="{{ section.settings.gift_image.width }}" 
             height="{{ section.settings.gift_image.height }}">
      {% else %}
        <!-- Stylized Placeholder -->
        <div style="width: 120px; height: 120px; background: rgba(255,255,255,0.05); border: 2px dashed var(--highlight-color); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: var(--highlight-color); font-weight: bold; font-size: 12px; text-transform: uppercase;">
          Gift Image
        </div>
      {% endif %}
    </div>

    <!-- 2. The Text -->
    <div class="vip-text-col">
      {%- if is_vip -%}
        <h3 class="vip-headline">You're a VIP <em>welcome back{% if customer.first_name != blank %}, {{ customer.first_name }}{% endif %}</em></h3>
        <div class="vip-subtext"><p>Your <strong>unlimited free shipping</strong> is active on every order for the next 12 months. Nothing to do, it applies automatically at checkout.</p></div>
      {%- else -%}
        <h3 class="vip-headline">{{ section.settings.headline }}</h3>
        <div class="vip-subtext">
          {{ section.settings.subtext }}
        </div>
      {%- endif -%}
    </div>

    <!-- 3. The Button -->
    <div class="vip-btn-col">
      {%- if is_vip -%}
        <a href="{{ section.settings.member_link | default: '/a/subscriptions/manage' }}" class="vip-btn">Manage membership</a>
      {%- else -%}
        <a href="{{ section.settings.btn_link | default: '/products/theskinbay-vip-club-exclusive-premium-gift-set?variant=55897805160828' }}" class="vip-btn">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>
{%- if is_vip -%}
<script>
/* Auto-apply VIP free shipping for logged-in members (segment-locked code, applies only for VIPs) */
(function(){
  try{
    if(sessionStorage.getItem('sb_vipship'))return;
    sessionStorage.setItem('sb_vipship','1');
    var f=document.createElement('iframe');
    f.style.cssText='position:absolute;width:0;height:0;border:0;left:-9999px;';
    f.setAttribute('aria-hidden','true'); f.setAttribute('tabindex','-1');
    f.src='/discount/VIPSHIP?redirect=/%3Fvip%3D1';
    document.body.appendChild(f);
    setTimeout(function(){ if(f&&f.parentNode) f.parentNode.removeChild(f); },5000);
  }catch(e){}
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "VIP Banner FX",
  "settings": [
    {
      "type": "header",
      "content": "🎨 Color Customization"
