      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color (Gold)",
      "default": "#d4af37",
      "info": "Used for bold text, borders, and image glow."
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#d4af37"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#0b1c3e"
    },
    {
      "type": "header",
      "content": "🖼️ Content"
    },
    {
      "type": "image_picker",
      "id": "gift_image",
      "label": "Gift Image (PNG recommended)"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Claim Your VIP Status"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Unlock <strong>Unlimited FREE Shipping</strong> for 12 months + get this Premium Gift Set today.</p>",
      "info": "Bold text will automatically use the Highlight Color."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "JOIN & GET FREE SHIPPING"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "url",
      "id": "member_link",
      "label": "VIP member button link (manage membership)",
      "info": "Shown to logged-in VIP members instead of the buy button. Defaults to the subscription portal."
    }
  ],
  "presets": [
    {
      "name": "VIP Banner FX"
    }
  ]
}
{% endschema %}