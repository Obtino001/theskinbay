{%- comment -%} Skin Bay homepage — brand spotlight (Medik8 etc.), matches brand styling {%- endcomment -%}
{%- assign coll = collections[section.settings.collection] -%}
<section class="home-bf" style="background:{{ section.settings.bg }};">
  <div class="bf-wrap">
    <h2 class="bf-hidden">{{ section.settings.brand_name }} at The Skin Bay</h2>
    {%- if section.settings.header_image != blank -%}
      <img class="bf-header" src="{{ section.settings.header_image | asset_url }}" alt="Brand in focus" width="1500" height="340">
    {%- endif -%}
    <div class="bf-lead">
      {%- if section.settings.story != blank -%}<p class="bf-story">{{ section.settings.story }}</p>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}<a class="bf-cta" href="{{ section.settings.cta_link | default: coll.url }}">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
    {%- if coll.products.size > 0 -%}
      <div class="bf-row">
        {%- assign shown = 0 -%}
        {%- for p in coll.products -%}
          {%- if shown < section.settings.count and p.available -%}
            {%- assign pv = p.selected_or_first_available_variant -%}
            <div class="bf-card">
              <a class="bf-clink" href="{{ p.url }}">
                <div class="bf-cimg"><img src="{{ p.featured_image | image_url: width: 420 }}" alt="{{ p.title | escape }}" loading="lazy" width="420" height="420">{% if pv.compare_at_price > pv.price %}<span class="bf-save">Save {{ pv.compare_at_price | minus: pv.price | money_without_trailing_zeros }}</span>{% endif %}</div>
                <span class="bf-title">{{ p.title }}</span>
                <span class="bf-price">{{ pv.price | money }}{% if pv.compare_at_price > pv.price %}<em>{{ pv.compare_at_price | money }}</em>{% endif %}</span>
              </a>
              {%- if pv.available and p.variants.size == 1 -%}
                <button type="button" class="bf-add" data-vid="{{ pv.id }}">Add to bag</button>
              {%- elsif p.available -%}
                <a class="bf-add bf-add--opt" href="{{ p.url }}">Choose options</a>
              {%- else -%}
                <span class="bf-add bf-add--out">Sold out</span>
              {%- endif -%}
            </div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
<style>
  .home-bf{padding:50px 20px;}
  .bf-wrap{max-width:1280px;margin:0 auto;text-align:center;}
  .bf-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
  .bf-header{display:block;width:min(420px,80vw);max-width:none;height:auto;margin:0 auto 6px;}
  .bf-story{font-family:'Lato',sans-serif;font-size:16px;line-height:1.6;color:#4a4a4a;max-width:560px;margin:6px auto 0;}
  .bf-cta{display:inline-flex;align-items:center;margin-top:20px;font-family:'Lato',sans-serif;font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#fff;background:#141414;border-radius:40px;padding:14px 32px;text-decoration:none;transition:background .2s ease,transform .15s ease;}
  .bf-cta:hover{background:#000;transform:translateY(-1px);}
  .bf-row{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(210px,1fr);gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:6px 2px 8px;margin-top:34px;text-align:left;}
  .bf-row::-webkit-scrollbar{display:none;}
  .bf-card{scroll-snap-align:start;display:flex;flex-direction:column;gap:8px;}
  .bf-clink{text-decoration:none;color:#141414;display:flex;flex-direction:column;gap:8px;}
  .bf-cimg{position:relative;background:#fff;border:1px solid #EDEDEA;border-radius:16px;overflow:hidden;aspect-ratio:1/1;}
  .bf-cimg img{width:100%;height:100%;object-fit:contain;display:block;mix-blend-mode:multiply;}
  .bf-save{position:absolute;top:10px;left:10px;background:#141414;color:#fff;font-family:'Lato',sans-serif;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:5px 9px;border-radius:20px;}
  .bf-title{font-family:'Lato',sans-serif;font-size:13.5px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.7em;padding:0 2px;}
  .bf-price{font-family:'Playfair Display',serif;font-size:16px;color:#141414;padding:0 2px;}
  .bf-price em{font-style:normal;font-size:13px;color:#a29b8f;text-decoration:line-through;margin-left:6px;}
  .bf-add{margin-top:2px;font-family:'Lato',sans-serif;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;text-align:center;color:#141414;background:#fff;border:1.5px solid #141414;border-radius:40px;padding:11px 12px;cursor:pointer;text-decoration:none;transition:background .2s ease,color .2s ease;}
  .bf-add:hover{background:#141414;color:#fff;}
  .bf-add.is-added{background:#141414;color:#fff;border-color:#141414;}
  .bf-add--opt{border-color:rgba(20,20,20,.35);}
  .bf-add--out{border-color:#e2e2e2;color:#b0aaa0;cursor:default;background:#fafafa;}
  .bf-add--out:hover{background:#fafafa;color:#b0aaa0;}
  @media(max-width:749px){.home-bf{padding:36px 14px;}.bf-row{grid-auto-columns:minmax(158px,1fr);gap:12px;}.bf-add{font-size:10px;padding:10px 8px;}}
</style>
<script>
(function(){
  var sec=document.getElementById('shopify-section-{{ section.id }}');
  if(!sec) return;
  sec.querySelectorAll('.bf-add[data-vid]').forEach(function(btn){
    btn.addEventListener('click',function(){
      if(btn.dataset.busy) return; btn.dataset.busy='1';
      var orig=btn.textContent; btn.textContent='Adding…';
      fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:parseInt(btn.getAttribute('data-vid'),10),quantity:1}]})})
      .then(function(r){if(!r.ok)throw 0;return r.json();})
      .then(function(){
        btn.textContent='Added ✓'; btn.classList.add('is-added');
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        document.dispatchEvent(new CustomEvent('cart:build'));
        return fetch('/cart.js').then(function(x){return x.json();});
      })
      .then(function(c){
        if(c&&typeof c.item_count!=='undefined'){
          document.querySelectorAll('.cart-count-bubble span:not([aria-hidden]),[data-cart-count],.cart-count,.header__cart-count').forEach(function(e){e.textContent=c.item_count;});
        }
        setTimeout(function(){btn.textContent=orig;btn.classList.remove('is-added');btn.dataset.busy='';},1900);
      })
      .catch(function(){window.location='/cart';});
    });
  });
})();
</script>
{% schema %}
{
  "name": "Home · Brand spotlight",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F7F7F5" },
    { "type": "text", "id": "header_image", "label": "Header banner asset", "default": "home-h-spotlight.png" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Medik8" },
    { "type": "textarea", "id": "story", "label": "Brand story", "default": "British skincare science, powered by vitamin A. Medik8's CSA philosophy pairs daily antioxidants and sunscreen with nightly retinal for visibly firmer, brighter, healthier skin." },
    { "type": "collection", "id": "collection", "label": "Brand collection" },
    { "type": "range", "id": "count", "min": 4, "max": 12, "step": 1, "label": "Products", "default": 8 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop all Medik8" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Home · Brand spotlight" }]
}
{% endschema %}
