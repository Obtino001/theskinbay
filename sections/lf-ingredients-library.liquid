{{ 'lf-ingredients.css' | asset_url | stylesheet_tag }}

<section class="lf-ing-hero" aria-label="Ingredients Library hero">
  <div class="lf-ing-hero__inner">
    <p class="lf-ing-hero__eyebrow">{{ section.settings.eyebrow | default: 'The Skin Bay' }}</p>
    <h1 class="lf-ing-hero__title">{{ section.settings.heading | default: 'Ingredients Library' }}</h1>
    <p class="lf-ing-hero__sub">{{ section.settings.subheading | default: 'Evidence-based guidance on every ingredient in your skincare routine' }}</p>

    <div class="lf-ing-search-wrap" id="lf-ing-search-wrap" role="search" aria-label="Search ingredients">
      <svg class="lf-ing-search-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input
        id="lf-ing-search-input"
        class="lf-ing-search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="Search an ingredient, e.g. Niacinamide&hellip;"
        aria-label="Search ingredients"
        aria-autocomplete="list"
        aria-controls="lf-ing-autocomplete"
        aria-expanded="false"
      >
      <button id="lf-ing-search-clear" class="lf-ing-search-clear" aria-label="Clear search" hidden>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <ul id="lf-ing-autocomplete" class="lf-ing-autocomplete" role="listbox" aria-label="Ingredient suggestions" hidden></ul>
    </div>
  </div>
</section>

<div class="lf-ing-stats" aria-label="Library statistics">
  <div class="lf-ing-stats__inner">
    <div class="lf-ing-stats__item">
      <span class="lf-ing-stats__num" id="lf-ing-stat-total">25</span>
      <span class="lf-ing-stats__label">Ingredients</span>
    </div>
    <div class="lf-ing-stats__divider" aria-hidden="true"></div>
    <div class="lf-ing-stats__item">
      <span class="lf-ing-stats__num">8</span>
      <span class="lf-ing-stats__label">Categories</span>
    </div>
    <div class="lf-ing-stats__divider" aria-hidden="true"></div>
    <div class="lf-ing-stats__item">
      <span class="lf-ing-stats__num">3</span>
      <span class="lf-ing-stats__label">Safety Ratings</span>
    </div>
    <div class="lf-ing-stats__divider" aria-hidden="true"></div>
    <div class="lf-ing-stats__item">
      <span class="lf-ing-stats__num">100%</span>
      <span class="lf-ing-stats__label">Evidence-Based</span>
    </div>
  </div>
</div>

<div class="lf-ing-filters-bar" id="lf-ing-filters-bar" role="navigation" aria-label="Filter ingredients">
  <div class="lf-ing-filters-bar__inner">
    <div class="lf-ing-filter-pills" id="lf-ing-filter-pills" role="group" aria-label="Filter by category or safety">
      <!-- Populated by JS -->
    </div>
    <button class="lf-ing-clear-filters" id="lf-ing-clear-filters" aria-label="Clear all filters" hidden>
      Clear filters
      <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
</div>

<div class="lf-ing-main" id="lf-ing-main">
  <aside class="lf-ing-az-sidebar" aria-label="Alphabetical navigation">
    <nav id="lf-ing-az" class="lf-ing-az" aria-label="Jump to letter">
      <!-- Populated by JS -->
    </nav>
  </aside>

  <div class="lf-ing-body">
    <div class="lf-ing-results-bar" id="lf-ing-results-bar" aria-live="polite" aria-atomic="true">
      <span id="lf-ing-count" class="lf-ing-count"></span>
    </div>

    <div id="lf-ing-content" class="lf-ing-content" role="list" aria-label="Ingredient cards">
      <!-- Populated by JS -->
    </div>

    <div id="lf-ing-empty" class="lf-ing-empty" hidden aria-live="polite">
      <div class="lf-ing-empty__icon" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </div>
      <p class="lf-ing-empty__title">No ingredients found</p>
      <p class="lf-ing-empty__sub">Try a different search term or clear your filters.</p>
      <button class="lf-ing-empty__reset" id="lf-ing-empty-reset">Reset search</button>
    </div>
  </div>
</div>

{%- comment -%} Modal {%- endcomment -%}
<div id="lf-ing-backdrop" class="lf-ing-backdrop" aria-hidden="true" role="presentation"></div>

<div
  id="lf-ing-drawer"
  class="lf-ing-drawer"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lf-ing-drawer-title"
  aria-hidden="true"
  tabindex="-1"
>
  <div class="lf-ing-drawer__header">
    <button id="lf-ing-drawer-close" class="lf-ing-drawer__close" aria-label="Close ingredient details">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      <span class="lf-ing-drawer__close-label">Close</span>
    </button>
  </div>
  <div id="lf-ing-drawer-body" class="lf-ing-drawer__body">
    <!-- Populated by JS when a card is opened -->
  </div>
</div>

<script src="{{ 'lf-ingredients.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ingredients Library",
  "tag": "div",
  "class": "lf-ingredients-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The Skin Bay"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients Library"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Evidence-based guidance on every ingredient in your skincare routine"
    }
  ],
  "presets": [
    {
      "name": "Ingredients Library"
    }
  ]
}
{% endschema %}
