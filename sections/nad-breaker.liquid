{%- comment -%} NAD bespoke, illustration breaker/divider (brand motif) {%- endcomment -%}
<section class="nad-brk" style="background:{{ section.settings.bg }};">
  <div class="nadbrk-wrap">
    <img class="nadbrk-ill nadbrk-ill--{{ section.settings.colour }}" src="{{ 'nad-illustration.png' | asset_url }}" alt="" role="presentation" loading="lazy" width="1100" height="328">
  </div>
</section>
<style>
  .nad-brk{padding:14px 20px;overflow:hidden;}
  .nadbrk-wrap{max-width:1100px;margin:0 auto;text-align:center;}
  .nadbrk-ill{width:min(720px,84%);height:auto;display:inline-block;}
  .nadbrk-ill--black{filter:brightness(0);}
  .nadbrk-ill--white{filter:brightness(0) invert(1);}
  @media(max-width:749px){.nadbrk-ill{width:90%;}}
</style>
{% schema %}
{
  "name": "NAD · Breaker",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6C21A" },
    { "type": "select", "id": "colour", "label": "Illustration colour", "default": "black",
      "options": [{"value":"black","label":"Black"},{"value":"white","label":"White"}] }
  ],
  "presets": [{ "name": "NAD · Breaker" }]
}
{% endschema %}
