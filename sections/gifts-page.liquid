{%- comment -%} Gifts page, editor-managed gift offers with hover/tap flip to reveal the offer {%- endcomment -%}
<section class="gp" data-section-id="{{ section.id }}">

  <div class="gp-hero">
    <div class="gp-hero-inner">
      {%- if section.settings.header_image != blank -%}
        <img class="gp-banner" src="{{ section.settings.header_image | asset_url }}" alt="{{ section.settings.heading | default: 'Gifts & Rewards' | strip_html | escape }}">
        <h1 class="gp-title-h gp-vh">{{ section.settings.heading | default: 'Gifts & Rewards' }}</h1>
      {%- else -%}
        <p class="gp-eyebrow">{{ section.settings.eyebrow | default: 'Complimentary' }}</p>
        <h1 class="gp-title-h">{{ section.settings.heading | default: 'Gifts & Rewards' }}</h1>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}<p class="gp-lede">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
  </div>

  {%- if section.settings.founder_quote != blank -%}
  <div class="gp-founder">
    <div class="gp-founder-inner">
      <img class="gp-founder-photo" src="{{ 'email-founder-emmalee.jpg' | asset_url }}" alt="Emmalee Fitton, Founder of The Skin Bay" width="120" height="120" loading="lazy">
      <div class="gp-founder-body">
        <p class="gp-founder-kicker">A Note From Our Founder</p>
        <p class="gp-founder-quote">{{ section.settings.founder_quote }}</p>
        <p class="gp-founder-name">Emmalee</p>
      </div>
    </div>
  </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="gp-grid">
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image -%}
        <div class="gp-card" data-gift {{ block.shopify_attributes }}>
          <div class="gp-front">
            {%- if img != blank -%}<img src="{{ img | image_url: width: 700 }}" alt="{{ block.settings.title | escape | default: 'Gift offer' }}" loading="lazy">
            {%- elsif block.settings.image_url != blank -%}<img src="{{ block.settings.image_url }}" alt="{{ block.settings.title | escape | default: 'Gift offer' }}" loading="lazy">
            {%- else -%}<div class="gp-front-ph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M20 12v10H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg></div>{%- endif -%}
          </div>
          <div class="gp-back">
            {%- if block.settings.title != blank -%}<span class="gp-card-title">{{ block.settings.title }}</span>{%- endif -%}
            <span class="gp-offer">{{ block.settings.offer | default: 'Add your offer text in the editor.' }}</span>
            {%- if block.settings.link != blank -%}<a class="gp-shop" href="{{ block.settings.link }}">Shop &#8250;</a>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- comment -%} Live feed the PDP reads so its gift box always matches this page {%- endcomment -%}
    <script type="application/json" id="tsb-gift-offers">[
      {%- for block in section.blocks -%}
        {%- assign _lk = block.settings.link -%}
        {%- assign _coll = '' -%}{%- assign _prod = '' -%}{%- assign _url = _lk -%}
        {%- if _lk contains '/collections/' -%}{%- assign _coll = _lk | split: '/collections/' | last | split: '?' | first -%}{%- assign _url = '/collections/' | append: _coll -%}
        {%- elsif _lk contains '/products/' -%}{%- assign _prod = _lk | split: '/products/' | last | split: '?' | first -%}{%- assign _url = '/products/' | append: _prod -%}{%- endif -%}
        {%- unless forloop.first -%},{%- endunless -%}{"title":{{ block.settings.title | default: '' | json }},"offer":{{ block.settings.offer | default: '' | json }},"collection":{{ _coll | json }},"product":{{ _prod | json }},"url":{{ _url | json }}}
      {%- endfor -%}
    ]</script>
  {%- else -%}
    <p class="gp-empty">Add gift offers in the theme editor to populate this page.</p>
  {%- endif -%}

</section>

<style>
  .gp{background:#fff;color:#141414;}
  .gp-hero{background:#141414;text-align:center;padding:56px 24px 40px;}
  .gp-hero-inner{max-width:680px;margin:0 auto;}
  .gp-eyebrow{font-family:var(--font-body--family), sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:12px;color:#c9bfae;margin:0 0 10px;}
  .gp-title-h{font-family:var(--font-heading--family), serif;font-weight:500;font-size:clamp(34px,5vw,54px);line-height:1.05;margin:0 0 12px;color:#fff;}
  .gp-banner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 14px;}
  .gp-vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
  .gp-lede{font-family:var(--font-body--family), sans-serif;font-size:16px;line-height:1.6;color:rgba(255,255,255,.72);max-width:560px;margin:0 auto;}
  /* founder note */
  .gp-founder{padding:26px 22px;}
  .gp-founder-inner{max-width:880px;margin:0 auto;display:flex;gap:22px;align-items:center;}
  .gp-founder-photo{width:104px;height:104px;border-radius:50%;object-fit:cover;flex:0 0 auto;box-shadow:0 4px 16px rgba(0,0,0,.1);}
  .gp-founder-kicker{font-family:var(--font-body--family), sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:11px;color:#8a8377;margin:0 0 8px;}
  .gp-founder-quote{font-family:var(--font-body--family), sans-serif;font-style:italic;font-size:15.5px;line-height:1.62;color:#413d36;margin:0 0 10px;max-width:640px;}
  .gp-founder-name{font-family:var(--font-heading--family), serif;font-weight:700;font-size:20px;color:#141414;margin:0;}
  /* grid */
  .gp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:1200px;margin:0 auto;padding:20px 24px 76px;}
  .gp-card{position:relative;aspect-ratio:1/1;border-radius:8px;overflow:hidden;border:1px solid #ece7df;cursor:pointer;}
  .gp-front,.gp-back{position:absolute;inset:0;transition:opacity .45s ease;}
  .gp-front{background:#fff;}
  .gp-front img{width:100%;height:100%;object-fit:cover;display:block;}
  .gp-front-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#f5f1ea;}
  .gp-front-ph svg{width:56px;height:56px;color:#cabfad;}
  .gp-back{background:#F9F3ED;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;opacity:0;}
  .gp-card:hover .gp-front,.gp-card.is-flipped .gp-front{opacity:0;}
  .gp-card:hover .gp-back,.gp-card.is-flipped .gp-back{opacity:1;}
  .gp-card-title{font-family:var(--font-body--family), sans-serif;text-transform:uppercase;letter-spacing:.16em;font-size:10px;color:#8a8377;margin-bottom:10px;}
  .gp-offer{font-family:var(--font-heading--family), serif;font-size:clamp(15px,1.5vw,21px);line-height:1.25;color:#141414;}
  .gp-shop{margin-top:16px;font-family:var(--font-body--family), sans-serif;text-transform:uppercase;letter-spacing:.12em;font-size:11px;text-decoration:none;color:#141414;border-bottom:1px solid #141414;padding-bottom:2px;}
  .gp-empty{text-align:center;font-family:var(--font-body--family), sans-serif;color:#8a8377;font-style:italic;padding:40px 24px 72px;}
  @media (max-width:749px){
    .gp-grid{grid-template-columns:repeat(2,1fr);gap:12px;padding:16px 16px 56px;}
    .gp-founder-inner{flex-direction:column;text-align:center;gap:16px;}
    .gp-offer{font-size:15px;}
  }
</style>

<script>
  (function(){
    var root=document.querySelector('.gp[data-section-id="{{ section.id }}"]');
    if(!root){return;}
    root.querySelectorAll('[data-gift]').forEach(function(card){
      card.addEventListener('click',function(e){
        if(e.target.closest('.gp-shop')){return;}
        card.classList.toggle('is-flipped');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Gifts Page",
  "settings": [
    { "type": "text", "id": "header_image", "label": "Header banner asset (brand-font PNG)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Complimentary" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gifts & Rewards" },
    { "type": "text", "id": "lede", "label": "Intro line (optional)" },
    { "type": "textarea", "id": "founder_quote", "label": "Founder note (leave blank to hide)", "default": "We want to reward our loyal customers by giving back to them. These gifts are a thank you for shopping with The Skin Bay, and a great opportunity to introduce you to new brands and fabulous new products." }
  ],
  "blocks": [
    {
      "type": "gift",
      "name": "Gift offer",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Gift image" },
        { "type": "text", "id": "image_url", "label": "Or paste image URL" },
        { "type": "text", "id": "title", "label": "Gift name (optional, small label)" },
        { "type": "textarea", "id": "offer", "label": "Offer text (shown on hover / tap)" },
        { "type": "url", "id": "link", "label": "Shop link (optional)" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [{ "name": "Gifts Page", "blocks": [ { "type": "gift" }, { "type": "gift" }, { "type": "gift" }, { "type": "gift" } ] }]
}
{% endschema %}
