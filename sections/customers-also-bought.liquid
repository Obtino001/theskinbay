{%- style -%}
  .recommendations-section {
    padding: 40px 0; /* Removed side padding to let carousel hit edges */
    max-width: 1200px;
    margin: 0 auto;
    font-family: inherit;
    overflow: hidden;
  }

  .recommendations-title {
    text-align: center;
    text-transform: uppercase;
    font-size: 20px;
    letter-spacing: 1.5px;
    margin-bottom: 30px;
    color: #000;
    padding: 0 20px;
  }

  /* DESKTOP GRID */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 0 20px;
  }

  /* MOBILE CAROUSEL FIXED */
  @media screen and (max-width: 749px) {
    .product-grid {
      display: flex;
      grid-template-columns: none; /* Disable grid on mobile */
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 12px;
      padding: 0 20px 20px 20px; /* Bottom padding for scrollbar room */
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none; /* Hide scrollbar for Firefox */
    }

    .product-grid::-webkit-scrollbar {
      display: none; /* Hide scrollbar for Chrome/Safari */
    }

    .product-card {
      flex: 0 0 calc(50% - 6px); /* Shows exactly 2 products */
      scroll-snap-align: start;
    }
  }

  .product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .product-card__image-wrapper {
    background-color: #f6f6f6;
    margin-bottom: 12px;
    position: relative;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .product-card__image-wrapper img {
    max-width: 85%;
    max-height: 85%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .product-card__title {
    font-size: 14px;
    line-height: 1.3;
    margin: 0 0 6px 0;
    color: #333;
    font-weight: 400;
    /* Limit to 2 lines to keep buttons aligned */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 36px; 
  }

  .product-card__price {
    margin-bottom: 12px;
    font-size: 15px;
    font-weight: 700;
  }

  .quick-buy-button {
    border: 1px solid #000;
    background: #fff;
    color: #000;
    text-transform: uppercase;
    padding: 10px 5px;
    font-size: 12px;
    cursor: pointer;
    width: 100%;
    letter-spacing: 1px;
    transition: 0.2s;
  }

  .quick-buy-button:hover {
    background: #000;
    color: #fff;
  }
{%- endstyle -%}

<div class="recommendations-section">
  <h2 class="recommendations-title">{{ section.settings.heading }}</h2>

  <div class="product-grid">
    {%- assign recommendation_collection = collections[section.settings.collection] -%}
    {%- for product in recommendation_collection.products limit: section.settings.products_to_show -%}
      <div class="product-card">
        <a href="{{ product.url }}" class="product-card__image-wrapper">
          <img
            src="{{ product.featured_image | image_url: width: 500 }}"
            alt="{{ product.featured_image.alt | escape }}"
            loading="lazy"
            width="500"
          >
        </a>

        <h3 class="product-card__title">
          <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">{{ product.title }}</a>
        </h3>

        <div class="product-card__price">
          {{ product.price | money }}
        </div>

        <form method="post" action="/cart/add">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
          <button type="submit" class="quick-buy-button">Quick Buy</button>
        </form>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
document.querySelectorAll('.quick-buy-button').forEach(function(btn) {
  var form = btn.closest('form[action="/cart/add"]');
  if (!form) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var variantId = form.querySelector('input[name="id"]').value;
    if (!variantId) return;

    btn.disabled = true;
    btn.textContent = 'ADDED';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: parseInt(variantId, 10), quantity: 1 })
    })
    .then(function(r) {
      if (!r.ok) throw new Error('cart add failed');
      return r.json();
    })
    .then(function() {
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      setTimeout(function() {
        btn.disabled = false;
        btn.textContent = 'Quick Buy';
      }, 2000);
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = 'Quick Buy';
      form.submit();
    });
  });
});
</script>

{% schema %}
{
  "name": "Customers Also Bought",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CUSTOMERS ALSO BOUGHT:"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Total products to show"
    }
  ],
  "presets": [
    {
      "name": "Customers Also Bought"
    }
  ]
}
{% endschema %}