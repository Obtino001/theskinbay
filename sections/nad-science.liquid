{%- comment -%} NAD bespoke, the science (renders custom.description_accordion metafield) {%- endcomment -%}
<section class="nad-science" style="background:{{ section.settings.bg }};">
  <div class="nadsc-wrap">
    <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;padding:0;margin:-1px;border:0;">The science of NAD+</h2>
    <img class="nad-header-img" src="{{ section.settings.header_image | default: 'nad-h-science.png' | asset_url }}" alt="The science explained" loading="lazy" width="1500" height="340">
    <div class="nadsc-body"><div class="nad-exp"><div class="nad-exp-in">{%- if section.settings.use_metafield and product.metafields.custom.description_accordion != blank -%}{% render 'phc-richtext', rt: product.metafields.custom.description_accordion.value %}{%- elsif section.settings.use_metafield and product.description != blank -%}{{ product.description }}{%- else -%}{{ section.settings.body }}{%- endif -%}</div><button type="button" class="nad-exp-btn" onclick="nadExp(this)"><span>Read more</span> <b>+</b></button></div></div>
    {%- if section.settings.insight != blank -%}
      <figure class="nadsc-insight">
        <span class="nadsc-tag">Scientific insight</span>
        <blockquote>{{ section.settings.insight }}</blockquote>
      </figure>
    {%- endif -%}
  </div>
</section>
<style>
  .nad-science{padding:56px 20px;}
  .nadsc-wrap{max-width:820px;margin:0 auto;}
  .nad-science .nad-header-img{max-width:560px;margin-bottom:22px;}
  .nadsc-body{font-family:var(--font-body--family), sans-serif;color:#141414;font-size:16px;line-height:1.75;background:var(--box,#FBF6EA);border:1px solid var(--boxline,#ECE3CE);border-radius:22px;padding:34px 38px;}
  .nadsc-body p{margin:0 0 16px;}
  .nadsc-body p:last-child{margin-bottom:0;}
  .nadsc-body strong{color:#141414;}
  .nadsc-body h1,.nadsc-body h2,.nadsc-body h3,.nadsc-body h4,.nadsc-body h5{font-family:var(--font-heading--family), serif;color:#141414;margin:26px 0 10px;font-weight:700;}
  .nadsc-insight{margin:34px 0 0;background:var(--card,#10233B);color:#f4f0e6;border-radius:16px;padding:32px 34px;position:relative;overflow:hidden;}
  .nadsc-insight:before{content:"";position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--accent2,#F6C21A);}
  .nadsc-tag{display:inline-block;font-family:var(--font-body--family), sans-serif;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent2,#F6C21A);margin-bottom:12px;}
  .nadsc-insight blockquote{margin:0;font-family:var(--font-heading--family), serif;font-size:20px;line-height:1.5;}
  @media(max-width:749px){.nad-science{padding:38px 16px;}.nadsc-body{font-size:15.5px;}.nadsc-insight{padding:24px 22px;}.nadsc-insight blockquote{font-size:18px;}}
</style>
{% schema %}
{
  "name": "NAD · Science",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6C21A" },
    { "type": "text", "id": "header_image", "label": "Header image file (blank = default)" },
    { "type": "checkbox", "id": "use_metafield", "label": "Use product description metafield", "default": false },
    { "type": "richtext", "id": "body", "label": "Science narrative", "default": "<p><strong>Nicotinamide Adenine Dinucleotide (NAD+)</strong> is a vital coenzyme found in every living cell, responsible for driving energy metabolism, DNA repair and cellular communication. As we age, NAD+ levels naturally decline, leading to fatigue, slower recovery and visible signs of ageing.</p><p>Replenishing NAD+ reawakens cellular vitality and supports healthy metabolic function. Delivered subcutaneously, it bypasses the digestive system for exceptional absorption, so your cells can begin using it almost immediately.</p>" },
    { "type": "textarea", "id": "insight", "label": "Scientific insight pull-quote", "default": "NAD+ powers the sirtuin and PARP enzymes that regulate cellular repair, inflammation and gene expression. Raising NAD+ availability has been shown to mimic the effects of caloric restriction, extending cellular lifespan and improving metabolic resilience." }
  ],
  "presets": [{ "name": "NAD · Science" }]
}
{% endschema %}
