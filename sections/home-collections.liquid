{%- comment -%} Skin Bay homepage — shop most popular collections slider {%- endcomment -%}
{%- assign cards = section.blocks | where: 'type', 'collection_card' -%}
<section class="home-cols" style="background:{{ section.settings.bg }};">
  <div class="hc-head">
    <h2 class="hc-hidden">{{ section.settings.heading }}</h2>
    {%- if section.settings.header_image != blank -%}
      <img class="hc-banner" src="{{ section.settings.header_image | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1500" height="340">
    {%- else -%}
      <span class="hc-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="hc-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="hc-carousel">
    <button type="button" class="hc-arrow hc-arrow--prev" aria-label="Scroll left" data-hc-prev>&#8249;</button>
    <div class="hc-viewport" id="hc-vp-{{ section.id }}">
      <div class="hc-strip">
        {%- if cards.size > 0 -%}
          {%- for block in cards -%}
            {%- assign _c = collections[block.settings.collection] -%}
            {%- assign _label = block.settings.label | default: _c.title | default: 'Collection' -%}
            {%- assign _href = block.settings.link | default: _c.url | default: '/collections/all' -%}
            <a href="{{ _href }}" class="hc-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 640 }}" alt="{{ _label | escape }}" class="hc-img" loading="lazy">
              {%- elsif _c.image != blank -%}
                <img src="{{ _c.image | image_url: width: 640 }}" alt="{{ _label | escape }}" class="hc-img" loading="lazy">
              {%- elsif _c.products.first.featured_image != blank -%}
                <img src="{{ _c.products.first.featured_image | image_url: width: 640 }}" alt="{{ _label | escape }}" class="hc-img" loading="lazy">
              {%- else -%}
                <div class="hc-ph"></div>
              {%- endif -%}
              <div class="hc-overlay"></div>
              <div class="hc-label"><span class="hc-name">{{ _label }}</span><span class="hc-shop">Shop &rarr;</span></div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- assign _fb = 'best-sellers|Bestsellers,skinceuticals|SkinCeuticals,cliniccare|ClinicCare,medik8|Medik8,facial-serums|Serums,facial-moisturisers|Moisturisers,gifts|Gift Sets,sale|Offers' | split: ',' -%}
          {%- for e in _fb -%}
            {%- assign p = e | split: '|' -%}
            {%- assign h = p[0] -%}{%- assign l = p[1] -%}{%- assign col = collections[h] -%}
            <a href="/collections/{{ h }}" class="hc-card">
              {%- if col.image != blank -%}
                <img src="{{ col.image | image_url: width: 640 }}" alt="{{ l | escape }}" class="hc-img" loading="lazy">
              {%- elsif col.products.first.featured_image != blank -%}
                <img src="{{ col.products.first.featured_image | image_url: width: 640 }}" alt="{{ l | escape }}" class="hc-img" loading="lazy">
              {%- else -%}
                <div class="hc-ph"></div>
              {%- endif -%}
              <div class="hc-overlay"></div>
              <div class="hc-label"><span class="hc-name">{{ l }}</span><span class="hc-shop">Shop &rarr;</span></div>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <button type="button" class="hc-arrow hc-arrow--next" aria-label="Scroll right" data-hc-next>&#8250;</button>
  </div>
</section>
<style>
  .home-cols{padding:14px 20px 46px;}
  .hc-head{max-width:1280px;margin:0 auto;text-align:center;}
  .hc-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
  .hc-banner{display:block;width:min(420px,80vw);max-width:none;height:auto;margin:0 auto 4px;}
  .hc-eyebrow{display:block;font-family:'Lato',sans-serif;font-size:12px;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:#8a857c;}
  .hc-sub{font-family:'Lato',sans-serif;font-size:15px;line-height:1.5;color:#6a6a6a;margin:2px auto 0;max-width:520px;}
  .hc-carousel{position:relative;max-width:1320px;margin:22px auto 0;}
  .hc-viewport{overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;cursor:grab;scrollbar-width:none;scroll-behavior:smooth;-webkit-overflow-scrolling:touch;}
  .hc-viewport::-webkit-scrollbar{display:none;}
  .hc-viewport:active{cursor:grabbing;}
  .hc-strip{display:flex;gap:14px;padding:4px 2px;}
  .hc-card{flex:0 0 210px;position:relative;display:block;overflow:hidden;aspect-ratio:4/5;border-radius:16px;scroll-snap-align:start;text-decoration:none;background:#1c1c1c;}
  .hc-img{width:100%;height:100%;object-fit:cover;object-position:center;display:block;transition:transform .7s cubic-bezier(.25,.46,.45,.94);}
  .hc-card:hover .hc-img{transform:scale(1.06);}
  .hc-ph{position:absolute;inset:0;background:linear-gradient(160deg,#2a2320,#4a3d33);}
  .hc-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.62) 0%,rgba(0,0,0,.12) 55%,rgba(0,0,0,0) 100%);}
  .hc-label{position:absolute;left:0;right:0;bottom:0;padding:16px 16px 18px;display:flex;flex-direction:column;gap:4px;z-index:2;}
  .hc-name{font-family:'Lato',sans-serif;font-size:14px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.4);}
  .hc-shop{font-family:'Lato',sans-serif;font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,0);transition:color .3s;}
  .hc-card:hover .hc-shop{color:rgba(255,255,255,.85);}
  .hc-arrow{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:42px;height:42px;border-radius:50%;border:1.5px solid rgba(20,20,20,.14);background:#fff;color:#141414;font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,0,0,.1);transition:background .2s,color .2s;}
  .hc-arrow:hover{background:#141414;color:#fff;}
  .hc-arrow--prev{left:-10px;}.hc-arrow--next{right:-10px;}
  @media(max-width:749px){.home-cols{padding:8px 12px 34px;}.hc-banner{}.hc-card{flex:0 0 150px;border-radius:14px;}.hc-strip{gap:10px;}.hc-arrow{display:none;}}
</style>
<script>
(function(){
  var vp=document.getElementById('hc-vp-{{ section.id }}');
  if(!vp) return;
  var wrap=vp.closest('.hc-carousel');
  var down=false,sx=0,sl=0,moved=false;
  vp.addEventListener('mousedown',function(e){down=true;moved=false;sx=e.pageX-vp.offsetLeft;sl=vp.scrollLeft;});
  vp.addEventListener('mouseleave',function(){down=false;});
  vp.addEventListener('mouseup',function(){down=false;});
  vp.addEventListener('mousemove',function(e){if(!down)return;e.preventDefault();moved=true;vp.scrollLeft=sl-(e.pageX-vp.offsetLeft-sx)*1.4;});
  vp.addEventListener('click',function(e){if(moved){e.preventDefault();}},true);
  function step(){return (vp.querySelector('.hc-card')||{}).offsetWidth ? vp.querySelector('.hc-card').offsetWidth*2+28 : 400;}
  var pv=wrap.querySelector('[data-hc-prev]'),nx=wrap.querySelector('[data-hc-next]');
  if(pv)pv.addEventListener('click',function(){vp.scrollBy({left:-step(),behavior:'smooth'});});
  if(nx)nx.addEventListener('click',function(){vp.scrollBy({left:step(),behavior:'smooth'});});
})();
</script>
{% schema %}
{
  "name": "Home · Collection slider",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "text", "id": "header_image", "label": "Header banner asset (blank = text)", "default": "home-h-shop.png" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (if no banner)", "default": "Most loved" },
    { "type": "text", "id": "heading", "label": "Heading (SEO / alt)", "default": "Shop our most popular collections" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Jump straight to the edits our customers reach for most." }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label override (optional)" },
        { "type": "image_picker", "id": "image", "label": "Image override (optional)" },
        { "type": "url", "id": "link", "label": "Link override (optional)" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Home · Collection slider" }]
}
{% endschema %}
