{%- liquid
  assign selected_product = closest.product
  assign product_media_size = selected_product.media.size

  assign product_grid_class = 'product-information__grid'
  if product_media_size == 0
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif section.settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  case section.settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
    else
      assign content_width = 'page-width'
  endcase

  assign _pv_s = selected_product.vendor | downcase
  assign _priv_b      = nil
  assign _priv_titles = nil
  assign _priv_spends = nil
  if _pv_s contains 'skinceuticals'
    assign _priv_b      = 'SkinCeuticals'
    assign _priv_titles = 'Complimentary SkinCeuticals Gift|Gift Worth £95'
    assign _priv_spends = '£150|£400'
  elsif _pv_s contains 'medik8' or _pv_s contains 'medik 8'
    assign _priv_b      = 'Medik8'
    assign _priv_titles = 'Complimentary Medik8 Gift'
    assign _priv_spends = '£100'
  elsif _pv_s contains 'cliniccare'
    assign _priv_b      = 'Cliniccare'
    assign _priv_titles = 'Complimentary Cliniccare Gift'
    assign _priv_spends = '£200'
  endif
-%}

{%- render 'breadcrumbs' -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<div
  class="product-information section section--{{ content_width }} color-{{ section.settings.color_scheme }}"
  data-testid="product-information"
>
  <h1 class="visually-hidden">{{ selected_product.title }}</h1>
  <div class="{{ product_grid_class }}">
    {%- assign _rev_sku = selected_product.selected_or_first_available_variant.sku -%}
    {%- if _rev_sku == blank -%}{%- assign _rev_sku = selected_product.handle -%}{%- endif -%}
    {%- if section.settings.desktop_media_position == 'right' -%}
      <div class="product-details-wrapper">
        {%- content_for 'block', id: 'product-details', type: '_product-details' -%}
      </div>
      {%- if product_media_size > 0 -%}
        <div class="product-information__media lf-media-col">
          {%- content_for 'block', id: 'media-gallery', type: '_product-media-gallery' -%}
          {%- assign _sv = selected_product.selected_or_first_available_variant -%}
          {%- if _sv.compare_at_price > _sv.price -%}
            {%- assign _save_pct = _sv.compare_at_price | minus: _sv.price | times: 100.0 | divided_by: _sv.compare_at_price | round -%}
            <div class="lf-save-badge" data-product-id="{{ selected_product.id }}">Save {{ _sv.compare_at_price | minus: _sv.price | money }} · {{ _save_pct }}% OFF</div>
          {%- else -%}
            <div class="lf-save-badge lf-save-badge--hidden" data-product-id="{{ selected_product.id }}"></div>
          {%- endif -%}
          {%- render 'lf-pdp-left-extras', priv_b: _priv_b, priv_titles: _priv_titles, priv_spends: _priv_spends -%}
          {%- render 'lf-pdp-extra-media', product: selected_product -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {%- if product_media_size > 0 -%}
        <div class="product-information__media lf-media-col">
          {%- content_for 'block', id: 'media-gallery', type: '_product-media-gallery' -%}
          {%- assign _sv = selected_product.selected_or_first_available_variant -%}
          {%- if _sv.compare_at_price > _sv.price -%}
            {%- assign _save_pct = _sv.compare_at_price | minus: _sv.price | times: 100.0 | divided_by: _sv.compare_at_price | round -%}
            <div class="lf-save-badge" data-product-id="{{ selected_product.id }}">Save {{ _sv.compare_at_price | minus: _sv.price | money }} · {{ _save_pct }}% OFF</div>
          {%- else -%}
            <div class="lf-save-badge lf-save-badge--hidden" data-product-id="{{ selected_product.id }}"></div>
          {%- endif -%}
          {%- render 'lf-pdp-left-extras', priv_b: _priv_b, priv_titles: _priv_titles, priv_spends: _priv_spends -%}
          {%- render 'lf-pdp-extra-media', product: selected_product -%}
        </div>
      {%- endif -%}
      <div class="product-details-wrapper">
        {%- content_for 'block', id: 'product-details', type: '_product-details' -%}
      </div>
    {%- endif -%}
  </div>

  {%- content_for 'blocks' -%}
</div>

<style>
/* VSK override, inline so it wins regardless of compiled-CSS cache timing */
[data-testid="product-information"] variant-swatch-king{display:none!important}
[data-testid="product-information"] .variant-picker{opacity:1!important;max-height:none!important;overflow:visible!important}
</style>

{%- unless selected_product == blank -%}
  {%- assign _sav = selected_product.selected_or_first_available_variant -%}
  <div id="lf-sticky-atc-{{ selected_product.id }}" class="lf-sticky-atc" aria-hidden="true">
    <div class="lf-sticky-atc__inner">
      <div class="lf-sticky-atc__info">
        <span class="lf-sticky-atc__title">{{ selected_product.title | truncate: 38 }}</span>
        <span class="lf-sticky-atc__price" id="lf-sticky-price-{{ selected_product.id }}">{{ _sav.price | money }}</span>
      </div>
      <button
        class="lf-sticky-atc__btn"
        id="lf-sticky-btn-{{ selected_product.id }}"
        data-variant-id="{{ _sav.id }}"
        data-product-id="{{ selected_product.id }}"
        {% unless _sav.available %}disabled{% endunless %}
      >{%- if _sav.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}</button>
    </div>
  </div>
  <script>
  (function() {
    var pid = {{ selected_product.id }};
    var bar = document.getElementById('lf-sticky-atc-' + pid);
    var btn = document.getElementById('lf-sticky-btn-' + pid);
    var priceEl = document.getElementById('lf-sticky-price-' + pid);
    if (!bar || !btn) return;

    var dataEl = document.getElementById('lf-vpx-' + pid);
    var variants = [];
    try { variants = JSON.parse(dataEl ? dataEl.textContent : '[]'); } catch(e) {}

    function formatMoney(pence) {
      return '£' + (pence / 100).toFixed(2).replace(/\.00$/, '');
    }

    function applyVariant(v) {
      if (!v) return;
      btn.dataset.variantId = v.id;
      if (priceEl) priceEl.textContent = formatMoney(v.p);
      btn.disabled = !v.available;
      btn.textContent = v.available ? 'Add to Cart' : 'Sold Out';
    }

    var input = document.querySelector('[data-testid="product-information"] input[name="id"]');
    if (input) {
      new MutationObserver(function() {
        var id = parseInt(input.value, 10);
        var v = variants.find(function(x) { return x.id === id; });
        if (v) {
          v.available = input.closest('form') ? !input.closest('form').querySelector('[data-soldout]') : true;
          applyVariant(v);
        }
      }).observe(input, { attributes: true, attributeFilter: ['value'] });
      input.addEventListener('change', function() {
        var id = parseInt(this.value, 10);
        var v = variants.find(function(x) { return x.id === id; });
        if (v) applyVariant(v);
      });
    }

    var mainAtc = document.querySelector('[data-testid="product-information"] .product-form-buttons');
    if (mainAtc && 'IntersectionObserver' in window) {
      new IntersectionObserver(function(entries) {
        var visible = entries[0].isIntersecting;
        bar.classList.toggle('lf-sticky-atc--visible', !visible);
        bar.setAttribute('aria-hidden', visible ? 'true' : 'false');
      }, { threshold: 0.2 }).observe(mainAtc);
    }

    btn.addEventListener('click', function() {
      var vid = parseInt(btn.dataset.variantId, 10);
      if (!vid) return;
      btn.textContent = 'Adding…';
      btn.disabled = true;
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: vid, quantity: 1 }] })
      })
      .then(function(r) { return r.json(); })
      .then(function() {
        btn.textContent = 'Added ✓';
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        setTimeout(function() { btn.textContent = 'Add to Cart'; btn.disabled = false; }, 2000);
      })
      .catch(function() {
        btn.textContent = 'Error, try again';
        setTimeout(function() { btn.textContent = 'Add to Cart'; btn.disabled = false; }, 2000);
      });
    });
  })();
  </script>
{%- endunless -%}

<style>
  .lf-media-col { display: flex; flex-direction: column; position: relative; }
  .lf-pdp-reviews-col {
    margin-top: 24px;
    border-top: 1px solid rgba(0,0,0,0.07);
    padding-top: 8px;
    min-height: 0;
  }
</style>

<script>
(function() {
  var widgetId = 'lf-reviewsio-pdp-{{ selected_product.id }}';
  var sku = {{ _rev_sku | json }};

  function initWidget() {
    if (typeof carouselInlineWidget === 'undefined') return;
    new carouselInlineWidget(widgetId, {
      store: 'theskinbay.co.uk',
      sku: sku,
      lang: 'en',
      carousel_type: 'default',
      styles_carousel: 'CarouselWidget--sideHeader--withcards',
      options: {
        general: {
          review_type: 'product, company',
          min_reviews: '1',
          max_reviews: '20',
          enable_auto_scroll: 4000,
          enable_pause_button: false,
          enable_sorting: false,
        },
        header: {
          enable_overall_stars: true,
          rating_decimal_places: 1,
        },
        reviews: {
          enable_customer_name: true,
          enable_customer_location: false,
          enable_verified_badge: true,
          enable_review_date: true,
          hide_empty_reviews: true,
          enable_product_name: false,
          min_review_percent: 3,
          third_party_source: true,
          disable_same_customer: true,
        },
        popups: {
          enable_review_popups: true,
          enable_helpful_buttons: false,
          enable_helpful_count: false,
          enable_share_buttons: false,
        },
      },
      styles: {
        '--base-font-size': '14px',
        '--base-maxwidth': '100%',
        '--reviewsio-logo-style': 'var(--logo-inverted)',
        '--common-star-color': '#0c0c0c',
        '--common-star-disabled-color': 'rgba(0,0,0,0.2)',
        '--medium-star-size': '18px',
        '--small-star-size': '15px',
        '--header-order': '1',
        '--header-width': '180px',
        '--header-bg-start-color': '#0c0c0c',
        '--header-bg-end-color': '#0c0c0c',
        '--header-gradient-direction': '135deg',
        '--header-padding': '1.2em',
        '--header-border-width': '0px',
        '--header-border-radius': '0px',
        '--header-shadow-size': '0px',
        '--header-star-color': '#fff',
        '--header-heading-text-color': '#fff',
        '--header-subheading-text-color': '#fff',
        '--header-subheading-font-weight': '300',
        '--item-maximum-columns': '3',
        '--item-background-start-color': '#ffffff',
        '--item-background-end-color': '#ffffff',
        '--item-padding': '1em',
        '--item-border-width': '1px',
        '--item-border-color': 'rgba(0,0,0,0.08)',
        '--item-border-radius': '0px',
        '--item-shadow-size': '0px',
        '--heading-text-color': '#0c0c0c',
        '--heading-text-font-weight': '600',
        '--body-text-color': '#444',
        '--body-text-font-weight': '400',
        '--scroll-button-icon-color': '#0c0c0c',
        '--scroll-button-icon-size': '20px',
        '--scroll-button-bg-color': 'transparent',
        '--scroll-button-border-width': '0px',
        '--scroll-button-border-radius': '0px',
        '--scroll-button-shadow-size': '0px',
        '--scroll-button-horizontal-position': '0px',
        '--scroll-button-vertical-position': '0px',
        '--badge-icon-color': '#0c0c0c',
        '--badge-text-color': '#0c0c0c',
        '--popup-backdrop-color': 'rgba(0,0,0,0.75)',
        '--popup-color': '#fff',
        '--popup-border-radius': '0px',
        '--popup-shadow-size': '0px',
        '--popup-icon-color': '#0c0c0c',
        '--tooltip-bg-color': '#0c0c0c',
        '--tooltip-text-color': '#fff',
      },
      translations: { verified_customer: 'Verified Customer' },
    });
  }

  // Rating snippet, lightweight star widget near title
  (function() {
    var rsEl = document.getElementById('lf-rs-{{ selected_product.id }}');
    if (!rsEl) return;
    var rsSku = rsEl.getAttribute('data-sku');
    if (!rsSku) return;

    function initRatingSnippet() {
      if (typeof ratingSnippet === 'undefined') return;
      ratingSnippet('ratingSnippet', {
        store: 'theskinbay.co.uk',
        sku: rsSku,
        component: rsEl,
        lang: 'en',
        color: '#0c0c0c',
      });
      // Hide if widget renders nothing (no reviews yet)
      setTimeout(function() {
        if (!rsEl.querySelector('.ruk_rating_snippet') && !rsEl.innerHTML.trim()) {
          rsEl.style.display = 'none';
        }
      }, 2500);
    }

    if (!document.querySelector('script[src*="rating-snippet/dist"]')) {
      var rs = document.createElement('script');
      rs.src = 'https://widget.reviews.co.uk/rating-snippet/dist.js';
      rs.async = true;
      rs.onload = initRatingSnippet;
      document.head.appendChild(rs);
      var rsc = document.createElement('link');
      rsc.rel = 'stylesheet';
      rsc.href = 'https://widget.reviews.co.uk/rating-snippet/dist.css';
      document.head.appendChild(rsc);
    } else {
      initRatingSnippet();
    }
  })();

  if (!document.querySelector('script[src*="carousel-inline-iframeless"]')) {
    // Preconnect for faster loading
    ['https://widget.reviews.co.uk', 'https://assets.reviews.io'].forEach(function(origin) {
      if (!document.querySelector('link[rel="preconnect"][href="' + origin + '"]')) {
        var pc = document.createElement('link');
        pc.rel = 'preconnect'; pc.href = origin; pc.crossOrigin = 'anonymous';
        document.head.appendChild(pc);
      }
    });
    var s = document.createElement('script');
    s.src = 'https://widget.reviews.co.uk/carousel-inline-iframeless/dist.js?_t=2026042205';
    s.async = true;
    s.onload = initWidget;
    document.head.appendChild(s);
    var c = document.createElement('link');
    c.rel = 'stylesheet';
    c.href = 'https://assets.reviews.io/css/widgets/carousel-widget.css?_t=2026042205';
    document.head.appendChild(c);
    var i = document.createElement('link');
    i.rel = 'stylesheet';
    i.href = 'https://assets.reviews.io/iconfont/reviewsio-icons/style.css?_t=2026042205';
    document.head.appendChild(i);
  } else {
    initWidget();
  }
})();
</script>

<script type="application/ld+json">
{%- liquid
  assign _sp = selected_product
  assign _sv = _sp.selected_or_first_available_variant
-%}
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": "{{ canonical_url }}#product",
  "name": {{ _sp.title | json }},
  "description": {{ _sp.description | strip_html | strip | truncate: 5000 | json }},
  "brand": {
    "@type": "Brand",
    "name": {{ _sp.vendor | json }}
  },
  "category": {{ _sp.type | json }},
  "url": "{{ canonical_url }}",
  {%- unless _sv.sku == blank -%}
  "sku": {{ _sv.sku | json }},
  {%- endunless -%}
  {%- if _sv.barcode != blank -%}
  "gtin": {{ _sv.barcode | json }},
  {%- endif -%}
  "image": [
    {%- assign _img_i = 0 -%}
    {%- for media in _sp.media -%}
      {%- if media.media_type == 'image' -%}
        {%- if _img_i > 0 -%},{%- endif -%}
        "https:{{ media | image_url: width: 1200 }}"
        {%- assign _img_i = _img_i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ],
  "offers": [
    {%- for variant in _sp.variants -%}
    {%- unless forloop.first -%},{%- endunless -%}
    {%- assign _pi = variant.price | divided_by: 100 -%}
    {%- assign _pd = variant.price | modulo: 100 -%}
    {%- if _pd < 10 -%}{%- assign _ps = _pi | append: '.0' | append: _pd -%}
    {%- else -%}{%- assign _ps = _pi | append: '.' | append: _pd -%}{%- endif -%}
    {
      "@type": "Offer",
      "@id": "{{ canonical_url }}?variant={{ variant.id }}#offer",
      "sku": {{ variant.sku | default: _sp.handle | json }},
      "price": "{{ _ps }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}"
      {%- if variant.compare_at_price > variant.price -%}
      {%- assign _yr = 'now' | date: '%Y' | plus: 1 -%}
      ,"priceValidUntil": "{{ _yr }}-12-31"
      {%- endif -%}
      ,"url": "{{ canonical_url }}?variant={{ variant.id }}"
      ,"seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }
    {%- endfor -%}
  ]
}
</script>

<script type="application/json" id="lf-vpx-{{ selected_product.id }}">
  [
    {%- for v in selected_product.variants -%}
      {"id":{{ v.id }},"p":{{ v.price }},"cp":{{ v.compare_at_price | default: 0 }},"iq":{{ v.inventory_quantity }},"ip":"{{ v.inventory_policy }}","im":"{{ v.inventory_management }}"}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>
<script>
(function () {
  var pid = {{ selected_product.id }};
  var dataEl = document.getElementById('lf-vpx-' + pid);
  if (!dataEl) return;
  var variants;
  try { variants = JSON.parse(dataEl.textContent); } catch (e) { return; }

  function getBadge() {
    return document.querySelector('.lf-save-badge[data-product-id="' + pid + '"]');
  }

  function applyVariant(id) {
    var v = variants.find(function (x) { return x.id === id; });
    if (!v) return;

    // Save badge
    var badge = document.querySelector('.lf-save-badge[data-product-id="' + pid + '"]');
    if (badge) {
      var pct = (v.cp > v.p) ? Math.round((v.cp - v.p) * 100 / v.cp) : 0;
      if (pct > 0) {
        badge.textContent = 'Save £' + ((v.cp - v.p) / 100).toFixed(2) + ' · ' + pct + '% OFF';
        badge.classList.remove('lf-save-badge--hidden');
      } else {
        badge.textContent = '';
        badge.classList.add('lf-save-badge--hidden');
      }
    }

    // Rewards points + £ equivalent
    var rpts = document.getElementById('lf-rpts-' + pid);
    var pts = Math.round((v.p / 100) * 0.5);
    if (rpts) rpts.textContent = pts;
    var rptsgbp = document.getElementById('lf-rpts-gbp-' + pid);
    if (rptsgbp) rptsgbp.textContent = '£' + (pts * 0.05).toFixed(2).replace(/\.00$/, '');

    // Stock counter
    var stock = document.getElementById('lf-stock-' + pid);
    if (stock) {
      if (v.im === 'shopify' && v.ip === 'deny' && v.iq > 0 && v.iq <= 10) {
        stock.innerHTML = '<span class="lf-stock-dot"></span>Only ' + v.iq + ' left in stock';
        stock.style.display = '';
      } else {
        stock.style.display = 'none';
      }
    }
  }

  function watchInput(input) {
    new MutationObserver(function () {
      applyVariant(parseInt(input.value, 10));
    }).observe(input, { attributes: true, attributeFilter: ['value'] });
    input.addEventListener('change', function () {
      applyVariant(parseInt(this.value, 10));
    });
  }

  // Move privilege card below Apple Pay / buy buttons block
  function positionPrivCard() {
    var card = document.querySelector('[data-testid="product-information-details"] .lf-priv-card');
    var anchor = document.querySelector('[data-testid="product-information-details"] .accelerated-checkout-block')
      || document.querySelector('[data-testid="product-information-details"] more-payment-options-link')
      || document.querySelector('[data-testid="product-information-details"] .buy-buttons-block');
    if (card && anchor) anchor.after(card);
  }

  // Move rewards bar to directly below the price element
  function positionRewardsBar() {
    var bar = document.querySelector('.lf-rewards-bar[data-product-id="' + pid + '"]');
    var priceEl = document.querySelector('[data-testid="product-information-details"] product-price');
    if (bar && priceEl) priceEl.after(bar);
  }

  // Move rating snippet to before the price (below title)
  function positionRatingSnippet() {
    var el = document.getElementById('lf-rs-' + pid);
    var priceEl = document.querySelector('[data-testid="product-information-details"] product-price');
    if (el && priceEl) priceEl.before(el);
  }

  // Move stock counter to just before the buy-buttons block
  function positionStockCounter() {
    var el = document.getElementById('lf-stock-' + pid);
    var buyBlock = document.querySelector('[data-testid="product-information-details"] .buy-buttons-block')
      || document.querySelector('[data-testid="product-information-details"] .product-form-buttons');
    if (el && buyBlock) buyBlock.before(el);
  }

  // Move mobile trust strip to after privilege card (or after Apple Pay if no priv card)
  function positionMobTrust() {
    var el = document.querySelector('[data-testid="product-information-details"] .lf-mob-trust');
    var anchor = document.querySelector('[data-testid="product-information-details"] .lf-priv-card')
      || document.querySelector('[data-testid="product-information-details"] more-payment-options-link')
      || document.querySelector('[data-testid="product-information-details"] .accelerated-checkout-block')
      || document.querySelector('[data-testid="product-information-details"] .buy-buttons-block');
    if (el && anchor) anchor.after(el);
  }

  function init() {
    var input = document.querySelector('[data-testid="product-information"] input[name="id"]');
    if (input) watchInput(input);
    positionRatingSnippet();
    positionRewardsBar();
    positionStockCounter();
    positionPrivCard();
    positionMobTrust();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

{% stylesheet %}

.product-information {
  padding: 40px 0;
  overflow-x: clip;
}

.product-information__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
  align-items: start;
}

.product-information__media {
  width: 100%;
}

.product-details-wrapper {
  max-width: 520px;
  margin: 0 auto;
}

@media screen and (max-width: 749px) {
  .product-details-wrapper {
    padding: 0 20px;
  }
}

@media screen and (min-width: 900px) {
  .product-information__grid.product-information--media-left {
    grid-template-columns: 1.3fr 1fr;
  }

  .product-information__grid.product-information--media-right {
    grid-template-columns: 1fr 1.3fr;
  }

  .product-details-wrapper {
    margin: 0;
    max-width: none;
  }
}

@media screen and (min-width: 1200px) {
  .product-information__grid.product-information--media-left {
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
  }

  .product-information__grid.product-information--media-right {
    grid-template-columns: 1fr 1.2fr;
    gap: 48px;
  }

