  background: #c0392b;
  flex-shrink: 0;
  animation: lf-pulse 1.6s ease-in-out infinite;
}

@keyframes lf-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.8); }
}

/* ── Variant Swatch King (VSK) app: suppress duplicate injection ──
   VSK injects a swatch UI then hides .variant-picker with opacity:0;max-height:0.
   We hide VSK's injected element and restore visibility of the theme's native picker. */
[data-testid="product-information"] variant-swatch-king {
  display: none !important;
}
[data-testid="product-information"] .variant-picker {
  opacity: 1 !important;
  max-height: none !important;
  overflow: visible !important;
}

/* ── Variant dropdown: luxury select styling ── */
[data-testid="product-information"] .variant-option--dropdowns .variant-option__select-wrapper {
  border: 1.5px solid rgba(0, 0, 0, 0.18);
  border-radius: 0;
  margin-top: 8px;
}

[data-testid="product-information"] .variant-option--dropdowns .variant-option__select {
  font-family: 'Lato', var(--font-body--family), sans-serif;
  font-size: 0.5625rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding-block: 14px;
  color: #0c0c0c;
}

[data-testid="product-information"] .variant-option--dropdowns label {
  font-family: 'Lato', var(--font-body--family), sans-serif;
  font-size: 0.5625rem;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(0, 0, 0, 0.5);
}

/* ── Mobile sticky ATC bar ── */
.lf-sticky-atc {
  display: none;
}

@media screen and (max-width: 749px) {
  .product-information {
    padding-bottom: 80px;
  }

  .lf-sticky-atc {
    display: block;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 998;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    padding: 10px 16px;
    padding-bottom: max(10px, env(safe-area-inset-bottom));
    transform: translateY(110%);
    transition: transform 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    pointer-events: none;
  }

  .lf-sticky-atc--visible {
    transform: translateY(0);
    pointer-events: auto;
  }

  .lf-sticky-atc__inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lf-sticky-atc__info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .lf-sticky-atc__title {
    font-size: 11px;
    font-weight: 500;
    color: #111;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lf-sticky-atc__price {
    font-size: 13px;
    font-weight: 700;
    color: #000;
  }

  .lf-sticky-atc__btn {
    flex-shrink: 0;
    background: #000;
    color: #fff;
    border: none;
    padding: 13px 18px;
    font-family: 'Lato', var(--font-body--family), sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.18s;
    white-space: nowrap;
    line-height: 1;
  }

  .lf-sticky-atc__btn:hover:not(:disabled) {
    background: #222;
  }

  .lf-sticky-atc__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product",
  "class": "product-information-section",
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.media_width",
      "options": [
        { "value": "content-center-aligned", "label": "t:options.contained" },
        { "value": "content-full-width", "label": "t:options.full_width" }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.desktop_media_position",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_details_width",
      "default": false
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "t:names.product"
    }
  ]
}
{% endschema %}
