{%- comment -%} NAD bespoke, trust / credentials strip {%- endcomment -%}
<section class="nad-trust" style="background:{{ section.settings.bg }};">
  <div class="nadtr-wrap">
    {%- for block in section.blocks -%}
      <div class="nadtr-item" {{ block.shopify_attributes }}>
        <span class="nadtr-ic">
          {%- case block.settings.icon -%}
            {%- when 'shield' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- when 'lab' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3h6M10 3v6l-5 8a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 17l-5-8V3"/><path d="M7.5 14h9"/></svg>
            {%- when 'truck' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h11v9H3zM14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
            {%- when 'drop' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/></svg>
            {%- when 'sparkle' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/></svg>
            {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12l4 4 10-10"/></svg>
          {%- endcase -%}
        </span>
        <span class="nadtr-tx"><strong>{{ block.settings.title }}</strong>{% if block.settings.sub != blank %}<em>{{ block.settings.sub }}</em>{% endif %}</span>
      </div>
    {%- endfor -%}
  </div>
</section>
<style>
  .nad-trust{padding:6px 20px 26px;}
  .nadtr-wrap{max-width:1040px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);background:var(--box,#FBF6EA);border:1px solid var(--boxline,#ECE3CE);border-radius:22px;padding:32px 18px;}
  .nadtr-item{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;padding:2px 18px;}
  .nadtr-item:not(:last-child){border-right:1px solid var(--boxline,#ECE3CE);}
  .nadtr-ic{width:30px;height:30px;color:#141414;display:flex;align-items:center;justify-content:center;}
  .nadtr-ic svg{width:30px;height:30px;stroke-width:1.4;}
  .nadtr-tx{font-family:'Lato',sans-serif;display:flex;flex-direction:column;gap:4px;}
  .nadtr-tx strong{color:#141414;font-size:13.5px;font-weight:700;letter-spacing:.01em;line-height:1.3;}
  .nadtr-tx em{color:#8a8f98;font-style:normal;font-size:11.5px;letter-spacing:.02em;line-height:1.35;}
  @media(max-width:749px){
    .nadtr-wrap{grid-template-columns:1fr 1fr;gap:28px 0;padding:30px 14px;}
    .nadtr-item{padding:0 12px;}
    .nadtr-item:not(:last-child){border-right:none;}
    .nadtr-item:nth-child(odd){border-right:1px solid var(--boxline,#ECE3CE);}
  }
</style>
{% schema %}
{
  "name": "NAD · Trust strip",
  "settings": [ { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" } ],
  "blocks": [
    { "type": "item", "name": "Credential", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shield",
        "options": [{"value":"shield","label":"Shield"},{"value":"lab","label":"Lab"},{"value":"truck","label":"Delivery"},{"value":"drop","label":"Drop"},{"value":"check","label":"Check"}] },
      { "type": "text", "id": "title", "label": "Title", "default": "Certified labs" },
      { "type": "text", "id": "sub", "label": "Subtext", "default": "ISO-certified, batch-tested" }
    ]}
  ],
  "max_blocks": 4,
  "presets": [{ "name": "NAD · Trust strip", "blocks": [
    { "type": "item", "settings": { "icon": "lab", "title": "Certified labs", "sub": "ISO-certified, batch-tested" } },
    { "type": "item", "settings": { "icon": "drop", "title": "~100% bioavailability", "sub": "Bypasses digestion" } },
    { "type": "item", "settings": { "icon": "shield", "title": "Certificate of Analysis", "sub": "Purity on request" } },
    { "type": "item", "settings": { "icon": "truck", "title": "Discreet UK dispatch", "sub": "Tracked delivery" } }
  ]}]
}
{% endschema %}
