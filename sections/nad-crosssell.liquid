{%- comment -%} NAD bespoke, converting cross-sell: perfect pairing (add both) + more NAD products {%- endcomment -%}
{%- assign this_v = product.selected_or_first_available_variant -%}
{%- if section.settings.source == 'related' -%}
  {%- assign recs = product.metafields.custom.related_products_list.value -%}
  {%- if recs == blank or recs.size == 0 -%}
    {%- assign skip = 'all-products,sale,new-in,brands,brand,frontpage,health-wellness,supplements,3-month-subscription-products' -%}
    {%- for c in product.collections -%}{%- unless skip contains c.handle -%}{%- assign recs = c.products -%}{%- break -%}{%- endunless -%}{%- endfor -%}
  {%- endif -%}
{%- else -%}
  {%- assign recs = collections[section.settings.collection].products -%}
{%- endif -%}
{%- assign xcat = section.settings.cross_category -%}
{%- assign is_glut = false -%}
{%- if product.title contains 'Glutathione' or product.title contains 'glutathione' -%}{%- assign is_glut = true -%}{%- endif -%}
{%- assign paired = product.metafields.custom.paired_product.value -%}
{%- if xcat -%}
  {%- comment -%} NAD/glutathione: recommend the opposite category, never itself {%- endcomment -%}
  {%- assign paired_glut = false -%}
  {%- if paired != blank and paired.title contains 'Glutathione' -%}{%- assign paired_glut = true -%}{%- endif -%}
  {%- if paired == blank or paired_glut == is_glut -%}
    {%- assign paired = blank -%}
    {%- for p in recs -%}
      {%- assign pg = false -%}{%- if p.title contains 'Glutathione' -%}{%- assign pg = true -%}{%- endif -%}
      {%- if p.id != product.id and p.available and pg != is_glut -%}{%- assign paired = p -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- else -%}
  {%- comment -%} same-brand: pair with metafield or first other available in the collection {%- endcomment -%}
  {%- if paired == blank -%}
    {%- for p in recs -%}{%- if p.id != product.id and p.available -%}{%- assign paired = p -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- endif -%}
{%- endif -%}
{%- assign show_xs = false -%}{%- if paired != blank or recs.size > 0 -%}{%- assign show_xs = true -%}{%- endif -%}
{%- if show_xs -%}
<section class="nad-xs" style="background:{{ section.settings.bg }};">
  <div class="nadxs-wrap">
    <img class="nad-header-img" src="{{ section.settings.header_image | default: 'nad-h-pair.png' | asset_url }}" alt="Complete the ritual" loading="lazy" width="1500" height="340">

    {%- if paired != blank and paired.available -%}
      {%- assign pv = paired.selected_or_first_available_variant -%}
      {%- assign combo = this_v.price | plus: pv.price -%}
      <div class="nadxs-pair">
        <span class="nadxs-tag">{{ product.metafields.custom.paired_reason_tag | default: 'Perfect pairing' }}</span>
        <div class="nadxs-pair-row">
          <a class="nadxs-pp" href="{{ product.url }}"><img src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ product.title | escape }}" width="120" height="120" loading="lazy"><span>{{ product.title }}</span></a>
          <span class="nadxs-plus">+</span>
          <a class="nadxs-pp" href="{{ paired.url }}"><img src="{{ paired.featured_image | image_url: width: 240 }}" alt="{{ paired.title | escape }}" width="120" height="120" loading="lazy"><span>{{ paired.title }}</span></a>
        </div>
        {%- if product.metafields.custom.paired_reason_desc != blank -%}<p class="nadxs-reason">{{ product.metafields.custom.paired_reason_desc }}</p>{%- endif -%}
        <div class="nadxs-pair-foot">
          <div class="nadxs-combo"><span>Buy them together</span><strong>{{ combo | money }}</strong></div>
          <button type="button" class="nadxs-btn nadxs-btn--lg" onclick="nadXsPair(this,{{ this_v.id }},{{ pv.id }})">Add both to bag</button>
        </div>
      </div>
    {%- endif -%}

    {%- if recs.size > 0 -%}
      <h3 class="nadxs-more">{{ section.settings.more_heading }}</h3>
      <div class="nadxs-grid">
        {%- assign shown = 0 -%}
        {%- for p in recs -%}
          {%- assign pg = false -%}{%- if p.title contains 'Glutathione' -%}{%- assign pg = true -%}{%- endif -%}
          {%- assign show_p = true -%}{%- if xcat and pg == is_glut -%}{%- assign show_p = false -%}{%- endif -%}
          {%- if p.id != product.id and p.available and show_p and p.id != paired.id and shown < section.settings.max_products -%}
            {%- assign pvv = p.selected_or_first_available_variant -%}
            <div class="nadxs-card">
              <a class="nadxs-card-img" href="{{ p.url }}"><img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title | escape }}" loading="lazy" width="250" height="250">{% if pvv.compare_at_price > pvv.price %}<span class="nadxs-save">Save {{ pvv.compare_at_price | minus: pvv.price | money_without_trailing_zeros }}</span>{% endif %}</a>
              <div class="nadxs-card-b">
                <a class="nadxs-card-t" href="{{ p.url }}">{{ p.title }}</a>
                <div class="nadxs-card-p"><span>{{ pvv.price | money }}</span>{% if pvv.compare_at_price > pvv.price %}<em>{{ pvv.compare_at_price | money }}</em>{% endif %}</div>
                <button type="button" class="nadxs-btn" onclick="nadXsAdd(this,{{ pvv.id }})">Add to bag</button>
              </div>
            </div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.view_all_url != blank -%}<a class="nadxs-viewall" href="{{ section.settings.view_all_url }}">{{ section.settings.view_all_text }}</a>{%- endif -%}
    {%- endif -%}
  </div>
</section>
<script>
  function nadXsFetch(items,cb){fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})}).then(function(r){if(!r.ok)throw 0;document.dispatchEvent(new CustomEvent('cart:refresh'));if(window.openCart)window.openCart();cb(true);}).catch(function(){cb(false);});}
  function nadXsAdd(b,id){var o=b.textContent;b.disabled=true;b.textContent='Adding…';nadXsFetch([{id:id,quantity:1}],function(ok){b.disabled=false;b.textContent=ok?'Added ✓':o;if(ok)setTimeout(function(){b.textContent=o;},1500);else window.location.href='/cart';});}
  function nadXsPair(b,a,c){var o=b.textContent;b.disabled=true;b.textContent='Adding…';nadXsFetch([{id:a,quantity:1},{id:c,quantity:1}],function(ok){b.disabled=false;b.textContent=ok?'Added ✓':o;if(ok)setTimeout(function(){b.textContent=o;},1500);else window.location.href='/cart';});}
</script>
<style>
  .nad-xs{padding:52px 20px;}
  .nadxs-wrap{max-width:1140px;margin:0 auto;}
  .nad-xs .nad-header-img{display:block;width:100%;max-width:520px;height:auto;margin:0 auto 30px;}
  .nadxs-pair{background:var(--box,#FBF6EA);border:1px solid var(--boxline,#ECE3CE);border-radius:22px;padding:28px 30px;max-width:760px;margin:0 auto 40px;text-align:center;}
  .nadxs-tag{display:inline-block;font-family:'Lato',sans-serif;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--acctext,#141414);background:var(--accent,#F6C21A);border-radius:20px;padding:5px 13px;margin-bottom:20px;}
  .nadxs-pair-row{display:grid;grid-template-columns:1fr auto 1fr;align-items:start;justify-items:center;gap:14px;max-width:520px;margin:0 auto;}
  .nadxs-pp{display:flex;flex-direction:column;align-items:center;gap:10px;text-decoration:none;color:#141414;width:100%;max-width:190px;text-align:center;}
  .nadxs-pp img{width:100%;max-width:150px;aspect-ratio:1/1;object-fit:contain;background:#fff;border:1px solid var(--boxline,#ECE3CE);border-radius:14px;padding:8px;}
  .nadxs-pp span{font-family:'Lato',sans-serif;font-size:13px;line-height:1.35;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;min-height:3.5em;}
  .nadxs-plus{font-family:'Playfair Display',serif;font-size:24px;color:#8a8478;align-self:center;padding-top:44px;}
  .nadxs-reason{font-family:'Lato',sans-serif;font-size:14px;line-height:1.6;color:#4a463f;margin:18px auto 0;max-width:520px;}
  .nadxs-pair-foot{display:flex;align-items:center;justify-content:center;gap:18px;flex-wrap:wrap;margin-top:22px;}
  .nadxs-combo{text-align:left;}
  .nadxs-combo span{display:block;font-family:'Lato',sans-serif;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#8a8478;}
  .nadxs-combo strong{font-family:'Playfair Display',serif;font-size:24px;color:#141414;}
  .nadxs-more{font-family:'Playfair Display',serif;font-size:24px;color:#141414;text-align:center;margin:0 0 22px;}
  .nadxs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
  .nadxs-card{background:var(--box,#FBF6EA);border:1px solid var(--boxline,#ECE3CE);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;}
  .nadxs-card-img{position:relative;display:block;background:#fff;}
  .nadxs-card-img img{width:100%;aspect-ratio:1/1;object-fit:contain;display:block;}
  .nadxs-save{position:absolute;top:10px;left:10px;background:#141414;color:#fff;font-family:'Lato',sans-serif;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:5px 9px;border-radius:20px;}
  .nadxs-card-b{padding:14px 15px 16px;display:flex;flex-direction:column;gap:8px;flex:1;}
  .nadxs-card-t{font-family:'Lato',sans-serif;font-size:13.5px;line-height:1.35;color:#141414;text-decoration:none;flex:1;}
  .nadxs-card-p{display:flex;align-items:baseline;gap:8px;}
  .nadxs-card-p span{font-family:'Playfair Display',serif;font-size:18px;color:#141414;}
  .nadxs-card-p em{font-style:normal;font-size:13px;color:#8a8478;text-decoration:line-through;}
  .nadxs-btn{appearance:none;border:none;cursor:pointer;background:#141414;color:#fff;font-family:'Lato',sans-serif;font-size:12px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;padding:12px 16px;border-radius:30px;transition:background .2s;}
  .nadxs-btn:hover{background:#000;}
  .nadxs-btn--lg{font-size:13px;padding:15px 26px;}
  .nadxs-viewall{display:inline-block;margin:30px auto 0;text-align:center;font-family:'Lato',sans-serif;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#141414;border-bottom:2px solid #141414;text-decoration:none;padding-bottom:3px;}
  .nadxs-viewall-wrap{text-align:center;}
  @media(max-width:989px){.nadxs-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:749px){.nad-xs{padding:38px 16px;}.nadxs-pair{padding:22px 18px;}.nadxs-pp img{width:92px;height:92px;}.nadxs-pair-foot{gap:12px;}}
</style>
{%- endif -%}
{% schema %}
{
  "name": "NAD · Cross-sell",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6C21A" },
    { "type": "text", "id": "header_image", "label": "Header image file (blank = default)" },
    { "type": "text", "id": "collection", "label": "Collection handle", "default": "nad-home" },
    { "type": "select", "id": "source", "label": "Recommendations source", "default": "collection", "options": [{"value":"collection","label":"From collection"},{"value":"related","label":"From product related metafield"}] },
    { "type": "checkbox", "id": "cross_category", "label": "Cross-category (NAD/glutathione)", "default": true },
    { "type": "text", "id": "more_heading", "label": "Grid heading", "default": "More from NAD+ At Home" },
    { "type": "range", "id": "max_products", "min": 2, "max": 8, "step": 1, "label": "Max products", "default": 4 },
    { "type": "url", "id": "view_all_url", "label": "View all link" },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "Shop all NAD+ At Home" }
  ],
  "presets": [{ "name": "NAD · Cross-sell" }]
}
{% endschema %}
