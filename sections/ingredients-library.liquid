<style>
  .il{background:#fff;color:#141414;}
  .il-banner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 22px;}
  .il-vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
  .il-hero{background:#F9F3ED;text-align:center;padding:56px 24px 40px;}
  .il-hero-inner{max-width:720px;margin:0 auto;}
  .il-eyebrow{font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:12px;color:#8a8377;margin:0 0 10px;}
  .il-title{font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:clamp(34px,5vw,54px);line-height:1.05;margin:0 0 14px;}
  .il-lede{font-family:'Lato',sans-serif;font-size:16px;line-height:1.6;color:#4d4840;max-width:560px;margin:0 auto;}
  .il-search{position:relative;max-width:460px;margin:26px auto 0;}
  .il-search svg{position:absolute;left:18px;top:50%;transform:translateY(-50%);width:18px;height:18px;color:#a49c8d;}
  .il-search input{width:100%;box-sizing:border-box;padding:15px 20px 15px 46px;border-radius:999px;border:1px solid #e2dbcd;background:#fff;font-family:'Lato',sans-serif;font-size:14px;color:#141414;}
  .il-search input:focus{outline:none;border-color:#141414;}
  .il-chips{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:22px;}
  .il-chip{font-family:'Lato',sans-serif;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:9px 16px;border-radius:999px;border:1px solid #cfc7b7;background:transparent;color:#6b6459;cursor:pointer;transition:all .2s;}
  .il-chip:hover{border-color:#141414;color:#141414;}
  .il-chip.is-active{background:#141414;color:#fff;border-color:#141414;}
  .il-grid{max-width:860px;margin:0 auto;padding:36px 24px 72px;display:flex;flex-direction:column;gap:14px;}
  .il-card{border:1px solid #ece7df;border-radius:8px;overflow:hidden;background:#fff;}
  .il-card[open]{border-color:#d8d0c1;box-shadow:0 8px 24px rgba(0,0,0,.05);}
  .il-head{list-style:none;cursor:pointer;padding:20px 52px 20px 24px;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px;position:relative;}
  .il-head::-webkit-details-marker{display:none;}
  .il-head::after{content:'+';position:absolute;right:22px;top:18px;font-family:'Lato',sans-serif;font-size:22px;color:#a49c8d;}
  .il-card[open] .il-head::after{content:'\2013';}
  .il-role-tag{font-family:'Lato',sans-serif;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#8a8377;border:1px solid #e2dbcd;border-radius:999px;padding:4px 10px;}
  .il-name{font-family:'Playfair Display',Georgia,serif;font-size:21px;color:#141414;}
  .il-summary{flex:1 1 100%;font-family:'Lato',sans-serif;font-size:13.5px;line-height:1.5;color:#6b6459;margin-top:3px;}
  .il-body{padding:0 24px 26px;}
  .il-what{font-family:'Lato',sans-serif;font-size:14.5px;line-height:1.7;color:#413d36;margin:0 0 18px;}
  .il-mb{margin-bottom:15px;}
  .il-mlabel{display:block;font-family:'Lato',sans-serif;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#a49c8d;margin-bottom:8px;}
  .il-how{font-family:'Lato',sans-serif;font-size:13.5px;line-height:1.6;color:#4d4840;margin:0;}
  .il-tags{display:flex;flex-wrap:wrap;gap:8px;}
  .il-tag{font-family:'Lato',sans-serif;font-size:12px;padding:6px 12px;border-radius:6px;background:#f3efe8;color:#4d4840;}
  .il-tag-good{background:#edf2ea;color:#41603b;}
  .il-tag-bad{background:#f6eceb;color:#7c3d3d;}
  .il-shop{display:inline-block;margin-top:18px;font-family:'Lato',sans-serif;font-size:12px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;background:#141414;color:#fff;padding:12px 26px;border-radius:999px;transition:opacity .2s;}
  .il-shop:hover{opacity:.85;}
  .il-rx{display:block;margin-top:16px;font-family:'Lato',sans-serif;font-size:12px;font-style:italic;color:#8a8377;}
