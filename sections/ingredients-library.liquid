  @media (max-width:749px){ .il-name{font-size:18px;} .il-grid{padding:28px 16px 56px;} }
</style>

<script>
  (function(){
    var root=document.querySelector('.il[data-section-id="{{ section.id }}"]');
    if(!root){return;}
    var q=root.querySelector('#il-q'), chips=root.querySelectorAll('.il-chip'),
        cards=root.querySelectorAll('.il-card'), empty=root.querySelector('#il-empty');
    var role='all', term='';
    function apply(){
      var n=0;
      cards.forEach(function(c){
        var okR = role==='all' || c.getAttribute('data-role')===role;
        var okT = !term || (c.getAttribute('data-search')||'').indexOf(term)>-1;
        var show=okR&&okT; c.hidden=!show; if(show){n++;} else {c.open=false;}
      });
      empty.hidden = n>0;
    }
    if(q){ q.addEventListener('input',function(e){ term=(e.target.value||'').toLowerCase().trim(); apply(); }); }
    chips.forEach(function(ch){ ch.addEventListener('click',function(){
      chips.forEach(function(x){x.classList.remove('is-active');}); ch.classList.add('is-active');
      role=ch.getAttribute('data-role'); apply();
    }); });
  })();
</script>

