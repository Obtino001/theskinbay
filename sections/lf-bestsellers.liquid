<style>
  .lf-hp *, .lf-hp *::before, .lf-hp *::after { box-sizing:border-box; }
  .lf-hp a { text-decoration:none; }
  .lf-inner { max-width:1560px; margin:0 auto; padding:0 40px; }
  .lf-section-eyebrow { font-family:'Lato',var(--font-body--family),sans-serif; font-size:.5rem; font-weight:700; letter-spacing:.18em; text-transform:uppercase; color:rgba(0,0,0,.35); display:block; }
  .lf-section-title   { font-family:'Playfair Display',Georgia,serif; font-size:clamp(1.75rem,3vw,2.75rem); font-weight:400; letter-spacing:-.015em; color:#111; margin:0; line-height:1.1; }
  .lf-section-header  { display:flex; flex-direction:column; align-items:center; text-align:center; gap:10px; margin-bottom:44px; }
  .lf-view-all        { font-family:'Lato',var(--font-body--family),sans-serif; font-size:.5625rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:rgba(0,0,0,.45); border-bottom:1px solid rgba(0,0,0,.2); padding-bottom:1px; transition:color .15s; white-space:nowrap; }
  .lf-view-all:hover  { color:#000; border-color:#000; }

  .lf-bestsellers-section { padding:64px 0; background:#fafafa; }
  .lf-bs-carousel { position:relative; }
  .lf-bs-grid { --gap:14px; --vis:4.3; display:flex; gap:var(--gap); overflow-x:auto; overflow-y:hidden; scroll-snap-type:x mandatory; scroll-behavior:smooth; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:4px; } /* --vis fallback; per-instance value set below */
  .lf-bs-grid::-webkit-scrollbar { display:none; }
  .lf-bs-card { position:relative; flex:0 0 calc((100% - (var(--vis) - 1) * var(--gap)) / var(--vis)); scroll-snap-align:start; display:flex; flex-direction:column; }
  .lf-bs-img-wrap { position:relative; width:100%; aspect-ratio:1/1; overflow:hidden; background:#fff; margin-bottom:10px; display:flex; align-items:center; justify-content:center; }
  .lf-bs-img { width:100%; height:100%; object-fit:contain; padding:8%; box-sizing:border-box; display:block; transition:transform .5s cubic-bezier(.25,.46,.45,.94); }
  .lf-bs-card:hover .lf-bs-img { transform:scale(1.04); }
  .lf-bs-badge { position:absolute; bottom:0; left:0; background:#741111; color:#fff; padding:4px 8px; font-family:'Lato',var(--font-body--family),sans-serif; font-size:8px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; z-index:2; }
  .lf-best-badge { position:absolute; top:10px; right:10px; z-index:3; background:#000; color:#fff; font-family:'Lato',var(--font-body--family),sans-serif; font-size:7px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; padding:5px 8px; }
  .lf-bs-info { flex:1; display:flex; flex-direction:column; gap:2px; }
  .lf-bs-vendor { font-family:'Lato',var(--font-body--family),sans-serif; font-size:8px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:rgba(0,0,0,.38); }
  .lf-bs-title { font-size:11px; color:#111; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; transition:color .15s; }
  .lf-bs-card:hover .lf-bs-title { color:rgba(0,0,0,.6); }
  .lf-bs-price-row { font-size:11px; margin-top:3px; display:flex; align-items:center; gap:5px; flex-wrap:wrap; }
  .lf-bs-price { font-weight:600; color:#000; }
  .lf-bs-compare { color:#aaa; text-decoration:line-through; font-size:10px; }
  .lf-bs-atc { margin-top:8px; width:100%; padding:8px 6px; background:#fff; border:1px solid #d8d8d8; font-family:'Lato',var(--font-body--family),sans-serif; font-size:9px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; cursor:pointer; transition:background .18s,border-color .18s,color .18s; }
  .lf-bs-atc:hover { background:#000; border-color:#000; color:#fff; }
  .lf-bs-atc:disabled { opacity:.4; cursor:not-allowed; }

  .lf-bs-arrow { position:absolute; top:38%; transform:translateY(-50%); z-index:5; width:44px; height:44px; border-radius:50%; background:#fff; border:1px solid rgba(0,0,0,.08); box-shadow:0 4px 14px rgba(0,0,0,.12); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:opacity .2s,background .2s,color .2s; color:#111; padding:0; }
  .lf-bs-arrow:hover { background:#000; color:#fff; }
  .lf-bs-arrow svg { width:18px; height:18px; }
  .lf-bs-arrow--prev { left:-10px; }
  .lf-bs-arrow--next { right:-10px; }
  .lf-bs-arrow[disabled] { opacity:0; pointer-events:none; }

  @media (max-width:749px)  { .lf-bestsellers-section { padding:48px 0; } .lf-bs-grid { --gap:10px; } .lf-inner { padding:0 20px; } .lf-section-header { align-items:center; } .lf-bs-arrow { display:none; } }

  /* Per-carousel cards-per-row, set from the theme editor (desktop / mobile) */
  .lf-bs-grid.js-lf-bs-track-{{ section.id }} { --vis: {{ section.settings.products_per_row_desktop | default: 5 | plus: 0.3 }}; }
  @media (max-width:1199px) { .lf-bs-grid.js-lf-bs-track-{{ section.id }} { --vis: {{ section.settings.products_per_row_desktop | default: 5 | minus: 1 | plus: 0.3 }}; } }
  @media (max-width:749px)  { .lf-bs-grid.js-lf-bs-track-{{ section.id }} { --vis: {{ section.settings.products_per_row_mobile | default: 2 | plus: 0.2 }}; } }
</style>

<div class="lf-hp">
  <section class="lf-bestsellers-section">
    <div class="lf-inner">
      <div class="lf-section-header">
        <div>
          <span class="lf-section-eyebrow">{{ section.settings.eyebrow | default: 'Hand picked for you' }}</span>
          <h2 class="lf-section-title">{{ section.settings.heading | default: 'Bestsellers' }}</h2>
        </div>
        {%- assign _bs_col = collections[section.settings.collection] -%}
        {%- if _bs_col == blank or _bs_col.products_count == 0 -%}{%- assign _bs_col = collections.all -%}{%- endif -%}
        <a href="{{ section.settings.view_all_link | default: _bs_col.url | default: '/collections/all' }}" class="lf-view-all">{{ section.settings.view_all_label | default: 'View all' }}</a>
      </div>
      <div class="lf-bs-carousel">
        <button type="button" class="lf-bs-arrow lf-bs-arrow--prev js-lf-bs-prev-{{ section.id }}" aria-label="Previous products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
        <div class="lf-bs-grid js-lf-bs-track-{{ section.id }}">
        {%- for product in _bs_col.products limit: section.settings.products_to_show -%}
          {%- if product.price > 0 -%}
            {%- assign save_pct = 0 -%}
            {%- if product.compare_at_price > product.price -%}
              {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
            {%- endif -%}
            <div class="lf-bs-card">
              {% render 'wishlist-heart', product: product %}
              <a href="{{ product.url }}">
                <div class="lf-bs-img-wrap">
                  {%- if save_pct > 0 -%}<div class="lf-bs-badge">Save {{ save_pct }}%</div>{%- endif -%}
                  {%- if product.featured_image != blank -%}
                    <img src="{{ product.featured_image | image_url: width: 400 }}"
                         srcset="{{ product.featured_image | image_url: width: 200 }} 200w, {{ product.featured_image | image_url: width: 400 }} 400w"
                         sizes="(min-width:1200px) 17vw, (min-width:750px) 25vw, 50vw"
                         alt="{{ product.featured_image.alt | escape }}" class="lf-bs-img" loading="lazy">
                  {%- endif -%}
                </div>
              </a>
              <div class="lf-bs-info">
                <div class="lf-bs-vendor">{{ product.vendor }}</div>
                <a href="{{ product.url }}" class="lf-bs-title">{{ product.title }}</a>
                <div class="lf-bs-price-row">
                  <span class="lf-bs-price">{{ product.price | money }}</span>
                  {%- if save_pct > 0 -%}<span class="lf-bs-compare">{{ product.compare_at_price | money }}</span>{%- endif -%}
                </div>
              </div>
              {%- if product.available -%}
                <button class="lf-bs-atc js-lf-bs-atc-{{ section.id }}" data-variant="{{ product.first_available_variant.id }}">Add to Cart</button>
              {%- else -%}
                <button class="lf-bs-atc" disabled>Sold Out</button>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
        </div>
        <button type="button" class="lf-bs-arrow lf-bs-arrow--next js-lf-bs-next-{{ section.id }}" aria-label="Next products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
      </div>
    </div>
  </section>
</div>

<script>
(function(){
  var track=document.querySelector('.js-lf-bs-track-{{ section.id }}');
  var prev=document.querySelector('.js-lf-bs-prev-{{ section.id }}');
  var next=document.querySelector('.js-lf-bs-next-{{ section.id }}');
  if(!track) return;
  function step(){ return track.clientWidth * 0.85; }
  function update(){
    if(prev) prev.disabled = track.scrollLeft <= 4;
    if(next) next.disabled = track.scrollLeft >= (track.scrollWidth - track.clientWidth - 4);
  }
  if(prev) prev.addEventListener('click',function(){ track.scrollBy({left:-step(),behavior:'smooth'}); });
  if(next) next.addEventListener('click',function(){ track.scrollBy({left:step(),behavior:'smooth'}); });
  track.addEventListener('scroll',update,{passive:true});
  window.addEventListener('resize',update);
  update();
})();

document.querySelectorAll('.js-lf-bs-atc-{{ section.id }}').forEach(function(btn){
  btn.addEventListener('click',function(){
    var vid=this.dataset.variant,self=this;
    self.textContent='Adding...'; self.disabled=true;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:parseInt(vid),quantity:1}]})})
    .then(function(r){return r.json();}).then(function(){
      self.textContent='Added ✓';
      setTimeout(function(){self.textContent='Add to Cart';self.disabled=false;},2000);
    }).catch(function(){self.textContent='Error';setTimeout(function(){self.textContent='Add to Cart';self.disabled=false;},2000);});
  });
});
</script>

{% schema %}
{
  "name": "Bestsellers Grid",
  "tag": "div",
  "settings": [
    { "type": "text",       "id": "eyebrow",          "label": "Pre-heading",     "default": "Hand picked for you" },
    { "type": "text",       "id": "heading",           "label": "Heading",         "default": "Bestsellers" },
    { "type": "collection", "id": "collection",        "label": "Collection" },
    { "type": "range",      "id": "products_to_show",  "label": "Products to show", "min": 4, "max": 24, "step": 2, "default": 8 },
    { "type": "header",     "content": "Carousel layout" },
    { "type": "range",      "id": "products_per_row_desktop", "label": "Cards visible per row (desktop)", "min": 3, "max": 7, "step": 1, "default": 5 },
    { "type": "range",      "id": "products_per_row_mobile",  "label": "Cards visible per row (mobile)",  "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text",       "id": "view_all_label",    "label": "View all label",  "default": "View all" },
    { "type": "url",        "id": "view_all_link",     "label": "View all link" }
  ],
  "presets": [{ "name": "Bestsellers Grid" }]
}
{% endschema %}
