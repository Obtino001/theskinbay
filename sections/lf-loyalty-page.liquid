{% comment %}
  lf-loyalty-page.liquid
  TheSkinBay Luxury Loyalty Rewards Page
  All zones: Hero, Stats, How It Works, Ways to Earn, VIP Tiers,
             Refer a Friend, Testimonials, FAQ, Final CTA
{% endcomment %}

<style>
  :root {
    --lf-lp-gold: #C8A96A;
    --lf-lp-gold-light: rgba(200, 169, 106, 0.15);
    --lf-lp-gold-mid: rgba(200, 169, 106, 0.35);
    --lf-lp-cream: #F6F2EB;
    --lf-lp-black: #0c0c0c;
    --lf-lp-white: #ffffff;
    --lf-lp-dark: #1a1a0a;
    --lf-lp-text-muted: #666;
    --lf-lp-border: rgba(0,0,0,0.1);
    --lf-lp-transition: 0.35s ease;
  }

  /* ── Reset & base ─────────────────────────────────── */
  .lf-lp-section {
    box-sizing: border-box;
    font-family: 'Lato', sans-serif;
  }
  .lf-lp-section *,
  .lf-lp-section *::before,
  .lf-lp-section *::after {
    box-sizing: border-box;
  }
  .lf-lp-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .lf-lp-eyebrow {
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lf-lp-gold);
    display: block;
    margin-bottom: 12px;
  }
  .lf-lp-h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 20px;
  }
  .lf-lp-section-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .lf-lp-section-header p {
    font-size: 1rem;
    color: var(--lf-lp-text-muted);
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }
  .lf-lp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    font-family: 'Lato', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    transition: background var(--lf-lp-transition), color var(--lf-lp-transition), border-color var(--lf-lp-transition);
    cursor: pointer;
    border: 2px solid transparent;
    line-height: 1;
  }
  .lf-lp-btn-gold {
    background: var(--lf-lp-gold);
    color: var(--lf-lp-white);
    border-color: var(--lf-lp-gold);
  }
  .lf-lp-btn-gold:hover {
    background: #b8953a;
    border-color: #b8953a;
  }
  .lf-lp-btn-ghost-white {
    background: transparent;
    color: var(--lf-lp-white);
    border-color: var(--lf-lp-white);
  }
  .lf-lp-btn-ghost-white:hover {
    background: var(--lf-lp-white);
    color: var(--lf-lp-black);
  }
  .lf-lp-btn-ghost-black {
    background: transparent;
    color: var(--lf-lp-black);
    border-color: var(--lf-lp-black);
  }
  .lf-lp-btn-ghost-black:hover {
    background: var(--lf-lp-black);
    color: var(--lf-lp-white);
  }

  /* ── Reveal animation ─────────────────────────────── */
  .lf-lp-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .lf-lp-reveal.lf-lp-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ─────────────────────────────────────────────────── */
  /* HERO                                               */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: linear-gradient(160deg, var(--lf-lp-black) 0%, var(--lf-lp-dark) 60%, #0f0f00 100%);
  }
  .lf-lp-hero-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.18;
    z-index: 1;
  }
  .lf-lp-hero-grain {
    position: absolute;
    inset: 0;
    z-index: 2;
    background-image:
      radial-gradient(ellipse at 20% 50%, rgba(200,169,106,0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 30%, rgba(200,169,106,0.05) 0%, transparent 50%);
    pointer-events: none;
  }
  .lf-lp-hero-grain::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: 0.5;
    pointer-events: none;
  }
  .lf-lp-hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 120px 24px 80px;
    max-width: 800px;
    margin: 0 auto;
  }
  .lf-lp-hero .lf-lp-eyebrow {
    margin-bottom: 16px;
    font-size: 0.65rem;
  }
  .lf-lp-hero-h1 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    font-weight: 400;
    color: var(--lf-lp-white);
    line-height: 1.08;
    margin: 0 0 24px;
  }
  .lf-lp-hero-sub {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: rgba(255,255,255,0.72);
    line-height: 1.75;
    max-width: 560px;
    margin: 0 auto 40px;
  }
  .lf-lp-hero-ctas {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Floating pill badges */
  .lf-lp-hero-pills {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
  }
  .lf-lp-pill {
    position: absolute;
    background: rgba(200,169,106,0.12);
    border: 1px solid rgba(200,169,106,0.4);
    color: var(--lf-lp-gold);
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 8px 16px;
    border-radius: 100px;
    backdrop-filter: blur(4px);
    will-change: transform;
  }
  .lf-lp-pill-1 { top: 20%; left: 8%;  animation: lf-lp-float 5s ease-in-out infinite; }
  .lf-lp-pill-2 { top: 30%; right: 7%; animation: lf-lp-float 6s ease-in-out infinite 1s; }
  .lf-lp-pill-3 { bottom: 28%; left: 10%; animation: lf-lp-float 4.5s ease-in-out infinite 0.5s; }
  .lf-lp-pill-4 { bottom: 35%; right: 9%; animation: lf-lp-float 5.5s ease-in-out infinite 1.5s; }

  @keyframes lf-lp-float {
    0%,100% { transform: translateY(0px); }
    50%      { transform: translateY(-10px); }
  }

  @media (max-width: 749px) {
    .lf-lp-pill-1, .lf-lp-pill-3 { left: 3%; }
    .lf-lp-pill-2, .lf-lp-pill-4 { right: 3%; }
    .lf-lp-pill { font-size: 0.6rem; padding: 6px 12px; }
    .lf-lp-hero { min-height: 100svh; }
    .lf-lp-hero-content { padding: 100px 20px 60px; }
  }

  /* ─────────────────────────────────────────────────── */
  /* STATS BAR                                          */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-stats {
    background: var(--lf-lp-cream);
    border-top: 1px solid var(--lf-lp-border);
    border-bottom: 1px solid var(--lf-lp-border);
    padding: 0;
  }
  .lf-lp-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .lf-lp-stat-item {
    text-align: center;
    padding: 44px 24px;
    position: relative;
  }
  .lf-lp-stat-item + .lf-lp-stat-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 25%;
    height: 50%;
    width: 1px;
    background: var(--lf-lp-gold);
    opacity: 0.4;
  }
  .lf-lp-stat-number {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 400;
    color: var(--lf-lp-black);
    display: block;
    margin-bottom: 6px;
    line-height: 1;
  }
  .lf-lp-stat-label {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lf-lp-text-muted);
  }

  @media (max-width: 899px) {
    .lf-lp-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .lf-lp-stat-item:nth-child(3)::before { display: none; }
    .lf-lp-stat-item:nth-child(3) {
      border-top: 1px solid rgba(200,169,106,0.3);
    }
    .lf-lp-stat-item:nth-child(4) {
      border-top: 1px solid rgba(200,169,106,0.3);
    }
  }
  @media (max-width: 749px) {
    .lf-lp-stats-grid { grid-template-columns: 1fr 1fr; }
    .lf-lp-stat-item { padding: 32px 16px; }
  }

  /* ─────────────────────────────────────────────────── */
  /* HOW IT WORKS                                       */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-how {
    background: var(--lf-lp-white);
    padding: 96px 0;
  }
  .lf-lp-how-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .lf-lp-how-card {
    border: 1px solid rgba(0,0,0,0.08);
    padding: 36px 28px 32px;
    position: relative;
    transition: transform var(--lf-lp-transition), box-shadow var(--lf-lp-transition);
  }
  .lf-lp-how-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.08);
  }
  .lf-lp-how-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--lf-lp-gold);
    color: var(--lf-lp-white);
    font-family: 'Lato', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .lf-lp-how-title {
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--lf-lp-black);
    margin: 0 0 10px;
  }
  .lf-lp-how-desc {
    font-size: 0.9rem;
    color: var(--lf-lp-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 899px) {
    .lf-lp-how-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    .lf-lp-how { padding: 64px 0; }
    .lf-lp-how-grid { grid-template-columns: 1fr; gap: 16px; }
  }

  /* ─────────────────────────────────────────────────── */
  /* WAYS TO EARN                                       */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-earn {
    background: var(--lf-lp-cream);
    padding: 96px 0;
  }
  .lf-lp-earn-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .lf-lp-earn-card {
    background: var(--lf-lp-white);
    padding: 36px 28px;
    position: relative;
    transition: transform var(--lf-lp-transition), box-shadow var(--lf-lp-transition);
  }
  .lf-lp-earn-card:hover {
    transform: scale(1.02);
    box-shadow: 0 20px 48px rgba(0,0,0,0.1);
  }
  .lf-lp-earn-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    color: var(--lf-lp-gold);
  }
  .lf-lp-earn-icon svg {
    width: 100%;
    height: 100%;
  }
  .lf-lp-earn-pts {
    position: absolute;
    top: 24px;
    right: 24px;
    background: var(--lf-lp-gold-light);
    border: 1px solid var(--lf-lp-gold-mid);
    color: var(--lf-lp-gold);
    font-family: 'Lato', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
  }
  .lf-lp-earn-title {
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--lf-lp-black);
    margin: 0 0 10px;
  }
  .lf-lp-earn-desc {
    font-size: 0.9rem;
    color: var(--lf-lp-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 899px) {
    .lf-lp-earn-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 749px) {
    .lf-lp-earn { padding: 64px 0; }
    .lf-lp-earn-grid { grid-template-columns: 1fr; }
  }

  /* ─────────────────────────────────────────────────── */
  /* VIP TIERS                                          */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-tiers {
    background: var(--lf-lp-black);
    padding: 96px 0;
  }
  .lf-lp-tiers .lf-lp-section-header { margin-bottom: 56px; }
  .lf-lp-tiers .lf-lp-h2 { color: var(--lf-lp-white); }
  .lf-lp-tiers .lf-lp-section-header p { color: rgba(255,255,255,0.55); }
  .lf-lp-tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: start;
  }
  .lf-lp-tier-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 44px 32px 40px;
    position: relative;
    transition: border-color var(--lf-lp-transition), transform var(--lf-lp-transition);
  }
  .lf-lp-tier-card:hover {
    border-color: rgba(200,169,106,0.4);
    transform: translateY(-3px);
  }
  .lf-lp-tier-card.lf-lp-tier-featured {
    border: 2px solid var(--lf-lp-gold);
    background: rgba(200,169,106,0.06);
    transform: translateY(-8px);
  }
  .lf-lp-tier-card.lf-lp-tier-featured:hover { transform: translateY(-12px); }
  .lf-lp-tier-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--lf-lp-gold);
    color: var(--lf-lp-white);
    font-family: 'Lato', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 14px;
    white-space: nowrap;
  }
  .lf-lp-tier-icon {
    font-size: 2rem;
    margin-bottom: 16px;
    display: block;
    line-height: 1;
  }
  .lf-lp-tier-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--lf-lp-white);
    margin: 0 0 6px;
  }
  .lf-lp-tier-range {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lf-lp-gold);
    display: block;
    margin-bottom: 20px;
  }
  .lf-lp-tier-spend {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.4);
    font-style: italic;
    margin-bottom: 24px;
    display: block;
  }
  .lf-lp-tier-perks {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
  }
  .lf-lp-tier-perks li {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding-left: 20px;
    position: relative;
  }
  .lf-lp-tier-perks li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--lf-lp-gold);
    font-size: 0.5rem;
    top: 12px;
  }
  .lf-lp-tier-perks li:last-child { border-bottom: none; }

  @media (max-width: 899px) {
    .lf-lp-tiers-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
    .lf-lp-tier-card.lf-lp-tier-featured { transform: none; }
    .lf-lp-tier-card.lf-lp-tier-featured:hover { transform: translateY(-3px); }
  }
  @media (max-width: 749px) {
    .lf-lp-tiers { padding: 64px 0; }
  }

  /* ─────────────────────────────────────────────────── */
  /* REFER A FRIEND                                     */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-refer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 520px;
  }
  .lf-lp-refer-left {
    background: var(--lf-lp-black);
    padding: 80px 64px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .lf-lp-refer-left .lf-lp-h2 { color: var(--lf-lp-white); margin-bottom: 20px; }
  .lf-lp-refer-left p {
    font-size: 1rem;
    color: rgba(255,255,255,0.65);
    line-height: 1.75;
    margin: 0 0 36px;
    max-width: 400px;
  }
  .lf-lp-refer-right {
    background: var(--lf-lp-cream);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lf-lp-refer-deco {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(8rem, 18vw, 16rem);
    font-weight: 400;
    color: var(--lf-lp-gold);
    opacity: 0.14;
    position: absolute;
    line-height: 1;
    user-select: none;
    pointer-events: none;
  }
  .lf-lp-refer-visual {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 40px;
  }
  .lf-lp-refer-card {
    background: var(--lf-lp-white);
    border: 1px solid rgba(0,0,0,0.08);
    padding: 32px 40px;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
  }
  .lf-lp-refer-card-amount {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 3.5rem;
    color: var(--lf-lp-gold);
    display: block;
    line-height: 1;
    margin-bottom: 8px;
  }
  .lf-lp-refer-card-label {
    font-family: 'Lato', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lf-lp-text-muted);
  }
  .lf-lp-refer-card-divider {
    width: 40px;
    height: 1px;
    background: var(--lf-lp-gold);
    margin: 16px auto;
    opacity: 0.4;
  }

  @media (max-width: 899px) {
    .lf-lp-refer { grid-template-columns: 1fr; }
    .lf-lp-refer-left { padding: 60px 32px; }
    .lf-lp-refer-right { min-height: 320px; }
  }
  @media (max-width: 749px) {
    .lf-lp-refer-left { padding: 56px 24px; }
  }

  /* ─────────────────────────────────────────────────── */
  /* TESTIMONIALS                                       */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-reviews {
    background: var(--lf-lp-white);
    padding: 96px 0;
  }
  .lf-lp-reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .lf-lp-review-card {
    border: 1px solid rgba(0,0,0,0.07);
    padding: 36px 32px;
    position: relative;
  }
  .lf-lp-review-quote {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 4rem;
    color: var(--lf-lp-gold);
    line-height: 0.5;
    opacity: 0.5;
    margin-bottom: 16px;
    display: block;
  }
  .lf-lp-review-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 16px;
    color: var(--lf-lp-gold);
  }
  .lf-lp-review-stars svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .lf-lp-review-text {
    font-size: 0.925rem;
    color: #333;
    line-height: 1.75;
    margin: 0 0 24px;
    font-style: italic;
  }
  .lf-lp-review-author {
    font-family: 'Lato', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lf-lp-black);
    margin-bottom: 6px;
  }
  .lf-lp-review-tier-badge {
    display: inline-block;
    background: var(--lf-lp-gold-light);
    border: 1px solid var(--lf-lp-gold-mid);
    color: var(--lf-lp-gold);
    font-family: 'Lato', sans-serif;
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 100px;
  }

  @media (max-width: 899px) {
    .lf-lp-reviews-grid { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; }
  }
  @media (max-width: 749px) {
    .lf-lp-reviews { padding: 64px 0; }
  }

  /* ─────────────────────────────────────────────────── */
  /* FAQ                                                */
  /* ─────────────────────────────────────────────────── */
  .lf-lp-faq {
    background: var(--lf-lp-cream);
    padding: 96px 0;
  }
  .lf-lp-faq-list {
    max-width: 760px;
    margin: 0 auto;
  }
