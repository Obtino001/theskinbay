    margin-bottom: -1px;
  }
  .lf-lp-faq-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1;
    transition: transform var(--lf-lp-transition);
