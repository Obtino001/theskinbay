<script>
(function () {
  'use strict';

  // ── Scroll reveal ────────────────────────────────────
  var reveals = document.querySelectorAll('.lf-lp-reveal');
  if ('IntersectionObserver' in window) {
    var revealObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('lf-lp-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    reveals.forEach(function (el) {
      revealObserver.observe(el);
    });
  } else {
    // Fallback: show all immediately
    reveals.forEach(function (el) {
      el.classList.add('lf-lp-visible');
    });
  }

  // ── FAQ accordion ────────────────────────────────────
  var faqItems = document.querySelectorAll('.lf-lp-faq-item');
  faqItems.forEach(function (item) {
    var btn = item.querySelector('.lf-lp-faq-question');
    var answer = item.querySelector('.lf-lp-faq-answer');
    if (!btn || !answer) return;

    btn.addEventListener('click', function () {
      var isOpen = item.classList.contains('lf-lp-faq-open');

      // Close all open items
      faqItems.forEach(function (other) {
        if (other !== item) {
          other.classList.remove('lf-lp-faq-open');
          var otherBtn = other.querySelector('.lf-lp-faq-question');
          if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
        }
      });

      // Toggle current
      if (isOpen) {
        item.classList.remove('lf-lp-faq-open');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('lf-lp-faq-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();
</script>

