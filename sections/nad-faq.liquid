{%- comment -%} NAD bespoke, FAQ accordion (+ FAQPage JSON-LD) {%- endcomment -%}
<section class="nad-faq" style="background:{{ section.settings.bg }};">
  <div class="nadfq-wrap">
    <h2 style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;padding:0;margin:-1px;border:0;">Your questions answered</h2>
    <img class="nad-header-img" src="{{ section.settings.header_image | default: 'nad-h-faq.png' | asset_url }}" alt="Your questions answered" loading="lazy" width="1500" height="340">
    <div class="nadfq-list">
      {%- for block in section.blocks -%}
        <details class="nadfq-item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
          <summary>{{ block.settings.q }}<span class="nadfq-plus"></span></summary>
          <div class="nadfq-a">{{ block.settings.a }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context":"https://schema.org","@type":"FAQPage","mainEntity":[
  {%- for block in section.blocks -%}
  {"@type":"Question","name":{{ block.settings.q | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.a | strip_html | json }}}}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  ]
}
</script>
{%- endif -%}
<style>
  .nad-faq{padding:56px 20px;}
  .nadfq-wrap{max-width:820px;margin:0 auto;}
  .nad-faq .nad-header-img{max-width:520px;margin-bottom:22px;}
  .nadfq-list{background:var(--box,#FBF6EA);border:1px solid var(--boxline,#ECE3CE);border-radius:22px;padding:4px 30px;}
  .nadfq-item{border-bottom:1px solid var(--boxline,#ECE3CE);}
  .nadfq-item:last-child{border-bottom:none;}
  .nadfq-item summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:22px 2px;font-family:'Playfair Display',serif;font-size:18px;color:#141414;}
  .nadfq-item summary::-webkit-details-marker{display:none;}
  .nadfq-plus{position:relative;flex:0 0 20px;width:20px;height:20px;}
  .nadfq-plus:before,.nadfq-plus:after{content:"";position:absolute;background:#141414;left:50%;top:50%;transform:translate(-50%,-50%);}
  .nadfq-plus:before{width:16px;height:2.5px;}
  .nadfq-plus:after{width:2.5px;height:16px;transition:transform .2s ease;}
  .nadfq-item[open] .nadfq-plus:after{transform:translate(-50%,-50%) scaleY(0);}
  .nadfq-a{font-family:'Lato',sans-serif;font-size:15.5px;line-height:1.7;color:#141414;padding:0 2px 22px;}
  .nadfq-a p{margin:0 0 12px;}
  @media(max-width:749px){.nad-faq{padding:38px 16px;}.nadfq-item summary{font-size:16px;}}
</style>
{% schema %}
{
  "name": "NAD · FAQ",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6C21A" },
    { "type": "text", "id": "header_image", "label": "Header image file (blank = default)" }
  ],
  "blocks": [
    { "type": "qa", "name": "Q&A", "settings": [
      { "type": "text", "id": "q", "label": "Question", "default": "Is NAD+ safe to use at home?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Yes, when used as directed. Each kit is produced in ISO-certified labs, batch-tested for purity, and includes everything for hygienic self-administration plus a step-by-step guide. Always follow the instructions and consult your practitioner first if you're pregnant, breastfeeding or managing a health condition.</p>" }
    ]}
  ],
  "presets": [{ "name": "NAD · FAQ", "blocks": [
    { "type": "qa", "settings": { "q": "Is NAD+ safe to use at home?", "a": "<p>Yes, when used as directed. Each kit is produced in ISO-certified labs, batch-tested for purity, and includes everything for hygienic self-administration plus a step-by-step guide. Always consult your practitioner first if you're pregnant, breastfeeding or managing a health condition.</p>" } },
    { "type": "qa", "settings": { "q": "How soon will I feel a difference?", "a": "<p>Many people report increased energy and focus within the first week. NAD+ works best taken consistently over the full protocol.</p>" } },
    { "type": "qa", "settings": { "q": "How often do I take it?", "a": "<p>Begin with one 0.25ml dose (50mg) daily for the first three days, then continue on alternate days for around five weeks. Each vial holds roughly 20 doses.</p>" } },
    { "type": "qa", "settings": { "q": "Why injection instead of a capsule?", "a": "<p>Subcutaneous delivery bypasses the digestive system, where much of an oral dose is broken down. That gives NAD+ close to 100% bioavailability so cells can use it straight away.</p>" } },
    { "type": "qa", "settings": { "q": "How do I store it?", "a": "<p>Refrigerate the vial as soon as it arrives to keep it pure and stable. Rotate injection sites and use a fresh sterile syringe each time.</p>" } },
    { "type": "qa", "settings": { "q": "How is it delivered?", "a": "<p>Discreetly and tracked across the UK. A Certificate of Analysis is available on request.</p>" } }
  ]}]
}
{% endschema %}
