{%- comment -%} Slim VIP promo band for product pages — hidden for existing VIP members {%- endcomment -%}
{%- unless customer and customer.tags contains 'VIP' -%}
<section class="nvp" style="--nvp-bg1:{{ section.settings.bg1 }};--nvp-bg2:{{ section.settings.bg2 }};--nvp-gold:{{ section.settings.gold }};">
  <div class="nvp-wrap">
    <div class="nvp-txt">
      {%- if section.settings.eyebrow != blank -%}<span class="nvp-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h3 class="nvp-h">{{ section.settings.heading }}</h3>
      {%- if section.settings.subtext != blank -%}<p class="nvp-sub">{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
    <a class="nvp-btn" href="{{ section.settings.link | default: '/products/theskinbay-vip-club-exclusive-premium-gift-set' }}">{{ section.settings.btn | default: 'Become a VIP' }}</a>
  </div>
</section>
<style>
  .nvp{background:linear-gradient(135deg,var(--nvp-bg1,#0b1c3e) 0%,var(--nvp-bg2,#050e1f) 100%);border-top:3px solid var(--nvp-gold,#d4af37);border-bottom:3px solid var(--nvp-gold,#d4af37);padding:26px 20px;}
  .nvp-wrap{max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:28px;flex-wrap:wrap;}
  .nvp-txt{flex:1;min-width:260px;}
  .nvp-eyebrow{display:block;font-family:'Lato',sans-serif;font-size:11px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--nvp-gold,#d4af37);margin-bottom:8px;}
  .nvp-h{font-family:'Playfair Display',Georgia,serif;font-size:clamp(20px,2.6vw,28px);font-weight:600;color:#fff;margin:0;line-height:1.15;}
  .nvp-sub{font-family:'Lato',sans-serif;font-size:14.5px;line-height:1.55;color:rgba(255,255,255,.82);margin:8px 0 0;max-width:640px;}
  .nvp-btn{flex:0 0 auto;background:var(--nvp-gold,#d4af37);color:#0b1c3e;font-family:'Lato',sans-serif;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:15px 34px;border-radius:40px;text-decoration:none;white-space:nowrap;transition:transform .15s ease,filter .2s ease;box-shadow:0 6px 18px rgba(0,0,0,.28);}
  .nvp-btn:hover{transform:translateY(-1px);filter:brightness(1.06);}
  @media(max-width:749px){.nvp{padding:22px 16px;}.nvp-wrap{flex-direction:column;align-items:flex-start;gap:16px;}.nvp-btn{width:100%;text-align:center;}}
</style>
{%- endunless -%}
{% schema %}
{
  "name": "VIP promo band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Skin Bay VIP Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Want a whole year of free shipping?" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Become a VIP and get unlimited free delivery for 12 months, plus a welcome gift worth more than you pay. Exclusive, and one of the best deals we offer." },
    { "type": "text", "id": "btn", "label": "Button label", "default": "Become a VIP" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "color", "id": "bg1", "label": "Background start", "default": "#0b1c3e" },
    { "type": "color", "id": "bg2", "label": "Background end", "default": "#050e1f" },
    { "type": "color", "id": "gold", "label": "Gold accent", "default": "#d4af37" }
  ],
  "presets": [{ "name": "VIP promo band" }]
}
{% endschema %}
