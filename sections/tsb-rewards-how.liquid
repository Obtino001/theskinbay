<style>
  .tsb-rhow *.tsb-rhow *::before.tsb-rhow *::after { box-sizing: border-box; }

  .tsb-rhow-section {
    background: #fff;
    padding: 88px 0;
    border-top: 1px solid rgba(0,0,0,0.06);
  }
  .tsb-rhow-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .tsb-rhow-header {
    text-align: center;
    margin-bottom: 64px;
  }
  .tsb-rhow-eyebrow {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(0,0,0,0.35);
    display: block;
    margin-bottom: 10px;
  }
  .tsb-rhow-h2 {
    font-family: var(--font-heading--family), serif;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 400;
    color: #000;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .tsb-rhow-steps {
    display: grid;
    grid-template-columns: 1fr 40px 1fr 40px 1fr;
    align-items: center;
    gap: 0;
  }
  .tsb-rhow-step {
    text-align: center;
    padding: 0 24px;
  }
  .tsb-rhow-badge {
    position: relative;
    width: 78px;
    height: 78px;
    border: 1px solid #000;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 22px;
  }
  .tsb-rhow-badge svg { width: 34px; height: 34px; color: #000; display: block; }
  .tsb-rhow-badge .tsb-rhow-n {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #000;
    color: #fff;
    font-family: var(--font-heading--family), serif;
    font-size: 0.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tsb-rhow-step-title {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #000;
    margin: 0 0 12px;
    display: block;
  }
  .tsb-rhow-step-desc {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.9rem;
    color: rgba(0,0,0,0.52);
    line-height: 1.75;
    margin: 0;
  }
  .tsb-rhow-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(0,0,0,0.2);
    flex-shrink: 0;
  }
  .tsb-rhow-divider svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  @media (max-width: 899px) {
    .tsb-rhow-steps {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .tsb-rhow-divider { display: none; }
    .tsb-rhow-step { padding: 0; }
  }
  @media (max-width: 599px) {
    .tsb-rhow-section { padding: 60px 0; }
    .tsb-rhow-inner { padding: 0 20px; }
  }
</style>

<section class="tsb-rhow-section">
  <div class="tsb-rhow-inner">
    <div class="tsb-rhow-header">
      {%- render 'sb-brand-heading', image: 'rwd-h-how.png', text: 'How It Works', tag: 'h2', max: 420 -%}
    </div>
    <div class="tsb-rhow-steps">

      <div class="tsb-rhow-step">
        <div class="tsb-rhow-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.6 19c0-3 2.4-5.2 5.4-5.2 1.3 0 2.5.4 3.4 1.1"/><path d="M18 6.6v5M15.5 9.1h5"/></svg>
          <span class="tsb-rhow-n">1</span>
        </div>
        <span class="tsb-rhow-step-title">{{ section.settings.s1_title | default: 'Join' }}</span>
        <p class="tsb-rhow-step-desc">{{ section.settings.s1_desc | default: 'Create a free account to become a member instantly. No fees. No commitments.' }}</p>
      </div>

      <div class="tsb-rhow-divider" aria-hidden="true">
        <svg viewBox="0 0 20 20"><path d="M5 10h10M11 6l4 4-4 4"/></svg>
      </div>

      <div class="tsb-rhow-step">
        <div class="tsb-rhow-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5l2.6 5.27 5.82.85-4.21 4.1.99 5.8L12 16.77 6.8 19.5l.99-5.8-4.21-4.1 5.82-.85z"/></svg>
          <span class="tsb-rhow-n">2</span>
        </div>
        <span class="tsb-rhow-step-title">{{ section.settings.s2_title | default: 'Earn' }}</span>
        <p class="tsb-rhow-step-desc">{{ section.settings.s2_desc | default: 'Accumulate points with every order. Points are credited automatically after each purchase.' }}</p>
      </div>

      <div class="tsb-rhow-divider" aria-hidden="true">
        <svg viewBox="0 0 20 20"><path d="M5 10h10M11 6l4 4-4 4"/></svg>
      </div>

      <div class="tsb-rhow-step">
        <div class="tsb-rhow-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M4 13h16M12 9v11"/><path d="M12 9C12 6.9 10.8 5.5 9.3 5.5c-1.1 0-1.9.8-1.9 1.8C7.4 8.6 9 9 12 9Zm0 0c0-2.1 1.2-3.5 2.7-3.5 1.1 0 1.9.8 1.9 1.8C16.6 8.6 15 9 12 9Z"/></svg>
          <span class="tsb-rhow-n">3</span>
        </div>
        <span class="tsb-rhow-step-title">{{ section.settings.s3_title | default: 'Redeem' }}</span>
        <p class="tsb-rhow-step-desc">{{ section.settings.s3_desc | default: 'Convert your points into vouchers and apply them directly at checkout on your next order.' }}</p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rewards, How It Works",
  "tag": "div",
  "settings": [
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow",        "default": "Simple & Rewarding" },
    { "type": "text",     "id": "heading",  "label": "Heading",         "default": "How It Works" },
    { "type": "header",   "content": "Step 1" },
    { "type": "text",     "id": "s1_title", "label": "Title",           "default": "Join" },
    { "type": "textarea", "id": "s1_desc",  "label": "Description",     "default": "Create a free account to become a member instantly. No fees. No commitments." },
    { "type": "header",   "content": "Step 2" },
    { "type": "text",     "id": "s2_title", "label": "Title",           "default": "Earn" },
    { "type": "textarea", "id": "s2_desc",  "label": "Description",     "default": "Accumulate points with every order. Points are credited automatically after each purchase." },
    { "type": "header",   "content": "Step 3" },
    { "type": "text",     "id": "s3_title", "label": "Title",           "default": "Redeem" },
    { "type": "textarea", "id": "s3_desc",  "label": "Description",     "default": "Convert your points into vouchers and apply them directly at checkout on your next order." }
  ],
  "presets": [{ "name": "Rewards, How It Works" }]
}
{% endschema %}
