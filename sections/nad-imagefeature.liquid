{%- comment -%} NAD bespoke, editorial product-image feature (pulls product.images by index) {%- endcomment -%}
{%- assign img = product.images[section.settings.image_index] -%}
{%- unless img -%}{%- unless section.settings.require_image -%}{%- assign img = product.featured_image -%}{%- endunless -%}{%- endunless -%}
{%- assign img2 = null -%}{%- if section.settings.stack_two -%}{%- assign i2 = section.settings.image_index | plus: 1 -%}{%- assign img2 = product.images[i2] -%}{%- endif -%}
{%- if img != blank -%}
<section class="nad-imgf nad-imgf--{{ section.settings.layout }}" style="background:{{ section.settings.bg }};--onbg:{{ section.settings.on_bg | default: '#141414' }};">
  <div class="nadif-wrap">
    {%- if img -%}
      <figure class="nadif-media{% if img2 != blank %} nadif-media--two{% endif %}">
        <img src="{{ img | image_url: width: 1400 }}" srcset="{{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1100 }} 1100w, {{ img | image_url: width: 1400 }} 1400w" sizes="(min-width:750px) 50vw, 92vw" alt="{{ img.alt | default: product.title | escape }}" loading="lazy" width="{{ img.width }}" height="{{ img.height }}">
        {%- if img2 != blank -%}<img src="{{ img2 | image_url: width: 1100 }}" srcset="{{ img2 | image_url: width: 550 }} 550w, {{ img2 | image_url: width: 1100 }} 1100w" sizes="(min-width:750px) 50vw, 92vw" alt="{{ img2.alt | default: product.title | escape }}" loading="lazy" width="{{ img2.width }}" height="{{ img2.height }}">{%- endif -%}
      </figure>
    {%- endif -%}
    {%- if section.settings.heading != blank or section.settings.body != blank -%}
      <div class="nadif-text">
        {%- if section.settings.eyebrow != blank -%}<span class="nadif-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="nadif-h">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="nadif-b">{{ section.settings.body }}</div>{%- endif -%}
      </div>
    {%- elsif section.settings.caption != blank -%}
      <figcaption class="nadif-cap">{{ section.settings.caption }}</figcaption>
    {%- endif -%}
  </div>
</section>
<style>
  .nad-imgf{padding:44px 20px;}
  .nadif-wrap{max-width:1140px;margin:0 auto;display:grid;gap:40px;align-items:center;}
  .nadif-media{margin:0;background:var(--box,#FBF6EA);border-radius:22px;padding:18px;overflow:hidden;}
  .nadif-media img{display:block;width:100%;height:auto;max-height:560px;object-fit:cover;border-radius:12px;}
  .nadif-media--two{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .nadif-media--two img{max-height:340px;aspect-ratio:1/1;}
  .nadif-eyebrow{display:block;font-family:var(--font-body--family), sans-serif;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--onbg);margin-bottom:12px;}
  .nadif-h{font-family:var(--font-heading--family), serif;font-size:30px;line-height:1.15;color:var(--onbg);margin:0 0 14px;}
  .nadif-b{font-family:var(--font-body--family), sans-serif;font-size:16px;line-height:1.7;color:var(--onbg);}
  .nadif-b p{margin:0 0 12px;}
  .nadif-cap{font-family:var(--font-body--family), sans-serif;font-size:13px;letter-spacing:.04em;color:var(--onbg);text-align:center;margin-top:16px;}
  /* full-width image, optional centered caption */
  .nad-imgf--full .nadif-wrap{grid-template-columns:1fr;max-width:620px;}
  /* image + text side by side */
  .nad-imgf--left .nadif-wrap,.nad-imgf--right .nadif-wrap{grid-template-columns:1fr 1fr;}
  .nad-imgf--right .nadif-media{order:2;}
  @media(max-width:849px){.nad-imgf--left .nadif-wrap,.nad-imgf--right .nadif-wrap{grid-template-columns:1fr;}.nad-imgf--right .nadif-media{order:0;}.nadif-h{font-size:24px;}}
</style>
{%- endif -%}
{% schema %}
{
  "name": "NAD · Image feature",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6C21A" },
    { "type": "color", "id": "on_bg", "label": "Text on background", "default": "#141414" },
    { "type": "range", "id": "image_index", "min": 0, "max": 15, "step": 1, "label": "Product image #", "default": 1 },
    { "type": "checkbox", "id": "require_image", "label": "Hide if this image is missing", "default": false },
    { "type": "checkbox", "id": "stack_two", "label": "Show a second image if available", "default": false },
    { "type": "select", "id": "layout", "label": "Layout", "default": "full",
      "options": [{"value":"full","label":"Full width"},{"value":"left","label":"Image left + text"},{"value":"right","label":"Image right + text"}] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "caption", "label": "Caption (full-width only)" }
  ],
  "presets": [{ "name": "NAD · Image feature" }]
}
{% endschema %}
