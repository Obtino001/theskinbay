{%- comment -%} Brands directory, shoppable brand index with featured product carousels {%- endcomment -%}
{%- liquid
  assign brand = 'avene::Avène,caromed-italia::Caromed Italia,cebelia::Cébélia,cerave::CeraVe,cliniccare::ClinicCare,heliocare::Heliocare,jane-iredale::Jane Iredale,la-roche-posay::La Roche-Posay,medik8::Medik8,nad-home::NAD+ At Home,olaplex::Olaplex,skinade::Skinade,skinceuticals::SkinCeuticals,vichy::Vichy,vita-liberata::Vita Liberata,voya::Voya,amalian::Amalian'
  assign brand_arr = brand | split: ','
  assign featured = 'cliniccare::ClinicCare,skinceuticals::SkinCeuticals,medik8::Medik8,nad-home::NAD+ At Home'
  assign featured_arr = featured | split: ','
-%}

<section class="bd" data-section-id="{{ section.id }}">
  <div class="bd-inner">

    <header class="bd-hero">
      <p class="bd-eyebrow">The Skin Bay</p>
      <h1 class="bd-title">Brands</h1>
      <p class="bd-lede">Clinic-backed, results-driven skincare from the brands the experts trust. Explore every label we carry.</p>
    </header>

    {%- comment -%} ---- FOUNDER BRAND PICKS ---- {%- endcomment -%}
    <div class="bd-founder">
      <div class="bd-founder-photo"><img src="{{ 'email-founder-emmalee.jpg' | asset_url }}" alt="Emmalee Fitton, Founder of The Skin Bay" width="140" height="140" loading="lazy"></div>
      <div class="bd-founder-body">
        <p class="bd-founder-kicker">Founder Brand Picks</p>
        <p class="bd-founder-name">Emmalee</p>
        <p class="bd-founder-quote">I chose these brands for different reasons as I grew within my own skincare journey, with each one having a special reason for featuring in The Skin Bay&rsquo;s catalogue. Whether special to me or purely results-driven, every product has earned the right to shine with The Skin Bay.</p>
      </div>
    </div>

    {%- comment -%} ---- ALL BRANDS (image grid) ---- {%- endcomment -%}
    <div class="bd-group">
      <div class="bd-group-head"><div><span class="bd-kicker">Shop</span><h2 class="bd-h2">All Brands</h2></div></div>
      <div class="bd-tiles">
        {%- for it in brand_arr -%}
          {%- assign p = it | split: '::' -%}{%- assign h = p[0] -%}{%- assign lbl = p[1] -%}
          {%- assign col = collections[h] -%}
          {%- if col != empty -%}
            {%- assign img = col.image -%}{%- unless img -%}{%- assign img = col.products.first.featured_image -%}{%- endunless -%}
            <a class="bd-tile" href="/collections/{{ h }}">
              <span class="bd-tile-img">{% if img %}<img src="{{ img | image_url: width: 500 }}" alt="{{ lbl }}" loading="lazy" width="500" height="500">{% endif %}</span>
              <span class="bd-tile-label">{{ lbl }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---- FEATURED BRAND PRODUCT CAROUSELS ---- {%- endcomment -%}
    {%- for it in featured_arr -%}
      {%- assign p = it | split: '::' -%}{%- assign h = p[0] -%}{%- assign lbl = p[1] -%}
      {%- assign col = collections[h] -%}
      {%- if col != empty and col.products.size > 0 -%}
        <div class="bd-group">
          <div class="bd-group-head">
            <div><span class="bd-kicker">Featured Brand</span><h2 class="bd-h2">{{ lbl }}</h2></div>
            <a class="bd-shopall" href="/collections/{{ h }}">Shop all &#8250;</a>
          </div>
          <div class="bd-carousel">
            <button class="bd-arrow bd-prev" type="button" aria-label="Scroll left" data-dir="-1">&#8249;</button>
            <div class="bd-prow" data-track>
              {%- for product in col.products limit: 14 -%}
                <a class="bd-pcard" href="{{ product.url }}">
                  <span class="bd-pimg">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title | escape }}" loading="lazy" width="400" height="400">{% endif %}
                    {%- if product.compare_at_price > product.price -%}<span class="bd-badge">Sale</span>{%- endif -%}
                  </span>
                  <span class="bd-pvendor">{{ product.vendor }}</span>
                  <span class="bd-ptitle">{{ product.title }}</span>
                  <span class="bd-pprice">
                    {%- if product.price_varies -%}From {{ product.price_min | money }}
                    {%- else -%}{{ product.price | money }}{%- endif -%}
                    {%- if product.compare_at_price > product.price -%}<s class="bd-was">{{ product.compare_at_price | money }}</s>{%- endif -%}
                  </span>
                </a>
              {%- endfor -%}
            </div>
            <button class="bd-arrow bd-next" type="button" aria-label="Scroll right" data-dir="1">&#8250;</button>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>
</section>

<style>
  .bd{background:#fff;color:#141414;}
  .bd-inner{max-width:1280px;margin:0 auto;padding:48px 24px 72px;}
  .bd-hero{text-align:center;margin-bottom:44px;}
  .bd-eyebrow{font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:12px;color:#8a8377;margin:0 0 10px;}
  .bd-title{font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:clamp(34px,5vw,56px);line-height:1.05;margin:0 0 14px;}
  .bd-lede{font-family:'Lato',sans-serif;font-size:16px;line-height:1.6;color:#5c574e;max-width:640px;margin:0 auto;}
  /* founder note */
  .bd-founder{display:flex;gap:24px;align-items:center;background:#F9F3ED;border-radius:10px;padding:24px 30px;margin-bottom:40px;}
  .bd-founder-photo{flex:0 0 auto;}
  .bd-founder-photo img{width:104px;height:104px;border-radius:50%;object-fit:cover;display:block;}
  .bd-founder-kicker{font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:12px;color:#8a8377;margin:0 0 2px;}
  .bd-founder-name{font-family:'Playfair Display',cursive;font-weight:700;font-size:22px;line-height:1;color:#141414;margin:0 0 7px;}
  .bd-founder-quote{font-family:'Lato',sans-serif;font-style:italic;font-size:15.5px;line-height:1.65;color:#413d36;margin:0;max-width:780px;}
  @media (max-width:749px){
    .bd-founder{flex-direction:column;text-align:center;padding:28px 20px;gap:18px;}
    .bd-founder-photo img{width:118px;height:118px;}
    .bd-founder-quote{font-size:14.5px;}
  }
  .bd-group{margin-bottom:52px;}
  .bd-group-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid #ece7df;}
  .bd-kicker{display:block;font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.2em;font-size:11px;color:#a49c8d;margin-bottom:6px;}
  .bd-h2{font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:clamp(24px,3vw,34px);margin:0;line-height:1;}
  .bd-shopall{font-family:'Lato',sans-serif;font-size:12px;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;color:#141414;white-space:nowrap;padding-bottom:2px;border-bottom:1px solid #141414;}
  .bd-shopall:hover{color:#8a8377;border-color:#8a8377;}
  /* brand grid */
  .bd-tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:18px;}
  .bd-tile{display:flex;flex-direction:column;text-decoration:none;color:#141414;}
  .bd-tile-img{aspect-ratio:1/1;background:#f5f1ea;overflow:hidden;border-radius:6px;}
  .bd-tile-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;}
  .bd-tile:hover .bd-tile-img img{transform:scale(1.05);}
  .bd-tile-label{font-family:'Lato',sans-serif;font-size:14px;font-weight:600;margin-top:11px;text-align:center;}
  /* product carousel */
  .bd-carousel{position:relative;}
  .bd-prow{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:2px 2px 10px;scrollbar-width:none;-ms-overflow-style:none;}
  .bd-prow::-webkit-scrollbar{display:none;}
  .bd-pcard{flex:0 0 210px;scroll-snap-align:start;text-decoration:none;color:#141414;display:flex;flex-direction:column;}
  .bd-pimg{position:relative;aspect-ratio:1/1;background:#fff;border:1px solid #efeae1;border-radius:6px;overflow:hidden;}
  .bd-pimg img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;}
  .bd-pcard:hover .bd-pimg img{transform:scale(1.05);}
  .bd-badge{position:absolute;top:10px;left:10px;background:#7a1f1f;color:#fff;font-family:'Lato',sans-serif;font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:4px 9px;border-radius:3px;}
  .bd-pvendor{font-family:'Lato',sans-serif;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#a49c8d;margin-top:11px;}
  .bd-ptitle{font-family:'Lato',sans-serif;font-size:14px;line-height:1.35;margin-top:3px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:38px;}
  .bd-pprice{font-family:'Lato',sans-serif;font-size:14px;font-weight:700;margin-top:6px;}
  .bd-was{color:#b1a99a;text-decoration:line-through;font-weight:400;margin-left:6px;}
  .bd-arrow{position:absolute;top:40%;transform:translateY(-50%);z-index:3;width:42px;height:42px;border-radius:50%;border:1px solid #ddd6ca;background:#fff;color:#141414;font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 12px rgba(0,0,0,.1);transition:background .2s,color .2s;}
  .bd-arrow:hover{background:#141414;color:#fff;border-color:#141414;}
  .bd-prev{left:-10px;} .bd-next{right:-10px;}
  @media (max-width:749px){
    .bd-inner{padding:32px 16px 56px;}
    .bd-tiles{grid-template-columns:repeat(2,1fr);gap:14px;}
    .bd-tile-label{font-size:13px;}
    .bd-pcard{flex:0 0 46%;}
    .bd-arrow{display:none;}
    .bd-group{margin-bottom:44px;}
  }
</style>

<script>
  (function(){
    var root=document.querySelector('.bd[data-section-id="{{ section.id }}"]');
    if(!root){return;}
    root.querySelectorAll('.bd-carousel').forEach(function(c){
      var track=c.querySelector('[data-track]');
      if(!track){return;}
      c.querySelectorAll('.bd-arrow').forEach(function(btn){
        btn.addEventListener('click',function(){
          var dir=parseInt(btn.getAttribute('data-dir'),10)||1;
          track.scrollBy({left:dir*Math.round(track.clientWidth*0.8),behavior:'smooth'});
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Brands Directory",
  "settings": [],
  "presets": [{ "name": "Brands Directory" }]
}
{% endschema %}
