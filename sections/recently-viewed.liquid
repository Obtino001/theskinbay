{% comment %} Recently Viewed Products, client-side via localStorage. Stores current product, renders the rest. {% endcomment %}
<section class="sb-rv" aria-label="Recently viewed products">
  <div class="sb-rv__inner">
    <h2 class="sb-rv__title">{{ section.settings.heading | default: 'Recently Viewed Products' }}</h2>
    <div class="sb-rv__viewport">
      <button type="button" class="sb-rv__arrow sb-rv__arrow--prev" aria-label="Scroll left" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <div class="sb-rv__track" role="list"></div>
      <button type="button" class="sb-rv__arrow sb-rv__arrow--next" aria-label="Scroll right" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<script type="application/json" id="sb-rv-current">
{
  "id": {{ product.id | json }},
  "handle": {{ product.handle | json }},
  "url": {{ product.url | json }},
  "title": {{ product.title | json }},
  "vendor": {{ product.vendor | json }},
  "img": {{ product.featured_image | image_url: width: 500 | json }},
  "price": {{ product.price | json }},
  "cprice": {{ product.compare_at_price | default: 0 | json }},
  "avail": {{ product.available | json }}
}
</script>

<script>
(function () {
  var KEY = 'sb_recently_viewed', MAX = 12;
  var section = document.querySelector('.sb-rv');
  if (!section) return;
  var curEl = document.getElementById('sb-rv-current');
  var cur = null;
  try { cur = JSON.parse(curEl.textContent); } catch (e) {}
  var list = [];
  try { list = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}

  if (cur && cur.id) {
    list = list.filter(function (p) { return p && p.handle !== cur.handle; });
    list.unshift(cur);
    list = list.slice(0, MAX);
    try { localStorage.setItem(KEY, JSON.stringify(list)); } catch (e) {}
  }

  var toShow = list.filter(function (p) { return p && p.handle && (!cur || p.handle !== cur.handle); });
  if (!toShow.length) { section.style.display = 'none'; return; }

  function money(p) { return '£' + (p / 100).toFixed(2); }
  function esc(s) { return (s || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }

  var track = section.querySelector('.sb-rv__track');
  track.innerHTML = toShow.map(function (p) {
    var sale = p.cprice && p.cprice > p.price;
    return '<a class="sb-rv__card" role="listitem" href="' + esc(p.url) + '">'
      + '<span class="sb-rv__img"><button type="button" class="sb-card-wish" aria-label="Save to wishlist" data-handle="' + esc(p.handle) + '" data-url="' + esc(p.url) + '" data-title="' + esc(p.title) + '" data-vendor="' + esc(p.vendor || '') + '" data-img="' + esc(p.img || '') + '" data-price="' + (p.price || 0) + '" data-cprice="' + (p.cprice || 0) + '"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg></button>' + (p.img ? '<img loading="lazy" src="' + esc(p.img) + '" alt="' + esc(p.title) + '">' : '') + '</span>'
      + '<span class="sb-rv__info">'
      + (p.vendor ? '<span class="sb-rv__brand">' + esc(p.vendor) + '</span>' : '')
      + '<span class="sb-rv__name">' + esc(p.title) + '</span>'
      + '<span class="sb-rv__price">' + (sale ? '<s>' + money(p.cprice) + '</s> ' : '')
      + '<span' + (sale ? ' class="sb-rv__sale"' : '') + '>' + money(p.price) + '</span></span>'
      + '</span></a>';
  }).join('');
  if (window.sbPaintWish) window.sbPaintWish();

  var prev = section.querySelector('.sb-rv__arrow--prev');
  var next = section.querySelector('.sb-rv__arrow--next');
  function upd() {
    var max = track.scrollWidth - track.clientWidth - 2;
    if (max > 4) { prev.hidden = track.scrollLeft <= 2; next.hidden = track.scrollLeft >= max; }
    else { prev.hidden = true; next.hidden = true; }
  }
  prev.addEventListener('click', function () { track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' }); });
  next.addEventListener('click', function () { track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' }); });
  track.addEventListener('scroll', upd);
  window.addEventListener('resize', upd);
  upd();
})();
</script>

{% stylesheet %}
.sb-rv { padding: 46px 0 10px; }
.sb-rv__inner { max-width: 1560px; margin: 0 auto; padding: 0 40px; }
.sb-rv__title { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; font-size: 1.5rem; text-align: center; letter-spacing: .01em; margin: 0 0 26px; color: #0c0c0c; }
.sb-rv__viewport { position: relative; }
.sb-rv__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 72px) / 4); gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; padding-bottom: 6px; }
.sb-rv__track::-webkit-scrollbar { display: none; }
.sb-rv__card { scroll-snap-align: start; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
.sb-rv__img { position: relative; aspect-ratio: 1 / 1; background: #f6f4f0; overflow: hidden; display: block; }
.sb-rv__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .55s ease; }
.sb-rv__card:hover .sb-rv__img img { transform: scale(1.04); }
.sb-rv__info { padding: 13px 2px 0; display: flex; flex-direction: column; gap: 4px; }
.sb-rv__brand { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .5625rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(0,0,0,.4); }
.sb-rv__name { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .8125rem; line-height: 1.35; color: #1a1a1a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sb-rv__price { font-family: 'Lato', var(--font-body--family), sans-serif; font-size: .8125rem; color: #0c0c0c; margin-top: 2px; }
.sb-rv__price s { color: rgba(0,0,0,.4); margin-right: 5px; }
.sb-rv__sale { color: #b3122b; }
.sb-rv__arrow { position: absolute; top: calc(50% - 42px); transform: translateY(-50%); width: 38px; height: 38px; border-radius: 50%; background: #fff; border: 1px solid rgba(0,0,0,.12); box-shadow: 0 3px 12px rgba(0,0,0,.09); cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 2; color: #0c0c0c; transition: background .15s ease; }
.sb-rv__arrow:hover { background: #f7f4ef; }
.sb-rv__arrow svg { width: 18px; height: 18px; }
.sb-rv__arrow--prev { left: -8px; }
.sb-rv__arrow--next { right: -8px; }
@media screen and (max-width: 749px) {
  .sb-rv__inner { padding: 0 16px; }
  .sb-rv__track { grid-auto-columns: calc((100% - 14px) / 2.15); gap: 14px; }
  .sb-rv__title { font-size: 1.2rem; margin-bottom: 20px; }
  .sb-rv__arrow { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Recently Viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently Viewed Products" }
  ],
  "presets": [{ "name": "Recently Viewed" }]
}
{% endschema %}
