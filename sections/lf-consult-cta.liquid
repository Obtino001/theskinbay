<style>
  .lf-hp *, .lf-hp *::before, .lf-hp *::after { box-sizing:border-box; }
  .lf-hp a { text-decoration:none; }
  .lf-btn { display:inline-block; padding:13px 36px; font-family:'Lato',var(--font-body--family),sans-serif; font-size:10px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; text-decoration:none; border-radius:0; transition:background .18s,color .18s; cursor:pointer; white-space:nowrap; line-height:1; border:1px solid transparent; }
  .lf-btn--dark { background:#000; color:#fff; border-color:#000; }
  .lf-btn--dark:hover { background:transparent; color:#000; }

  .lf-consult { padding:96px 40px; text-align:center; background:#fff; border-top:1px solid #e8e8e8; }
  .lf-consult__eyebrow { font-family:'Lato',var(--font-body--family),sans-serif; font-size:.5rem; font-weight:700; letter-spacing:.22em; text-transform:uppercase; color:rgba(0,0,0,.3); margin-bottom:20px; display:block; }
  .lf-consult__heading { font-family:'Playfair Display',Georgia,serif; font-size:clamp(1.5rem,2.5vw,2.5rem); font-weight:400; line-height:1.15; letter-spacing:-.01em; color:#0c0c0c; margin:0 0 18px; }
  .lf-consult__heading em { font-style: italic; }
  .lf-consult__banner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 6px;} .lf-consult__vh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
  .lf-consult__body { font-size:.9rem; color:rgba(0,0,0,.5); line-height:1.7; max-width:520px; margin:0 auto 40px; }

  @media (max-width:749px) { .lf-consult { padding:64px 20px; } }
</style>

<div class="lf-hp">
  <section class="lf-consult">
    {%- if section.settings.header_image != blank -%}
      <img class="lf-consult__banner" src="{{ section.settings.header_image | asset_url }}" alt="{{ section.settings.heading | strip_html | escape }}">
      <h2 class="lf-consult__heading lf-consult__vh">{{ section.settings.heading | default: 'Not sure where to start?' }}</h2>
    {%- else -%}
      {%- if section.settings.eyebrow != blank -%}
        <span class="lf-consult__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="lf-consult__heading">{{ section.settings.heading | default: 'Not sure where to start?' }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="lf-consult__body">{{ section.settings.body }}</p>
    {%- endif -%}
    <a href="{{ section.settings.cta_link | default: '/pages/skincare-consultation' }}" class="lf-btn lf-btn--dark">
      {{ section.settings.cta_label | default: 'Book a Consultation' }}
    </a>
  </section>
</div>

{% schema %}
{
  "name": "Consultation CTA",
  "tag": "div",
  "settings": [
    { "type": "text",     "id": "eyebrow",   "label": "Pre-heading",  "default": "Personalised skincare" },
    { "type": "textarea", "id": "heading",   "label": "Heading",      "default": "Not sure where to start?" },
    { "type": "text", "id": "header_image", "label": "Header banner asset (brand-font PNG)" },
    { "type": "textarea", "id": "body",      "label": "Body text",    "default": "Our expert skincare consultation service matches you with the right products for your unique skin concerns and goals." },
    { "type": "text",     "id": "cta_label", "label": "Button label", "default": "Book a Consultation" },
    { "type": "url",      "id": "cta_link",  "label": "Button link" }
  ],
  "presets": [{ "name": "Consultation CTA" }]
}
{% endschema %}
