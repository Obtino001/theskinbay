{%- comment -%} NAD bespoke, luxe video tutorial (click-to-load YouTube facade) {%- endcomment -%}
{%- assign vid = product.metafields.custom.tutorial_video_id | default: section.settings.video_id | strip -%}
{%- if vid != blank -%}
<section class="nad-tut" style="background:{{ section.settings.bg }};--onbg:{{ section.settings.on_bg | default: '#141414' }};">
  <div class="nadtu-wrap">
    <div class="nadtu-head">
      {%- if section.settings.eyebrow != blank -%}<span class="nadtu-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="nadtu-h">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.sub != blank -%}<p class="nadtu-sub">{{ section.settings.sub }}</p>{%- endif -%}
    </div>
    <div class="nadtu-frame">
      <div class="nadtu-player" id="nadtu-{{ section.id }}" data-vid="{{ vid }}" role="button" tabindex="0" aria-label="Play the injection tutorial"
           onclick="nadTutPlay(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();nadTutPlay(this);}">
        <img class="nadtu-poster" src="https://i.ytimg.com/vi/{{ vid }}/maxresdefault.jpg" onerror="this.src='https://i.ytimg.com/vi/{{ vid }}/hqdefault.jpg'" alt="{{ section.settings.heading | escape }}" loading="lazy">
        <span class="nadtu-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z"/></svg></span>
      </div>
    </div>
    {%- if section.settings.note != blank -%}<p class="nadtu-note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
<script>
  function nadTutPlay(el){var v=el.getAttribute('data-vid');var f=document.createElement('iframe');
    f.setAttribute('src','https://www.youtube.com/embed/'+v+'?autoplay=1&rel=0&modestbranding=1');
    f.setAttribute('title','Injection tutorial');f.setAttribute('allow','accelerated-download; autoplay; encrypted-media; picture-in-picture');
    f.setAttribute('allowfullscreen','');f.className='nadtu-iframe';el.innerHTML='';el.appendChild(f);el.classList.add('is-playing');}
</script>
<style>
  .nad-tut{padding:44px 20px;}
  .nadtu-wrap{max-width:900px;margin:0 auto;text-align:center;}
  .nadtu-eyebrow{display:block;font-family:'Lato',sans-serif;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--onbg);margin-bottom:10px;}
  .nadtu-h{font-family:'Playfair Display',serif;font-size:30px;line-height:1.15;color:var(--onbg);margin:0 0 8px;}
  .nadtu-sub{font-family:'Lato',sans-serif;font-size:16px;line-height:1.6;color:var(--onbg);margin:0 auto 26px;max-width:560px;}
  .nadtu-frame{background:var(--box,#FBF6EA);border:1px solid var(--boxline,#ECE3CE);border-radius:22px;padding:16px;}
  .nadtu-player{position:relative;width:100%;aspect-ratio:16/9;border-radius:14px;overflow:hidden;cursor:pointer;background:var(--card,#10233B);}
  .nadtu-poster{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease,filter .3s ease;}
  .nadtu-player:hover .nadtu-poster{transform:scale(1.03);filter:brightness(.92);}
  .nadtu-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:76px;height:76px;border-radius:50%;background:var(--accent,#F6C21A);display:flex;align-items:center;justify-content:center;transition:transform .2s ease;}
  .nadtu-player:hover .nadtu-play{transform:translate(-50%,-50%) scale(1.06);}
  .nadtu-play svg{width:34px;height:34px;fill:#141414;margin-left:3px;}
  .nadtu-iframe{width:100%;aspect-ratio:16/9;border:0;display:block;border-radius:14px;}
  .nadtu-player.is-playing{cursor:default;}
  .nadtu-note{font-family:'Lato',sans-serif;font-size:13px;color:var(--onbg);opacity:.8;margin:18px 0 0;}
  @media(max-width:749px){.nad-tut{padding:34px 16px;}.nadtu-h{font-size:24px;}.nadtu-play{width:60px;height:60px;}.nadtu-play svg{width:26px;height:26px;}}
</style>
{%- endif -%}
{% schema %}
{
  "name": "NAD · Tutorial",
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#F6C21A" },
    { "type": "color", "id": "on_bg", "label": "Text on background", "default": "#141414" },
    { "type": "text", "id": "video_id", "label": "YouTube video ID", "default": "QA7y6spItFo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEED A HAND?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to inject, step by step" },
    { "type": "textarea", "id": "sub", "label": "Subtext", "default": "A calm, straightforward walkthrough so your first time feels easy. Watch whenever you need it." },
    { "type": "text", "id": "note", "label": "Note", "default": "Always follow the printed guide included in your kit." }
  ],
  "presets": [{ "name": "NAD · Tutorial" }]
}
{% endschema %}
