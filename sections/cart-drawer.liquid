{{ 'wi-cart-drawer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ship_threshold = section.settings.ship_threshold | times: 100
  assign ship_remaining = ship_threshold | minus: cart.total_price
  if ship_remaining < 0
    assign ship_remaining = 0
  endif
  if ship_threshold > 0
    assign ship_percent = cart.total_price | times: 100.0 | divided_by: ship_threshold
    if ship_percent > 100
      assign ship_percent = 100
    endif
  else
    assign ship_percent = 0
  endif

  assign total_savings = 0
  for item in cart.items
    assign compare_price = item.variant.compare_at_price
    if item.original_line_price > item.line_price
      assign total_savings = total_savings | plus: item.original_line_price | minus: item.line_price
    elsif compare_price > item.final_price
      assign line_save = compare_price | minus: item.final_price | times: item.quantity
      assign total_savings = total_savings | plus: line_save
    endif
  endfor

  assign gift_already = false
  assign gift_paid = 0
  assign gift_threshold = 0
  assign gift_name = ''
  assign gift_matched = false
  assign sc_threshold = section.settings.gift_skinceuticals | times: 100
  assign m8_threshold = section.settings.gift_medik8 | times: 100
  assign cc_threshold = section.settings.gift_cliniccare | times: 100

  for item in cart.items
    if item.original_price == 0 and item.final_price == 0
      assign gift_already = true
    endif
  endfor

  unless gift_already
    for item in cart.items
      assign skip_gift = false
      if item.final_price <= 0
        assign skip_gift = true
      endif
      assign gift_hay = item.product.handle | append: ' ' | append: item.product.title | downcase
      if gift_hay contains 'extra free' or gift_hay contains 'extra-free' or gift_hay contains 'free-15ml' or gift_hay contains 'free 15ml' or gift_hay contains '50% extra' or gift_hay contains '15ml-bundle'
        assign skip_gift = true
      endif
      unless skip_gift
        assign gift_paid = gift_paid | plus: item.final_line_price
        unless gift_matched
          assign vendor_l = item.vendor | downcase
          if vendor_l contains 'skinceuticals'
            assign gift_threshold = sc_threshold
            assign gift_name = section.settings.gift_skinceuticals_name
            assign gift_matched = true
          elsif vendor_l contains 'medik8' or vendor_l contains 'medik 8'
            assign gift_threshold = m8_threshold
            assign gift_name = section.settings.gift_medik8_name
            assign gift_matched = true
          elsif vendor_l contains 'cliniccare'
            assign gift_threshold = cc_threshold
            assign gift_name = section.settings.gift_cliniccare_name
            assign gift_matched = true
          endif
        endunless
      endunless
    endfor
  endunless

  assign gift_remaining = 0
  assign gift_percent = 0
  assign gift_unlocked = false
  if gift_threshold > 0
    assign gift_remaining = gift_threshold | minus: gift_paid
    if gift_remaining < 0
      assign gift_remaining = 0
    endif
    assign gift_percent = gift_paid | times: 100.0 | divided_by: gift_threshold
    if gift_percent > 100
      assign gift_percent = 100
    endif
    if gift_paid >= gift_threshold
      assign gift_unlocked = true
    endif
  endif
-%}

<wi-cartdrawer>
  <div class="WI_cartDrawerin">
    {%- if section.settings.show_upsell_panel -%}
      <aside class="WI_cartDrawerin_upsell" aria-label="{{ section.settings.upsell_title | escape }}">
        <div class="WI_upsell_header">
          <h2 class="WI_upsell_title">{{ section.settings.upsell_title }}</h2>
        </div>
        <div class="WI_upsell_list" id="WI_upsell_list"></div>
        <div class="WI_upsell_trust">
          <div class="WI_upsell_trust_item">
            <span class="WI_upsell_trust_icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            </span>
            <span>{{ section.settings.trust_1 }}</span>
          </div>
          <div class="WI_upsell_trust_item">
            <span class="WI_upsell_trust_icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </span>
            <span>{{ section.settings.trust_2 }}</span>
          </div>
          <div class="WI_upsell_trust_item">
            <span class="WI_upsell_trust_icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="4"/><path d="M6 20v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/></svg>
            </span>
            <span>{{ section.settings.trust_3 }}</span>
          </div>
        </div>
      </aside>
    {%- endif -%}

    <div class="WI_cartDrawerin_cart">
      <span data-cart-count hidden>{{ cart.item_count }}</span>

      <div class="WI_cartDrawerin_cart_header">
        <h2 class="WI_cartDrawerin_cart_headerH">
          <span class="WI_cartDrawer_count">{{ section.settings.cart_title }} ({{ cart.item_count }})</span>
          <button type="button" class="WI_cartDrawerCls" aria-label="Close bag">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </h2>
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="WI_cartDrawer_shipping">
          {%- if cart.total_price >= ship_threshold -%}
            <p class="WI_cartDrawer_shipping_msg is-unlocked">{{ section.settings.ship_unlocked_text }}</p>
          {%- else -%}
            {%- assign ship_remaining_money = ship_remaining | money -%}
            <p class="WI_cartDrawer_shipping_msg">{{ section.settings.ship_progress_text | replace: '[amount]', ship_remaining_money }}</p>
          {%- endif -%}
          <div class="WI_cartDrawer_shipping_track">
            <div class="WI_cartDrawer_shipping_fill{% if cart.total_price >= ship_threshold %} is-full{% endif %}" style="width:{{ ship_percent }}%"></div>
          </div>
        </div>

        {%- unless gift_already -%}
          {%- if section.settings.gift_panel_title != blank -%}
          <div class="WI_cartDrawer_gift">
            <p class="WI_cartDrawer_gift_eyebrow">{{ section.settings.gift_panel_title }}</p>
            {%- if gift_matched == false -%}
              <p class="WI_cartDrawer_gift_msg">{{ section.settings.gift_generic_text }}</p>
              <div class="WI_cartDrawer_gift_track"><div class="WI_cartDrawer_gift_fill" style="width:0%"></div></div>
            {%- elsif gift_unlocked -%}
              {%- assign gift_unlocked_text = section.settings.gift_unlocked_text | replace: '[gift]', gift_name -%}
              <p class="WI_cartDrawer_gift_msg is-unlocked">{{ gift_unlocked_text }}</p>
              <div class="WI_cartDrawer_gift_track"><div class="WI_cartDrawer_gift_fill is-full" style="width:100%"></div></div>
            {%- else -%}
              {%- assign gift_remaining_money = gift_remaining | money -%}
              {%- assign gift_progress_text = section.settings.gift_progress_text | replace: '[amount]', gift_remaining_money | replace: '[gift]', gift_name -%}
              <p class="WI_cartDrawer_gift_msg">{{ gift_progress_text }}</p>
              <div class="WI_cartDrawer_gift_track"><div class="WI_cartDrawer_gift_fill" style="width:{{ gift_percent }}%"></div></div>
            {%- endif -%}
            {%- if section.settings.gift_note_1 != blank -%}
              <p class="WI_cartDrawer_gift_note">{{ section.settings.gift_note_1 }}</p>
            {%- endif -%}
          </div>
          {%- endif -%}
        {%- endunless -%}
      {%- endif -%}

      {%- if section.settings.loyalty_banner != blank and cart.item_count > 0 -%}
        <div class="WI_loyalty_banner">{{ section.settings.loyalty_banner }}</div>
      {%- endif -%}

      <div class="wi-cart-global-loader hidden" aria-live="polite" aria-label="Loading">
        {% render 'wi-cart-spinner', size: 44 %}
      </div>

      {% if cart.item_count > 0 %}
        <div class="WI_cartDrawerin_cart_body">
          {% form 'cart', cart %}
            <div class="WI_cartDrawerin_cart_form_in">
              <div class="WI_cartDrawerin_cart_items">
                {% for item in cart.items %}
                  {%- liquid
                    assign is_gift = false
                    if item.original_price == 0 and item.final_price == 0
                      assign is_gift = true
                    endif
                    assign compare_price = item.variant.compare_at_price
                    assign on_sale = false
                    if compare_price > item.final_price or item.original_line_price > item.line_price
                      assign on_sale = true
                    endif
                  -%}
                  <div
                    class="WI_cartDrawer_item"
                    data-itemKey="{{ item.key }}"
                    data-savingPrice="{%- if compare_price > item.final_price -%}{{ compare_price | minus: item.final_price | times: item.quantity }}{%- endif -%}"
                  >
                    <div class="WI_cartDrawer_item_col WI_cartDrawer_item_col--media">
                      <div class="WI_cartDrawer_item_img">
                        <a href="{{ item.product.url }}">
                          {{ item.image | image_url: width: 200 | image_tag: loading: 'eager', alt: item.product.title }}
                        </a>
                      </div>
                      <button type="button" class="cartDrawerRemove text-remove-btn">{{ section.settings.remove_text }}</button>
                    </div>

                    <div class="WI_cartDrawer_item_col WI_cartDrawer_item_col--main">
                      <a href="{{ item.product.url }}" class="WI_cartDrawer_item_title">{{ item.product.title | escape }}</a>
                      {%- if item.product.has_only_default_variant == false -%}
                        <div class="WI_cartDrawer_item_options">
                          {%- for option in item.options_with_values -%}
                            <span class="option-tag">{{ option.value }}</span>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                      {%- unless is_gift -%}
                        <div class="WI_cartDrawer_quantity">
                          <div class="wi-cart-qty-loader hidden" aria-hidden="true">
                            {% render 'wi-cart-spinner', size: 16 %}
                          </div>
                          <button type="button" class="WI_cartDrawer_minus" aria-label="Decrease quantity">−</button>
                          <input value="{{ item.quantity }}" type="number" readonly aria-label="Quantity">
                          <button type="button" class="WI_cartDrawer_plus" aria-label="Increase quantity">+</button>
                        </div>
                      {%- endunless -%}
                    </div>

                    <div class="WI_cartDrawer_item_col WI_cartDrawer_item_col--price">
                      {%- if is_gift -%}
                        <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--gift">Complimentary</span>
                      {%- elsif on_sale -%}
                        <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--sale">{{ item.final_price | money }}</span>
                        {%- if compare_price > item.final_price -%}
                          <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--was">{{ compare_price | money }}</span>
                        {%- elsif item.original_line_price > item.line_price -%}
                          <span class="WI_cartDrawer_item_price WI_cartDrawer_item_price--was">{{ item.original_price | money }}</span>
                        {%- endif -%}
                      {%- else -%}
                        <span class="WI_cartDrawer_item_price">{{ item.final_price | money }}</span>
                      {%- endif -%}
                    </div>

                    <div class="wi-cart-item-loader hidden" aria-hidden="true">
                      {% render 'wi-cart-spinner', size: 32 %}
                    </div>
                  </div>
                {% endfor %}
              </div>

              <div
                id="cart-drawer-data"
                style="display:none;"
                data-first-product-id="{% if cart.items.size > 0 %}{{ cart.items.first.product.id }}{% endif %}"
                data-cart-handles="{% for item in cart.items %}{{ item.product.handle }}{% unless forloop.last %},{% endunless %}{% endfor %}"
              ></div>

              {% if section.settings.show_discount_code %}
                <button type="button" class="WI_discount_toggle">{{ section.settings.discount_toggle_text }}</button>
                <div class="WI_discount_wrap is-collapsed">
                  <input
                    type="text"
                    name="discount"
                    class="WI_discount_input"
                    placeholder="{{ section.settings.discount_placeholder | escape }}"
                    autocomplete="off"
                  >
                  <button type="button" class="WI_discount_btn">{{ section.settings.discount_btn_text }}</button>
                </div>
              {% endif %}

              {%- if section.settings.show_upsell_panel -%}
                <div class="WI_cartDrawer_recommendations is-hidden" aria-label="{{ section.settings.upsell_title | escape }}">
                  <h3 class="WI_cartDrawer_recommendations_title">{{ section.settings.upsell_title }}</h3>
                  <div class="WI_upsell_list WI_upsell_list--mobile" id="WI_upsell_list_mobile"></div>
                </div>
              {%- endif -%}
            </div>

            <div class="WI_cartDrawerin_cart_footer">
              {%- if total_savings > 0 -%}
                <div class="WI_cartDrawer_savings">
                  <span>{{ section.settings.savings_label }}</span>
                  <span class="WI_cartDrawer_savings_val">−{{ total_savings | money }}</span>
                </div>
              {%- endif -%}
              <div class="WI_cartDrawer_total">
                <span>{{ section.settings.total_label }}</span>
                <span class="WI_cartDrawer_total_price">{{ cart.total_price | money }}</span>
              </div>
              <button type="submit" name="checkout" value="Checkout" class="WI_cartDrawer_checkout">
                {{ section.settings.checkout_btn_text }}
              </button>
              {%- if section.settings.secure_checkout_text != blank -%}
              <div class="WI_cartDrawer_secure">
                <span class="WI_cartDrawer_secure_stars" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M12 2l2.9 6.3L22 9.3l-5 4.8 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.8 7.1-1z"/></svg>
                  <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M12 2l2.9 6.3L22 9.3l-5 4.8 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.8 7.1-1z"/></svg>
                  <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M12 2l2.9 6.3L22 9.3l-5 4.8 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.8 7.1-1z"/></svg>
                  <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M12 2l2.9 6.3L22 9.3l-5 4.8 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.8 7.1-1z"/></svg>
                  <svg viewBox="0 0 24 24" width="12" height="12"><path fill="currentColor" d="M12 2l2.9 6.3L22 9.3l-5 4.8 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.8 7.1-1z"/></svg>
                </span>
                <span class="WI_cartDrawer_secure_lock" aria-hidden="true">
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="1"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <span>{{ section.settings.secure_checkout_text }}</span>
              </div>
              {%- endif -%}
            </div>
          {% endform %}
        </div>
      {%- else -%}
        <div class="WI_cartDrawerin_cart_empty">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <p>{{ 'content.your_cart_is_empty' | t }}</p>
          <span>{{ section.settings.empty_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</wi-cartdrawer>

<script src="{{ 'wi-cart-drawer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_upsell_panel",
      "label": "Show recommended products panel",
      "default": true
    },
    {
      "type": "text",
      "id": "upsell_title",
      "label": "Recommended panel title",
      "default": "Recommended products"
    },
    {
      "type": "text",
      "id": "cart_title",
      "label": "Cart title",
      "default": "Your bag"
    },
    {
      "type": "text",
      "id": "remove_text",
      "label": "Remove link text",
      "default": "Remove"
    },
    {
      "type": "header",
      "content": "Shipping progress"
    },
    {
      "type": "paragraph",
      "content": "Change free-delivery spend in Theme settings → Cart Drawer. Use [amount] in the progress text for the remaining total."
    },
    {
      "type": "number",
      "id": "ship_threshold",
      "label": "Free shipping threshold (£)",
      "default": 400,
      "info": "Cart total needed to unlock free UK delivery."
    },
    {
      "type": "text",
      "id": "ship_progress_text",
      "label": "Progress text",
      "default": "Spend [amount] more for free UK delivery",
      "info": "Use [amount] for the remaining amount."
    },
    {
      "type": "text",
      "id": "ship_unlocked_text",
      "label": "Unlocked text",
      "default": "You've unlocked free UK delivery"
    },
    {
      "type": "header",
      "content": "Complimentary gift"
    },
    {
      "type": "paragraph",
      "content": "Works like the live theme: first matching brand in the bag sets the gift, then paid items count toward that spend. Gifts are still added by your gift app (Monk). Hide this panel by leaving the title blank. Thresholds are in pounds."
    },
    {
      "type": "text",
      "id": "gift_panel_title",
      "label": "Gift panel title",
      "default": "Exclusive Privileges"
    },
    {
      "type": "text",
      "id": "gift_generic_text",
      "label": "Text when no brand gift applies",
      "default": "Exclusive gifts available on qualifying orders."
    },
    {
      "type": "text",
      "id": "gift_progress_text",
      "label": "Gift progress text",
      "default": "You're [amount] away from your complimentary [gift].",
      "info": "Use [amount] for remaining spend and [gift] for the gift name."
    },
    {
      "type": "text",
      "id": "gift_unlocked_text",
      "label": "Gift unlocked text",
      "default": "Your complimentary [gift] will be added — thank you for your order.",
      "info": "Use [gift] for the gift name."
    },
    {
      "type": "text",
      "id": "gift_note_1",
      "label": "Gift note (optional)",
      "default": "Complimentary samples with qualifying brand orders",
      "info": "Leave blank to hide."
    },
    {
      "type": "number",
      "id": "gift_skinceuticals",
      "label": "SkinCeuticals gift spend (£)",
      "default": 150
    },
    {
      "type": "text",
      "id": "gift_skinceuticals_name",
      "label": "SkinCeuticals gift name",
      "default": "Skinceuticals gift set"
    },
    {
      "type": "number",
      "id": "gift_medik8",
      "label": "Medik8 gift spend (£)",
      "default": 100
    },
    {
      "type": "text",
      "id": "gift_medik8_name",
      "label": "Medik8 gift name",
      "default": "Medik8 gift set"
    },
    {
      "type": "number",
      "id": "gift_cliniccare",
      "label": "Cliniccare gift spend (£)",
      "default": 200
    },
    {
      "type": "text",
      "id": "gift_cliniccare_name",
      "label": "Cliniccare gift name",
      "default": "Cliniccare gift"
    },
    {
      "type": "richtext",
      "id": "loyalty_banner",
      "label": "Loyalty banner",
      "default": "<p>BayPoints members earn rewards on every order. <a href=\"/account/login\">Sign in</a> or <a href=\"/pages/skinbay-loyalty-rewards\">join now</a></p>",
      "info": "Leave empty to hide this strip."
    },
    {
      "type": "header",
      "content": "Trust messages (left panel)"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust message 1",
      "default": "Free UK delivery over £400"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust message 2",
      "default": "Fast UK delivery"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust message 3",
      "default": "Earn BayPoints on every order"
    },
    {
      "type": "header",
      "content": "Discount & checkout"
    },
    {
      "type": "checkbox",
      "id": "show_discount_code",
      "label": "Show discount code",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_toggle_text",
      "label": "Discount toggle text",
      "default": "Use gift card / discount code — click here"
    },
    {
      "type": "text",
      "id": "discount_placeholder",
      "label": "Discount placeholder",
      "default": "Enter code"
    },
    {
      "type": "text",
      "id": "discount_btn_text",
      "label": "Discount button",
      "default": "Apply"
    },
    {
      "type": "text",
      "id": "savings_label",
      "label": "Total savings label",
      "default": "Total savings:"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total"
    },
    {
      "type": "text",
      "id": "checkout_btn_text",
      "label": "Checkout button",
      "default": "Go to checkout"
    },
    {
      "type": "text",
      "id": "secure_checkout_text",
      "label": "Secured checkout text",
      "default": "Secured checkout",
      "info": "Shown under the checkout button with stars. Leave blank to hide."
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty cart text",
      "default": "Discover expertly curated skincare from leading dermatology brands."
    }
  ]
}
{% endschema %}
