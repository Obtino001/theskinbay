{% comment %}
  Skin Bay Vitamin C Education Section (Ultimate Editable Version)
  - Full Font Size Control (Desktop & Mobile)
  - Full Padding/Spacing Control
  - Editorial Layout
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }

  .sb-container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    font-family: var(--font-body--family), sans-serif;
  }

  /* Section Padding (Outer) */
  .sb-wrapper {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Internal Spacing helper */
  .sb-spacer {
    height: {{ section.settings.internal_spacing }}px;
  }

  /* Typography - Dynamic Settings */
  .sb-title {
    font-size: {{ section.settings.title_size_d }}px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    color: {{ section.settings.heading_color }};
  }

  .sb-subtitle {
    font-size: {{ section.settings.subtitle_size_d }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin-bottom: 1rem;
    color: {{ section.settings.accent_color }};
    display: block;
  }

  .sb-body {
    font-size: {{ section.settings.body_size_d }}px;
    font-weight: 300;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: {{ section.settings.text_color }};
  }
  
  .sb-body p {
    margin-bottom: 1rem;
  }

  .sb-heading-2 {
    font-size: {{ section.settings.h2_size_d }}px;
    font-weight: 400;
    margin-bottom: 1.5rem;
    color: {{ section.settings.heading_color }};
    text-align: center;
  }

  /* Brand-font header banners (SEO heading kept, visually hidden) */
  .vc-hbanner{display:block;width:100%;max-width:680px;height:auto;margin:0 auto 12px;}
  .vc-hbanner-left{display:block;width:100%;max-width:440px;height:auto;margin:0 0 12px;}
  .vc-hvh{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}

  /* Layout Grids */
  .sb-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .sb-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  /* Feature Cards */
  .sb-card {
    background: {{ section.settings.card_bg }};
    padding: 2rem;
    border: 1px solid {{ section.settings.border_color }};
    text-align: center;
    transition: transform 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
  }
  
  .sb-card:hover {
    transform: translateY(-5px);
  }

  .sb-card h3 {
    font-size: {{ section.settings.card_title_size }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
    color: {{ section.settings.heading_color }};
  }

  /* Button */
  .sb-btn {
    display: inline-block;
    padding: 15px 40px;
    background-color: {{ section.settings.accent_color }};
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.9rem;
    text-decoration: none;
    font-weight: 500;
    margin-top: 1rem;
    transition: opacity 0.3s ease;
  }
  
  .sb-btn:hover {
    opacity: 0.8;
  }

  /* Editorial Image styling */
  .sb-image-container {
    position: relative;
    overflow: hidden;
    height: 100%;
    min-height: 400px;
  }

  .sb-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  /* Usage Section Box */
  .sb-usage-box {
    background: {{ section.settings.card_bg }}; 
    padding: 3rem; 
    border: 1px solid {{ section.settings.border_color }};
  }

  /* Mobile Responsive */
  @media only screen and (max-width: 749px) {
    .sb-wrapper {
      padding-top: {{ section.settings.padding_top_m }}px;
      padding-bottom: {{ section.settings.padding_bottom_m }}px;
    }

    .sb-spacer {
      height: {{ section.settings.internal_spacing | divided_by: 2 }}px;
    }
    
    .sb-grid-2, .sb-grid-3 {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    /* Mobile Typography Overrides */
    .sb-title {
      font-size: {{ section.settings.title_size_m }}px;
    }
    
    .sb-subtitle {
      font-size: {{ section.settings.subtitle_size_m }}px;
    }
    
    .sb-heading-2 {
      font-size: {{ section.settings.h2_size_m }}px;
    }
    
    .sb-body {
      font-size: {{ section.settings.body_size_m }}px;
    }

    .sb-image-container {
      min-height: 300px;
      order: -1; 
    }
    
    .sb-card {
      padding: 1.5rem;
    }
    
    .sb-usage-box {
      padding: 1.5rem;
    }
  }
</style>

<div class="sb-wrapper">
  <div class="sb-container">
    
    <!-- Hero Section -->
    <div class="sb-grid-2">
      <div>
        {% if section.settings.subtitle != blank %}
          <span class="sb-subtitle">{{ section.settings.subtitle }}</span>
        {% endif %}
        <img class="vc-hbanner-left" src="{{ 'vitc-h-title.png' | asset_url }}" alt="Vitamin C Serum">
        <h1 class="sb-title vc-hvh">{{ section.settings.title }}</h1>
        <div class="sb-body">{{ section.settings.intro_text }}</div>
        {% if section.settings.show_cta %}
          <a href="{{ section.settings.cta_link }}" class="sb-btn">{{ section.settings.cta_text }}</a>
        {% endif %}
      </div>
      <div class="sb-image-container">
        {% if section.settings.hero_image %}
          {{ section.settings.hero_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>

    <div class="sb-spacer"></div>

    <!-- What is it Section -->
    <div>
      <img class="vc-hbanner" src="{{ 'vitc-h-def.png' | asset_url }}" alt="Why Vitamin C?">
      <h2 class="sb-heading-2 vc-hvh">{{ section.settings.definition_title }}</h2>
      <div class="sb-body" style="max-width: 800px; margin: 0 auto; text-align: center;">
        {{ section.settings.definition_text }}
      </div>
    </div>

    <div class="sb-spacer"></div>

    <!-- Benefits Grid -->
    <div>
      <img class="vc-hbanner" src="{{ 'vitc-h-ben.png' | asset_url }}" alt="The Skin Benefits">
      <h2 class="sb-heading-2 vc-hvh">{{ section.settings.benefits_title }}</h2>
      <div class="sb-grid-3">
        {% for block in section.blocks %}
          <div class="sb-card">
            <h3>{{ block.settings.benefit_title }}</h3>
            <p class="sb-body" style="font-size: {{ section.settings.body_size_d | minus: 2 }}px; margin-bottom: 0;">{{ block.settings.benefit_desc }}</p>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="sb-spacer"></div>

    <!-- Usage & Ritual -->
    <div class="sb-usage-box">
      <img class="vc-hbanner" src="{{ 'vitc-h-ritual.png' | asset_url }}" alt="The Ritual">
      <h2 class="sb-heading-2 vc-hvh" style="margin-top: 0;">{{ section.settings.ritual_title }}</h2>
      <div class="sb-body" style="text-align: center; max-width: 800px; margin: 0 auto;">
        {{ section.settings.ritual_text }}
      </div>
    </div>

  </div>
</div>

