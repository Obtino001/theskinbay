{%- liquid
  assign active_tag = current_tags | first
-%}

<div class="bayblog-index-section">

  <section class="bayblog-band">
    <span class="bayblog-band__eyebrow">{{ section.settings.eyebrow | default: 'theskinbay Journal' }}</span>
    <h1 class="bayblog-band__heading">{{ section.settings.heading | default: blog.title }}</h1>
    {%- if section.settings.tagline != blank -%}
      <p class="bayblog-band__body">{{ section.settings.tagline }}</p>
    {%- endif -%}
  </section>

  {%- if section.settings.show_founder -%}
    <section class="bayblog-founder">
      <div class="bayblog-founder__inner">
        {%- if section.settings.founder_image -%}
          <img class="bayblog-founder__photo" src="{{ section.settings.founder_image | image_url: width: 240 }}"
            alt="{{ section.settings.founder_name | default: 'Emmalee' | escape }}, founder of theskinbay" width="120" height="120" loading="lazy">
        {%- else -%}
          <img class="bayblog-founder__photo" src="{{ 'email-founder-emmalee.jpg' | asset_url }}"
            alt="{{ section.settings.founder_name | default: 'Emmalee' | escape }}, founder of theskinbay" width="120" height="120" loading="lazy">
        {%- endif -%}
        <div class="bayblog-founder__text">
          {%- if section.settings.founder_kicker != blank -%}<p class="bayblog-founder__kicker">{{ section.settings.founder_kicker }}</p>{%- endif -%}
          {%- if section.settings.founder_quote != blank -%}<p class="bayblog-founder__quote">{{ section.settings.founder_quote }}</p>{%- endif -%}
          {%- if section.settings.founder_name != blank -%}<p class="bayblog-founder__name">{{ section.settings.founder_name }}</p>{%- endif -%}
          {%- if section.settings.founder_link != blank -%}
            <a class="bayblog-founder__social" href="{{ section.settings.founder_link }}">{{ section.settings.founder_link_text | default: 'More from our socials' }}&nbsp;&#8250;</a>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <div class="bayblog-index">

    {%- if blog.all_tags.size > 0 -%}
      <div class="bayblog-index__filterwrap">
        <nav class="bayblog-index__filter" aria-label="Categories">
          <a class="bayblog-chip {% unless active_tag %}is-active{% endunless %}" href="{{ blog.url }}">All</a>
          {%- for tag in blog.all_tags -%}
            {%- unless tag contains '-' -%}
              <a class="bayblog-chip {% if active_tag == tag %}is-active{% endif %}"
                 href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
            {%- endunless -%}
          {%- endfor -%}
        </nav>
      </div>
    {%- endif -%}

    <div class="bayblog-index__grid">
      {%- for article in blog.articles -%}
        <a class="bayblog-card" href="{{ article.url }}">
          <span class="bayblog-card__img">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 700 }}"
                srcset="{{ article.image | image_url: width: 500 }} 500w, {{ article.image | image_url: width: 800 }} 800w"
                sizes="(max-width:749px) 90vw, 30vw"
                alt="{{ article.image.alt | default: article.title | escape }}"
                width="700" height="466" loading="lazy">
            {%- endif -%}
          </span>
          {%- assign acat = article.metafields.custom.category -%}
          {%- if acat != blank -%}<span class="bayblog-card__cat">{{ acat }}</span>{%- endif -%}
          <span class="bayblog-card__title">{{ article.title }}</span>
          {%- if article.excerpt != blank -%}
            <span class="bayblog-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 22 }}</span>
          {%- endif -%}
          <span class="bayblog-card__meta">
            {%- assign rt = article.metafields.custom.reading_time -%}
            {%- if rt != blank -%}{{ rt }} min read{%- else -%}{{ article.published_at | date: '%-d %b %Y' }}{%- endif -%}
          </span>
        </a>
      {%- else -%}
        <p class="bayblog-index__empty">No articles yet.</p>
      {%- endfor -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .bayblog-index-section { --bay-fg-rgb: var(--color-foreground-rgb); }
  /* branded banner header — matches the site Contact-page banner */
  .bayblog-band { background:#0b1225; padding: clamp(56px,9vw,88px) 40px clamp(48px,8vw,80px); text-align:center; }
  .bayblog-band__eyebrow { font-family:'Lato',sans-serif; font-size:.625rem; font-weight:700; letter-spacing:.22em;
    text-transform:uppercase; color:rgba(255,255,255,.4); display:block; margin-bottom:18px; }
  .bayblog-band__heading { font-family:'Playfair Display',Georgia,serif; font-size:clamp(2.25rem,5.5vw,3.75rem);
    font-weight:400; color:#fff; margin:0 0 18px; line-height:1.08; letter-spacing:-.02em; }
  .bayblog-band__body { font-family:'Lato',sans-serif; font-size:1rem; color:rgba(255,255,255,.55); line-height:1.7; max-width:520px; margin:0 auto; }

  /* founder note — matches the site Contact-page founder block */
  .bayblog-founder { background:#F9F3ED; padding:38px 24px; }
  .bayblog-founder__inner { max-width:880px; margin:0 auto; display:flex; gap:30px; align-items:center; }
  .bayblog-founder__photo { width:120px; height:120px; border-radius:50%; object-fit:cover; flex:0 0 auto; box-shadow:0 4px 16px rgba(0,0,0,.1); }
  .bayblog-founder__kicker { font-family:'Lato',sans-serif; text-transform:uppercase; letter-spacing:.22em; font-size:11px; color:#8a8377; margin:0 0 8px; }
  .bayblog-founder__quote { font-family:'Lato',sans-serif; font-style:italic; font-size:15.5px; line-height:1.62; color:#413d36; margin:0 0 10px; max-width:640px; }
  .bayblog-founder__name { font-family:'Playfair Display',Georgia,serif; font-weight:700; font-size:28px; color:#141414; margin:0 0 10px; }
  .bayblog-founder__social { font-family:'Lato',sans-serif; font-size:12px; letter-spacing:.1em; text-transform:uppercase; text-decoration:none; color:#141414; border-bottom:1px solid #141414; padding-bottom:2px; }
  .bayblog-founder__social:hover { color:#8a8377; border-color:#8a8377; }
  @media (max-width:749px){ .bayblog-founder__inner{ flex-direction:column; text-align:center; gap:18px; } .bayblog-founder__photo{ width:104px; height:104px; } }

  .bayblog-index { max-width: var(--page-width, 1400px); margin-inline:auto; padding-inline: var(--padding-inline, 5vw); padding-block: 2.5rem 4rem; }

  /* category selector — single-row horizontal scroll carousel */
  .bayblog-index__filterwrap { position:relative; margin-bottom:2.4rem; }
  .bayblog-index__filterwrap::before,
  .bayblog-index__filterwrap::after { content:""; position:absolute; top:0; bottom:0; width:36px; pointer-events:none; z-index:1; }
  .bayblog-index__filterwrap::before { left:0; background:linear-gradient(to right, var(--color-background), transparent); }
  .bayblog-index__filterwrap::after { right:0; background:linear-gradient(to left, var(--color-background), transparent); }
  .bayblog-index__filter { display:flex; flex-wrap:nowrap; gap:.55rem; overflow-x:auto; scroll-snap-type:x proximity;
    padding:.35rem .2rem; -webkit-overflow-scrolling:touch; scrollbar-width:none; }
  .bayblog-index__filter::-webkit-scrollbar { display:none; }
  .bayblog-chip { flex:0 0 auto; scroll-snap-align:start; white-space:nowrap;
    font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; font-weight:700; text-decoration:none; color:inherit;
    padding:.5rem .95rem; border:1px solid rgb(var(--bay-fg-rgb) / .2); border-radius: 999px; opacity:.8; transition: all .2s ease; }
  .bayblog-chip:hover { opacity:1; border-color: rgb(var(--bay-fg-rgb) / .5); }
  .bayblog-chip.is-active { background: var(--color-foreground); color: var(--color-background); border-color: var(--color-foreground); opacity:1; }

  .bayblog-index__grid { display:grid; grid-template-columns: repeat(3,1fr); gap: 2.2rem 1.8rem; }
  .bayblog-card { text-decoration:none; color:inherit; display:flex; flex-direction:column; }
  .bayblog-card__img { aspect-ratio: 3/2; overflow:hidden; background: rgb(var(--bay-fg-rgb) / .05); border-radius: var(--border-radius,0); }
  .bayblog-card__img img { width:100%; height:100%; object-fit:cover; transition: transform .5s ease; }
  .bayblog-card:hover .bayblog-card__img img { transform: scale(1.05); }
  .bayblog-card__cat { font-size:.64rem; letter-spacing:.2em; text-transform:uppercase; font-weight:700; opacity:.55; margin-top:1rem; }
  .bayblog-card__title { font-family: 'Playfair Display', Georgia, serif; font-size:1.3rem; line-height:1.22; margin-top:.4rem; }
  .bayblog-card__excerpt { opacity:.78; font-size:.9rem; line-height:1.5; margin-top:.5rem; }
  .bayblog-card__meta { font-size:.72rem; letter-spacing:.06em; opacity:.55; margin-top:.7rem; }
  .bayblog-index__empty { grid-column:1/-1; text-align:center; opacity:.6; padding:3rem 0; }

  @media (max-width: 989px) { .bayblog-index__grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 649px) { .bayblog-index__grid { grid-template-columns: 1fr; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Bay Blog index",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Banner eyebrow", "default": "theskinbay Journal" },
    { "type": "text", "id": "heading", "label": "Banner heading", "default": "The Bay Blog" },
    { "type": "text", "id": "tagline", "label": "Banner subtitle", "default": "Expert skincare guides, ingredient science and honest advice from theskinbay." },
    { "type": "header", "content": "Founder note" },
    { "type": "checkbox", "id": "show_founder", "label": "Show founder note", "default": true },
    { "type": "image_picker", "id": "founder_image", "label": "Founder photo (optional — defaults to site photo)" },
    { "type": "text", "id": "founder_kicker", "label": "Kicker", "default": "A Note From Emmalee" },
    { "type": "textarea", "id": "founder_quote", "label": "Note", "default": "I love talking products, ingredients and results, so The Bay Blog is my way of sharing the knowledge I learn every day, with the brands, the products and with your skin. Search topics below and really get to know what you're putting on the skin, it makes the journey even more exciting." },
    { "type": "text", "id": "founder_name", "label": "Name", "default": "Emmalee" },
    { "type": "text", "id": "founder_link", "label": "Link", "default": "/pages/social" },
    { "type": "text", "id": "founder_link_text", "label": "Link text", "default": "More from our socials" }
  ],
  "presets": [{ "name": "Bay Blog index" }]
}
{% endschema %}
