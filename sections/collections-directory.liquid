{%- comment -%} Collections directory, curated, shoppable index of the whole store {%- endcomment -%}
{%- liquid
  assign category = 'moisturiser::Moisturisers,cleansers-toners-at-theskinbay::Cleansers & Toners,facial-serum::Serums,eye-cream::Eye Care,face-masks::Face Masks,exfoliators-1::Exfoliators,make-up::Make Up,hair-care::Hair,body-care::Body,suncare::SPF & Suncare,health-wellness::Wellness'
  assign concern = 'skincare-for-anti-aging-skin::Anti-Ageing,fine-lines-wrinkles::Fine Lines & Wrinkles,pigmentation-dark-spots::Pigmentation,skincare-for-acne-blemish-prone::Acne & Blemish,dry-dehydrated-skin::Dry & Dehydrated,sensitive-skin::Sensitive,menopause::Menopause,teenage-skin::Teenage,post-procedure::Post-Procedure,pregnancy::Pregnancy,sun-damaged-1::Sun Damaged,vegan::Vegan'
  assign brand = 'avene::Avène,caromed-italia::Caromed Italia,cebelia::Cébélia,cerave::CeraVe,cliniccare::ClinicCare,heliocare::Heliocare,jane-iredale::Jane Iredale,la-roche-posay::La Roche-Posay,medik8::Medik8,nad-home::NAD+ At Home,olaplex::Olaplex,skinade::Skinade,skinceuticals::SkinCeuticals,vichy::Vichy,vita-liberata::Vita Liberata,voya::Voya,amalian::Amalian'
  assign skintype = 'normal-skin::Normal,dry-dehydrated-skin::Dry,oily-skin::Oily,rosacea-redness::Red / Rosacea'
  assign ingredient = 'vitamin-c-products::Vitamin C,retinol::Retinol,medik8-retinol-collection::Retinal,retinoate::Retinoate,hyaluronic-acid::Hyaluronic Acid,vitamin-a::Vitamin A,peptides::Peptides'
  assign explore = 'new-in::New In,gift-ideas::Gifting,sale::Sale,bundle-deals::Bundles & Offers,all-products::View All Products'
  assign category_arr = category | split: ','
  assign concern_arr = concern | split: ','
  assign brand_arr = brand | split: ','
  assign skintype_arr = skintype | split: ','
  assign ingredient_arr = ingredient | split: ','
  assign explore_arr = explore | split: ','
  # hero brand ranges
  assign cerave_arr = 'facial-moisturisers::Facial Moisturisers,facial-cleansers::Cleansers,facial-serums::Serums,cerave-eye-care::Eye Care,cerave-suncare::Sun Care,bath-body-wash::Body,cerave-bundles-1::Bundles' | split: ','
  assign lrp_arr = 'la-roche-posay-anthelios::Anthelios,la-roche-posay-effaclar::Effaclar,la-roche-posay-toleriane-1::Toleriane,la-roche-posay-lipikar::Lipikar,la-roche-posay-cicaplast::Cicaplast,la-roche-posay-hyalu-b5-1::Hyalu B5,la-roche-posay-hydraphase::Hydraphase,la-roche-posay-retinol::Retinol B3,la-roche-posay-mela-b3::Mela B3,la-roche-posay-rosaliac::Rosaliac,la-roche-posay-spf::SPF,la-roche-posay-moisturisers::Moisturisers,la-roche-posay-cleanser::Cleansers,la-roche-posay-serums::Serums,la-roche-posay-eye-lips::Eye + Lips,la-roche-posay-kerium::Kerium' | split: ','
  assign sc_arr = 'skinceuticals-prevent::Prevent,skinceuticals-protect-2::Protect,skinceuticals-correct-1::Correct,skinceuticals-cleansers::Cleanse + Tone,skinceuticals-moisturisers::Moisture,skinceuticals-bundles::Bundles' | split: ','
  assign medik8_arr = 'medik8-vitamin-c-collection::Vitamin C,medik8-retinol-collection::Vitamin A,medik8-serums::Serums,medik8-moisturisers::Moisturisers,medik8-exfoliating-acids::Exfoliating Acids,cleansers-toners-1::Cleanse + Tone,eyes-lips::Eye,sunscreens::Sunscreen' | split: ','
  assign avene_arr = 'avene-cleanser-collection::Cleansers,avene-serum::Serums,avene-sun-care::Sun Care,avene-cicalfate::Cicalfate,avene-cleanance::Cleanance,avene-hyaluron-activ-b3::Hyaluron Activ B3,avene-thermal-spring-water::Thermal Spring Water' | split: ','
  assign vichy_arr = 'mineral-89::Minéral 89,liftactiv::LiftActiv,vichy-capital-soleil::Capital Soleil,vichy-neovidiol::Neovadiol,vichy-normaderm::Normaderm,vichy-aqualia::Aqualia,vichy-slow-age::Slow Age,vichy-purete-thermale::Pureté Thermale,vichy-moisturisers::Moisturisers,vichy-cleansers::Cleansers,vichy-serums::Serums,vichy-sun-care::Sun Care,vichy-eye-care::Eye Care,vichy-haircare::Dercos Hair' | split: ','
-%}

<section class="cd" data-section-id="{{ section.id }}">
  <div class="cd-inner">

    <header class="cd-hero">
      <p class="cd-eyebrow">The Skin Bay</p>
      <h1 class="cd-title">Collections</h1>
      <p class="cd-lede">Explore the full range, shop by category, skin concern or your favourite clinic-backed brands.</p>
    </header>

    {%- comment -%} ---- FOUNDER NOTE ---- {%- endcomment -%}
    <div class="cd-founder">
      <div class="cd-founder-photo"><img src="{{ 'email-founder-emmalee.jpg' | asset_url }}" alt="Emmalee Fitton, Founder of The Skin Bay" width="140" height="140" loading="lazy"></div>
      <div class="cd-founder-body">
        <p class="cd-founder-kicker">A Note From Our Founder</p>
        <p class="cd-founder-name">Emmalee</p>
        <p class="cd-founder-quote">Each collection here is carefully curated to help and guide your shopping experience with The Skin Bay, grouped by category, concern and brand, so whatever your skin needs, you&rsquo;ll find your way to it. Consider this your shortcut to the products and brands I truly believe in.</p>
      </div>
    </div>

    {%- comment -%} ---- SHOP BY CATEGORY (carousel) ---- {%- endcomment -%}
    <div class="cd-group">
      <div class="cd-group-head"><span class="cd-kicker">Shop by</span><h2 class="cd-h2">Category</h2></div>
      <div class="cd-carousel">
        <button class="cd-arrow cd-prev" type="button" aria-label="Scroll left" data-dir="-1">&#8249;</button>
        <div class="cd-tiles" data-track>
          {%- for it in category_arr -%}
            {%- assign p = it | split: '::' -%}{%- assign h = p[0] -%}{%- assign lbl = p[1] -%}
            {%- assign col = collections[h] -%}
            {%- if col != empty -%}
              {%- assign img = col.image -%}{%- unless img -%}{%- assign img = col.products.first.featured_image -%}{%- endunless -%}
              <a class="cd-tile" href="/collections/{{ h }}">
                <span class="cd-tile-img">{% if img %}<img src="{{ img | image_url: width: 500 }}" alt="{{ lbl }}" loading="lazy" width="500" height="500">{% endif %}</span>
                <span class="cd-tile-label">{{ lbl }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button class="cd-arrow cd-next" type="button" aria-label="Scroll right" data-dir="1">&#8250;</button>
      </div>
    </div>

    {%- comment -%} ---- SHOP BY CONCERN (carousel) ---- {%- endcomment -%}
    <div class="cd-group">
      <div class="cd-group-head"><span class="cd-kicker">Shop by</span><h2 class="cd-h2">Concern</h2></div>
      <div class="cd-carousel">
        <button class="cd-arrow cd-prev" type="button" aria-label="Scroll left" data-dir="-1">&#8249;</button>
        <div class="cd-tiles" data-track>
          {%- for it in concern_arr -%}
            {%- assign p = it | split: '::' -%}{%- assign h = p[0] -%}{%- assign lbl = p[1] -%}
            {%- assign col = collections[h] -%}
            {%- if col != empty -%}
              {%- assign img = col.image -%}{%- unless img -%}{%- assign img = col.products.first.featured_image -%}{%- endunless -%}
              <a class="cd-tile" href="/collections/{{ h }}">
                <span class="cd-tile-img">{% if img %}<img src="{{ img | image_url: width: 500 }}" alt="{{ lbl }}" loading="lazy" width="500" height="500">{% endif %}</span>
                <span class="cd-tile-label">{{ lbl }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <button class="cd-arrow cd-next" type="button" aria-label="Scroll right" data-dir="1">&#8250;</button>
      </div>
    </div>

    {%- comment -%} ---- SHOP BY BRAND (pills) ---- {%- endcomment -%}
    <div class="cd-group">
      <div class="cd-group-head"><span class="cd-kicker">Shop by</span><h2 class="cd-h2">Brand</h2></div>
      <div class="cd-pills">
        {%- for it in brand_arr -%}
          {%- assign p = it | split: '::' -%}{%- assign h = p[0] -%}{%- assign lbl = p[1] -%}
          {%- if collections[h] != empty -%}<a class="cd-pill" href="/collections/{{ h }}">{{ lbl }}</a>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---- FEATURED BRANDS, SHOP BY RANGE (accordions) ---- {%- endcomment -%}
    <div class="cd-group">
      <div class="cd-group-head"><span class="cd-kicker">Featured</span><h2 class="cd-h2 cd-h2-sm">Shop Brands by Range</h2></div>

      <details class="cd-acc">
        <summary class="cd-acc-sum">CeraVe</summary>
        <div class="cd-pills cd-acc-pills"><a class="cd-pill cd-pill-dark" href="/collections/cerave">Shop all CeraVe</a>
          {%- for it in cerave_arr -%}{%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </details>

      <details class="cd-acc">
        <summary class="cd-acc-sum">La Roche-Posay</summary>
        <div class="cd-pills cd-acc-pills"><a class="cd-pill cd-pill-dark" href="/collections/la-roche-posay">Shop all La Roche-Posay</a>
          {%- for it in lrp_arr -%}{%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </details>

      <details class="cd-acc">
        <summary class="cd-acc-sum">SkinCeuticals</summary>
        <div class="cd-pills cd-acc-pills"><a class="cd-pill cd-pill-dark" href="/collections/skinceuticals">Shop all SkinCeuticals</a>
          {%- for it in sc_arr -%}{%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </details>

      <details class="cd-acc">
        <summary class="cd-acc-sum">Medik8</summary>
        <div class="cd-pills cd-acc-pills"><a class="cd-pill cd-pill-dark" href="/collections/medik8">Shop all Medik8</a>
          {%- for it in medik8_arr -%}{%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </details>

      <details class="cd-acc">
        <summary class="cd-acc-sum">Avène</summary>
        <div class="cd-pills cd-acc-pills"><a class="cd-pill cd-pill-dark" href="/collections/avene">Shop all Avène</a>
          {%- for it in avene_arr -%}{%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </details>

      <details class="cd-acc">
        <summary class="cd-acc-sum">Vichy</summary>
        <div class="cd-pills cd-acc-pills"><a class="cd-pill cd-pill-dark" href="/collections/vichy">Shop all Vichy</a>
          {%- for it in vichy_arr -%}{%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}{%- endfor -%}
        </div>
      </details>
    </div>

    <div class="cd-cols">
      {%- comment -%} ---- SKIN TYPE (pills) ---- {%- endcomment -%}
      <div class="cd-group cd-col">
        <div class="cd-group-head"><span class="cd-kicker">Shop by</span><h2 class="cd-h2 cd-h2-sm">Skin Type</h2></div>
        <div class="cd-pills">
          {%- for it in skintype_arr -%}
            {%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- comment -%} ---- INGREDIENT (pills) ---- {%- endcomment -%}
      <div class="cd-group cd-col">
        <div class="cd-group-head"><span class="cd-kicker">Shop by</span><h2 class="cd-h2 cd-h2-sm">Active Ingredient</h2></div>
        <div class="cd-pills">
          {%- for it in ingredient_arr -%}
            {%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} ---- EXPLORE (pills) ---- {%- endcomment -%}
    <div class="cd-group">
      <div class="cd-group-head"><span class="cd-kicker">Explore</span><h2 class="cd-h2 cd-h2-sm">Offers & More</h2></div>
      <div class="cd-pills">
        {%- for it in explore_arr -%}
          {%- assign p = it | split: '::' -%}{%- if collections[p[0]] != empty -%}<a class="cd-pill cd-pill-dark" href="/collections/{{ p[0] }}">{{ p[1] }}</a>{%- endif -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</section>

<style>
  .cd{background:#fff;color:#141414;}
  .cd-inner{max-width:1280px;margin:0 auto;padding:48px 24px 72px;}
  .cd-hero{text-align:center;margin-bottom:44px;}
  .cd-eyebrow{font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:12px;color:#8a8377;margin:0 0 10px;}
  .cd-title{font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:clamp(34px,5vw,56px);line-height:1.05;margin:0 0 14px;}
  .cd-lede{font-family:'Lato',sans-serif;font-size:16px;line-height:1.6;color:#5c574e;max-width:620px;margin:0 auto;}
  /* founder note */
  .cd-founder{display:flex;gap:24px;align-items:center;background:#F9F3ED;border-radius:10px;padding:24px 30px;margin-bottom:40px;}
  .cd-founder-photo{flex:0 0 auto;}
  .cd-founder-photo img{width:140px;height:140px;border-radius:50%;object-fit:cover;display:block;}
  .cd-founder-kicker{font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.22em;font-size:12px;color:#8a8377;margin:0 0 2px;}
  .cd-founder-name{font-family:'Playfair Display',cursive;font-weight:700;font-size:22px;line-height:1;color:#141414;margin:0 0 7px;}
  .cd-founder-quote{font-family:'Lato',sans-serif;font-style:italic;font-size:15.5px;line-height:1.65;color:#413d36;margin:0;max-width:780px;}
  @media (max-width:749px){
    .cd-founder{flex-direction:column;text-align:center;padding:28px 20px;gap:18px;}
    .cd-founder-photo img{width:118px;height:118px;}
    .cd-founder-quote{font-size:14.5px;}
  }
  .cd-group{margin-bottom:48px;}
  .cd-group-head{display:flex;align-items:baseline;gap:12px;margin-bottom:22px;padding-bottom:14px;border-bottom:1px solid #ece7df;}
  .cd-kicker{font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.2em;font-size:11px;color:#a49c8d;}
  .cd-h2{font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:clamp(24px,3vw,34px);margin:0;line-height:1;}
  .cd-h2-sm{font-size:clamp(20px,2.2vw,26px);}
  /* carousel */
  .cd-carousel{position:relative;}
  .cd-tiles{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding:2px 2px 10px;scrollbar-width:none;-ms-overflow-style:none;}
  .cd-tiles::-webkit-scrollbar{display:none;}
  .cd-tile{flex:0 0 200px;scroll-snap-align:start;display:flex;flex-direction:column;text-decoration:none;color:#141414;}
  .cd-tile-img{display:block;aspect-ratio:1/1;background:#f5f1ea;overflow:hidden;border-radius:6px;}
  .cd-tile-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;}
  .cd-tile:hover .cd-tile-img img{transform:scale(1.05);}
  .cd-tile-label{font-family:'Lato',sans-serif;font-size:15px;font-weight:600;letter-spacing:.01em;margin-top:12px;text-align:center;}
  .cd-arrow{position:absolute;top:38%;transform:translateY(-50%);z-index:3;width:42px;height:42px;border-radius:50%;border:1px solid #ddd6ca;background:#fff;color:#141414;font-size:22px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 12px rgba(0,0,0,.1);transition:background .2s,color .2s;}
  .cd-arrow:hover{background:#141414;color:#fff;border-color:#141414;}
  .cd-prev{left:-10px;} .cd-next{right:-10px;}
  /* pills */
  .cd-pills{display:flex;flex-wrap:wrap;gap:12px;}
  .cd-pill{font-family:'Lato',sans-serif;font-size:13px;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;color:#141414;border:1px solid #141414;border-radius:999px;padding:11px 22px;transition:all .25s ease;white-space:nowrap;}
  .cd-pill:hover{background:#141414;color:#fff;}
  .cd-pill-dark{background:#141414;color:#fff;}
  .cd-pill-dark:hover{background:#fff;color:#141414;}
  /* accordions */
  .cd-acc{border-bottom:1px solid #ece7df;}
  .cd-acc-sum{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;padding:18px 4px;font-family:'Playfair Display',Georgia,serif;font-size:clamp(19px,2vw,23px);color:#141414;}
  .cd-acc-sum::-webkit-details-marker{display:none;}
  .cd-acc-sum::after{content:'+';font-family:'Lato',sans-serif;font-size:24px;color:#a49c8d;line-height:1;}
  .cd-acc[open] .cd-acc-sum::after{content:'\2013';}
  .cd-acc-pills{padding:2px 4px 24px;}
  .cd-cols{display:grid;grid-template-columns:1fr 1fr;gap:40px;}
  .cd-cols .cd-group{margin-bottom:0;}
  @media (max-width:749px){
    .cd-inner{padding:32px 16px 56px;}
    .cd-tile{flex:0 0 46%;}
    .cd-tile-label{font-size:13px;}
    .cd-arrow{display:none;}
    .cd-cols{grid-template-columns:1fr;gap:36px;}
    .cd-group{margin-bottom:40px;}
    .cd-pill{font-size:12px;padding:10px 18px;}
  }
</style>

<script>
  (function(){
    var root=document.querySelector('.cd[data-section-id="{{ section.id }}"]');
    if(!root){return;}
    root.querySelectorAll('.cd-carousel').forEach(function(c){
      var track=c.querySelector('[data-track]');
      if(!track){return;}
      c.querySelectorAll('.cd-arrow').forEach(function(btn){
        btn.addEventListener('click',function(){
          var dir=parseInt(btn.getAttribute('data-dir'),10)||1;
          track.scrollBy({left:dir*Math.round(track.clientWidth*0.8),behavior:'smooth'});
        });
      });
    });
  })();
</script>

