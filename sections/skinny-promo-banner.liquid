<style>
  .sp-banner-wrap { width:100%; }
  .sp-banner-wrap * , .sp-banner-wrap *::before, .sp-banner-wrap *::after { box-sizing:border-box; }
  .sp-banner-inner { margin:0 auto; }
  .sp-banner-inner.sp-constrained { max-width:1560px; padding:0 40px; }
  .sp-banner-link { display:block; line-height:0; }
  .sp-banner-img { display:block; width:100%; height:auto; }
  .sp-banner-desktop { display:block; }
  .sp-banner-mobile  { display:none; }
  .sp-banner-cta { text-align:center; margin-top:10px; line-height:1.2; }
  .sp-banner-cta a {
    font-family:var(--font-body--family), sans-serif;
    font-size:.625rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
    color:inherit; text-decoration:none; border-bottom:1px solid currentColor; padding-bottom:1px;
    transition:opacity .15s;
  }
  .sp-banner-cta a:hover { opacity:.6; }
  .sp-banner-placeholder {
    width:100%; min-height:60px; display:flex; align-items:center; justify-content:center;
    background:#eef0f7; color:#5b6bc0; font-family:var(--font-body--family), sans-serif; font-size:11px;
    letter-spacing:.1em; text-transform:uppercase;
  }
  @media (max-width:749px) {
    .sp-banner-inner.sp-constrained { padding:0 20px; }
    .sp-banner-swap .sp-banner-desktop { display:none; }
    .sp-banner-swap .sp-banner-mobile  { display:block; }
  }
</style>

{%- assign sp_link = section.settings.link -%}
{%- assign sp_d = section.settings.image_desktop -%}
{%- assign sp_m = section.settings.image_mobile -%}
{%- assign sp_alt = section.settings.alt_text | default: section.settings.button_label -%}
{%- assign sp_target = '' -%}
{%- if section.settings.open_new_tab -%}{%- assign sp_target = ' target="_blank" rel="noopener"' -%}{%- endif -%}

{%- comment -%} Decide swap behaviour: swap only when BOTH images exist {%- endcomment -%}
{%- assign sp_has_both = false -%}
{%- if sp_d != blank and sp_m != blank -%}{%- assign sp_has_both = true -%}{%- endif -%}

<div class="sp-banner-wrap" style="background:{{ section.settings.bg_color }};padding:{{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="sp-banner-inner{% unless section.settings.full_width %} sp-constrained{% endunless %}{% if sp_has_both %} sp-banner-swap{% endif %}">

    {%- capture sp_images -%}
      {%- if sp_has_both -%}
        <img class="sp-banner-img sp-banner-desktop"
             src="{{ sp_d | image_url: width: 2000 }}"
             srcset="{{ sp_d | image_url: width: 1000 }} 1000w, {{ sp_d | image_url: width: 1600 }} 1600w, {{ sp_d | image_url: width: 2000 }} 2000w, {{ sp_d | image_url: width: 2600 }} 2600w"
             sizes="100vw" width="{{ sp_d.width }}" height="{{ sp_d.height }}"
             alt="{{ sp_alt | escape }}" loading="lazy">
        <img class="sp-banner-img sp-banner-mobile"
             src="{{ sp_m | image_url: width: 800 }}"
             srcset="{{ sp_m | image_url: width: 500 }} 500w, {{ sp_m | image_url: width: 800 }} 800w, {{ sp_m | image_url: width: 1200 }} 1200w"
             sizes="100vw" width="{{ sp_m.width }}" height="{{ sp_m.height }}"
             alt="{{ sp_alt | escape }}" loading="lazy">
      {%- elsif sp_d != blank -%}
        <img class="sp-banner-img"
             src="{{ sp_d | image_url: width: 2000 }}"
             srcset="{{ sp_d | image_url: width: 800 }} 800w, {{ sp_d | image_url: width: 1600 }} 1600w, {{ sp_d | image_url: width: 2000 }} 2000w, {{ sp_d | image_url: width: 2600 }} 2600w"
             sizes="100vw" width="{{ sp_d.width }}" height="{{ sp_d.height }}"
             alt="{{ sp_alt | escape }}" loading="lazy">
      {%- elsif sp_m != blank -%}
        <img class="sp-banner-img"
             src="{{ sp_m | image_url: width: 1200 }}"
             srcset="{{ sp_m | image_url: width: 500 }} 500w, {{ sp_m | image_url: width: 800 }} 800w, {{ sp_m | image_url: width: 1200 }} 1200w"
             sizes="100vw" width="{{ sp_m.width }}" height="{{ sp_m.height }}"
             alt="{{ sp_alt | escape }}" loading="lazy">
      {%- else -%}
        <div class="sp-banner-placeholder">Add a banner image in the theme editor</div>
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.image_is_link and sp_link != blank -%}
      <a href="{{ sp_link }}" class="sp-banner-link"{{ sp_target }} aria-label="{{ sp_alt | escape }}">{{ sp_images }}</a>
    {%- else -%}
      {{ sp_images }}
    {%- endif -%}

    {%- if section.settings.show_button and sp_link != blank -%}
      <div class="sp-banner-cta" style="color:{{ section.settings.button_color }};">
        <a href="{{ sp_link }}"{{ sp_target }}>{{ section.settings.button_label | default: 'Shop Now' }}</a>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Skinny Promo Banner",
  "tag": "section",
  "class": "lf-skinny-promo",
  "settings": [
    { "type": "header",  "content": "Images" },
    { "type": "paragraph", "content": "Upload a wide, short image for desktop and a taller image for mobile. The right one shows automatically." },
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image (wide & skinny)" },
    { "type": "image_picker", "id": "image_mobile",  "label": "Mobile image" },
    { "type": "text", "id": "alt_text", "label": "Image alt text (accessibility / SEO)", "default": "Shop this offer" },

    { "type": "header",  "content": "Link" },
    { "type": "url", "id": "link", "label": "Offer link (collection, product or page)" },
    { "type": "checkbox", "id": "image_is_link", "label": "Make the whole banner clickable", "default": true },
    { "type": "checkbox", "id": "open_new_tab", "label": "Open link in a new tab", "default": false },

    { "type": "header",  "content": "Shop Now link (optional, below banner)" },
    { "type": "checkbox", "id": "show_button", "label": "Show a separate \"Shop Now\" text link", "default": false },
    { "type": "text",  "id": "button_label", "label": "Link text", "default": "Shop Now" },
    { "type": "color", "id": "button_color", "label": "Link colour", "default": "#111111" },

    { "type": "header",  "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width (edge to edge)", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background colour (shows around the image)", "default": "#ffffff" },
    { "type": "range", "id": "padding_top",    "label": "Top spacing",    "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Skinny Promo Banner" }]
}
{% endschema %}
