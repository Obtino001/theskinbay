{% comment %}
  Collection Banner + Slider (Updated)
  - Left: Full rectangular image banner with overlay text.
  - Right: Product slider.
  - Font: Montserrat.
  - Fully Editable: Sizes, Fonts, Padding.
{% endcomment %}

<div class="cbs-section" id="cbs-{{ section.id }}">
  <div class="page-width cbs-container">
    
    <div class="cbs-wrapper">
      
      <!-- 1. LEFT BANNER (Image Fills Area) -->
      <div class="cbs-banner">
        {%- if section.settings.banner_image != blank -%}
          <img src="{{ section.settings.banner_image | image_url: width: 1000 }}" 
               alt="{{ section.settings.banner_heading | escape }}" 
               class="cbs-banner-bg"
               loading="lazy">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'cbs-placeholder' }}
        {%- endif -%}

        <!-- Overlay for readability -->
        <div class="cbs-overlay" style="background-color: {{ section.settings.overlay_color }}; opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

        <div class="cbs-banner-content">
          {%- if section.settings.banner_heading != blank -%}
            <h2 class="cbs-heading">{{ section.settings.banner_heading }}</h2>
          {%- endif -%}

          {%- if section.settings.banner_text != blank -%}
            <p class="cbs-desc">{{ section.settings.banner_text }}</p>
          {%- endif -%}

          {%- if section.settings.btn_text != blank -%}
            <a href="{{ section.settings.btn_link }}" class="cbs-btn">{{ section.settings.btn_text }}</a>
          {%- endif -%}
        </div>
      </div>

      <!-- 2. RIGHT PRODUCT SLIDER -->
      <div class="cbs-slider-area">
        <div class="cbs-slider-track" id="track-{{ section.id }}">
          {%- if section.settings.collection != blank -%}
            {%- for product in section.settings.collection.products limit: section.settings.product_limit -%}
              <div class="cbs-product-card">
                <a href="{{ product.url }}" class="cbs-product-link">
                  <div class="cbs-product-image-wrap">
                    <img src="{{ product.featured_media | image_url: width: 400 }}" 
                         alt="{{ product.title | escape }}"
                         loading="lazy"
                         class="cbs-prod-img"
                         width="400" height="400">
                  </div>
                  <div class="cbs-product-info">
                    <span class="cbs-vendor">{{ product.vendor }}</span>
                    <h3 class="cbs-product-title">{{ product.title }}</h3>
                    
                    <div class="cbs-stars">★★★★☆ <span style="font-size: 11px; color: #666;">(4.5)</span></div>

                    <div class="cbs-price">
                      {%- if product.compare_at_price > product.price -%}
                        <span class="cbs-price-old">{{ product.compare_at_price | money }}</span>
                        <span class="cbs-price-new">{{ product.price | money }}</span>
                      {%- else -%}
                        <span>{{ product.price | money }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                </a>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Empty State -->
            {%- for i in (1..4) -%}
              <div class="cbs-product-card">
                <div class="cbs-product-image-wrap" style="background: #f4f4f4;">
                   {{ 'product-' | append: i | placeholder_svg_tag }}
                </div>
                <div class="cbs-product-info">
                  <span class="cbs-vendor">Brand Name</span>
                  <h3 class="cbs-product-title">Example Product {{ i }}</h3>
                  <div class="cbs-price"><span>$59.00</span></div>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <!-- Navigation Buttons -->
        <div class="cbs-nav-container">
          <button class="cbs-nav-btn prev-btn" aria-label="Previous">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="cbs-nav-btn next-btn" aria-label="Next">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* --- SECTION BASE --- */
  #cbs-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.pt_mob }}px;
    padding-bottom: {{ section.settings.pb_mob }}px;
    font-family: var(--font-body--family), sans-serif;
    color: {{ section.settings.text_color }};
  }

  .cbs-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 15px;
  }

  @media(min-width: 990px) {
    #cbs-{{ section.id }} {
      padding-top: {{ section.settings.pt_desk }}px;
      padding-bottom: {{ section.settings.pb_desk }}px;
    }
  }

  /* --- WRAPPER (Flexbox) --- */
  .cbs-wrapper {
    display: flex;
    flex-direction: column;
    border: 1px solid #e1e1e1; /* Main Border around whole section */
    background: #fff;
  }

  @media(min-width: 990px) {
    .cbs-wrapper {
      flex-direction: row;
      height: {{ section.settings.desktop_height }}px; /* Adjustable Height */
    }
  }

  /* --- LEFT BANNER (Rectangular Image Area) --- */
  .cbs-banner {
    position: relative;
    width: 100%;
    height: {{ section.settings.mobile_banner_height }}px; /* Mobile Height */
    overflow: hidden;
    flex-shrink: 0;
  }

  @media(min-width: 990px) {
    .cbs-banner {
      width: {{ section.settings.banner_width }}%;
      height: 100%; /* Fills container height */
    }
  }

  /* Background Image (Cover) */
  .cbs-banner-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .cbs-placeholder {
    width: 100%; height: 100%;
    background: #f0f0f0;
    object-fit: cover;
  }

  /* Overlay */
  .cbs-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 2;
  }

  /* Content Text */
  .cbs-banner-content {
    position: relative;
    z-index: 3;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 20px;
    color: {{ section.settings.banner_text_color }};
  }

  .cbs-heading {
    font-family: var(--font-body--family), sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 700;
    margin-bottom: 12px;
    line-height: 1.1;
    color: currentColor;
  }

  .cbs-desc {
    font-family: var(--font-body--family), sans-serif;
    font-size: {{ section.settings.desc_size }}px;
    margin-bottom: 25px;
    line-height: 1.5;
    max-width: 90%;
    color: currentColor;
  }

  .cbs-btn {
    display: inline-block;
    color: currentColor;
    text-decoration: none;
    font-weight: 700;
    font-size: {{ section.settings.btn_size }}px;
    border-bottom: 2px solid currentColor;
    padding-bottom: 4px;
    text-transform: uppercase;
    transition: opacity 0.3s;
  }
  .cbs-btn:hover {
    opacity: 0.7;
  }

  /* --- RIGHT SLIDER --- */
  .cbs-slider-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 30px 0 10px 0; /* Add top padding to align visually */
  }

  .cbs-slider-track {
    display: flex;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    height: 100%;
    align-items: center;
  }
  .cbs-slider-track::-webkit-scrollbar { display: none; }

  /* Product Card */
  .cbs-product-card {
    flex: 0 0 50%; /* Mobile: 2 items */
    scroll-snap-align: start;
    padding: 0 20px;
    box-sizing: border-box;
    border-right: 1px solid #f0f0f0;
  }
  .cbs-product-card:last-child { border-right: none; }

  @media(min-width: 750px) {
    .cbs-product-card { flex: 0 0 33.333%; }
  }
  @media(min-width: 1100px) {
    .cbs-product-card { flex: 0 0 25%; }
  }

  .cbs-product-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .cbs-product-image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .cbs-prod-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .cbs-vendor {
    font-size: 11px;
    text-transform: uppercase;
    color: #888;
    display: block;
    margin-bottom: 5px;
  }

  .cbs-product-title {
    font-size: 14px;
    font-weight: 500;
    margin: 0 0 8px;
    line-height: 1.4;
    min-height: 40px; 
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cbs-price {
    font-size: 16px;
    font-weight: 700;
  }
  .cbs-price-old {
    text-decoration: line-through;
    color: #aaa;
    font-weight: 400;
    margin-right: 8px;
    font-size: 14px;
  }
  .cbs-price-new {
    color: #d32f2f;
  }

  /* Navigation Buttons */
  .cbs-nav-container {
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid #eee;
    margin-top: auto; 
    width: 100%;
  }
  
  /* On desktop, absolute bottom right */
  @media(min-width: 990px) {
    .cbs-nav-container {
        position: absolute;
        bottom: 0;
        right: 0;
        width: auto;
    }
  }

  .cbs-nav-btn {
    width: 50px;
    height: 50px;
    background: #fff;
    border: 1px solid #eee;
    border-right: none;
    border-bottom: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
  }
  .cbs-nav-btn:last-child {
    border-right: 1px solid #eee;
  }
  .cbs-nav-btn:hover {
    background: #f9f9f9;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const sectionId = "{{ section.id }}";
    const track = document.getElementById(`track-${sectionId}`);
    const prevBtn = track.parentElement.querySelector('.prev-btn');
    const nextBtn = track.parentElement.querySelector('.next-btn');

    if (!track || !prevBtn || !nextBtn) return;

    nextBtn.addEventListener('click', () => {
      const itemWidth = track.querySelector('.cbs-product-card').offsetWidth;
      track.scrollBy({ left: itemWidth, behavior: 'smooth' });
    });

    prevBtn.addEventListener('click', () => {
      const itemWidth = track.querySelector('.cbs-product-card').offsetWidth;
      track.scrollBy({ left: -itemWidth, behavior: 'smooth' });
    });
  });
</script>

{% schema %}
{
  "name": "Collection Banner Slider",
  "settings": [
    {
      "type": "header",
      "content": "Data Source"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Number of products",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout Dimensions"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 300,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Section Height (Desktop)",
      "default": 450
    },
    {
      "type": "range",
      "id": "banner_width",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Left Banner Width",
      "default": 33
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Banner Height (Mobile)",
      "default": 350
    },
    {
      "type": "header",
      "content": "Left Banner Content"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image (Fills Box)"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Image Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 0
    },
    {
      "type": "color",
      "id": "banner_text_color",
      "label": "Banner Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "banner_heading",
      "label": "Heading",
      "default": "Medik8"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 36
    },
    {
      "type": "textarea",
      "id": "banner_text",
      "label": "Description",
      "default": "Visibly smooth, fade dark spots & firm with the Advanced Retinal Serum."
    },
    {
      "type": "range",
      "id": "desc_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 16
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "range",
      "id": "btn_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 14
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Page Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "pt_desk",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "pb_desk",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 36
    },
    {
      "type": "range",
      "id": "pt_mob",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "pb_mob",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Collection Banner Slider"
    }
  ]
}
{% endschema %}