{%- assign s = block.settings -%}

<div class="pdp-trust-strip" {{ block.shopify_attributes }}>

  {%- if s.trust_1 != blank or s.trust_2 != blank or s.trust_3 != blank or s.trust_4 != blank -%}
    <div class="lf-trust-grid">

      {%- if s.trust_1 != blank -%}
        <div class="lf-trust-cell">
          <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2L3 7v5c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V7l-9-5zm-1 13l-3-3 1.41-1.41L11 12.17l4.59-4.58L17 9l-6 6z"/>
          </svg>
          <span class="lf-tc-text">{{ s.trust_1 }}</span>
        </div>
      {%- endif -%}

      {%- if s.trust_2 != blank -%}
        <div class="lf-trust-cell">
          <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM15.1 8H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
          </svg>
          <span class="lf-tc-text">{{ s.trust_2 }}</span>
        </div>
      {%- endif -%}

      {%- if s.trust_3 != blank -%}
        <div class="lf-trust-cell">
          <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-.5 1.5l1.96 2.5H17V9.5h2.5zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm2.22-3c-.55-.61-1.35-1-2.22-1s-1.67.39-2.22 1H3v-9h12v9H8.22zm9.78 3c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
          </svg>
          <span class="lf-tc-text">{{ s.trust_3 }}</span>
        </div>
      {%- endif -%}

      {%- if s.trust_4 != blank -%}
        <div class="lf-trust-cell">
          <svg class="lf-tc-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 4H4c-1.11 0-2 .89-2 2v12c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
          </svg>
          <span class="lf-tc-text">{{ s.trust_4 }}</span>
        </div>
      {%- endif -%}

    </div>
  {%- endif -%}

  {%- if s.show_payment_icons and shop.enabled_payment_types != empty -%}
    <ul class="pdp-payment-row" aria-label="Accepted payment methods" role="list">
      {%- for type in shop.enabled_payment_types -%}
        <li class="pdp-payment-icon-item">
          {{ type | payment_type_svg_tag: class: 'pdp-payment-icon' }}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

</div>

{% stylesheet %}

  .pdp-trust-strip {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block-start: 4px;
  }

  /* 2×2 grid, Space NK inspired */
  .lf-trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid rgba(0, 0, 0, 0.07);
  }

  .lf-trust-cell {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 15px 14px;
    border-right: 1px solid rgba(0, 0, 0, 0.07);
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
  }

  .lf-trust-cell:nth-child(even) {
    border-right: none;
  }

  .lf-trust-cell:nth-last-child(-n+2) {
    border-bottom: none;
  }

  .lf-tc-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    fill: currentColor;
    opacity: 0.35;
    margin-top: 1px;
  }

  .lf-tc-text {
    font-family: var(--font-body--family), sans-serif;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-foreground);
    line-height: 1.5;
    opacity: 0.75;
  }

  /* Payment icons */
  .pdp-payment-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .pdp-payment-icon-item {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 0, 0, 0.08);
    padding: 3px 6px;
    background: #fff;
  }

  .pdp-payment-icon {
    height: 17px;
    width: auto;
    display: block;
    opacity: 0.85;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Trust Strip",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Reassurance points"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust point 1",
      "default": "Authentic professional skincare"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust point 2",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust point 3",
      "default": "UK tracked delivery"
    },
    {
      "type": "text",
      "id": "trust_4",
      "label": "Trust point 4",
      "default": "Flexible payment options"
    },
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Trust Strip"
    }
  ]
}
{% endschema %}
