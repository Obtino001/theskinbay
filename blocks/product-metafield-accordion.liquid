{%- liquid
  assign product = closest.product
  assign metafield_value = product.metafields.custom[block.settings.metafield_key]
  assign block_settings = block.settings
-%}

{%- if metafield_value != blank -%}
  {%- capture accordion_content -%}
    <details
      class="details"
      data-testid="accordion-details"
      {%- if block_settings.open_by_default %} open{%- endif %}
      {{ block.shopify_attributes }}
    >
      <summary class="details__header">
        {{ block_settings.heading }}
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
        <span class="svg-wrapper icon-plus">
          {{- 'icon-plus.svg' | inline_asset_content -}}
        </span>
      </summary>
      <div class="details-content rte">
        {{ metafield_value | metafield_tag }}
      </div>
    </details>
  {%- endcapture -%}
  {%- render 'accordion-custom-component',
    children: accordion_content,
    class: 'product-mf-acc',
    open_by_default_on_desktop: block_settings.open_by_default,
    open_by_default_on_mobile: block_settings.open_by_default
  -%}
{%- endif -%}

{% stylesheet %}
  accordion-custom.product-mf-acc .details {
    border-block-start: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
  }

  accordion-custom.product-mf-acc:last-of-type .details {
    border-block-end: 1px solid var(--color-border, rgba(0, 0, 0, 0.12));
  }

  /* Hide native browser <summary> disclosure triangle, all browsers */
  accordion-custom.product-mf-acc .details__header {
    list-style: none;
  }
  accordion-custom.product-mf-acc .details__header::marker { display: none; }
  accordion-custom.product-mf-acc .details__header::-webkit-details-marker { display: none; }

  /* Match heading style to description accordions */
  accordion-custom.product-mf-acc .details__header {
    font-size: 0.6875rem;
    font-family: var(--font-body--family), sans-serif;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  /* Show only + icon, hide animated caret */
  accordion-custom.product-mf-acc .icon-caret { display: none; }
  accordion-custom.product-mf-acc .icon-plus  { display: flex; }

  /* Rotate + to × when open */
  accordion-custom.product-mf-acc .details[open] .icon-plus {
    transform: rotate(45deg);
  }

  accordion-custom.product-mf-acc .details-content {
    padding-block-end: var(--padding-sm, 12px);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-foreground);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Metafield Accordion",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Details"
    },
    {
      "type": "select",
      "id": "metafield_key",
      "label": "Metafield",
      "options": [
        { "value": "description", "label": "Description" },
        { "value": "how_to_use", "label": "How To Use" },
        { "value": "ingredients", "label": "Ingredients" },
        { "value": "pro_tip", "label": "Pro Tip" }
      ],
      "default": "description"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Metafield Accordion",
      "settings": {
        "heading": "Details",
        "metafield_key": "description"
      }
    }
  ]
}
{% endschema %}
