    "nad_faq": {
      "type": "nad-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "q": "What is EGF?",
            "a": "<p>EGF (Epidermal Growth Factor) is a protein that signals skin cells to renew and repair. ClinicCare uses it to support firmer, smoother, healthier-looking skin.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "Is it suitable for my skin type?",
            "a": "<p>ClinicCare is formulated for a range of skin types. Check the product description for specifics, and patch test before first use.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "How soon will I see results?",
            "a": "<p>Skincare rewards consistency. Many people notice improvements in tone and texture within 4 to 6 weeks of regular use.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "How do I use it?",
            "a": "<p>See the how-to-use section above. As a rule, apply to clean skin as part of your morning or evening routine.</p>"
          }
        },
        "q5": {
          "type": "qa",
          "settings": {
            "q": "Can I use it with other products?",
            "a": "<p>Yes. Layer thinnest to thickest, and always finish with SPF in the morning.</p>"
          }
        },
        "q6": {
          "type": "qa",
          "settings": {
            "q": "How should I store it?",
            "a": "<p>Keep it somewhere cool and dry, out of direct sunlight, with the lid closed.</p>"
          }
        },
        "q7": {
          "type": "qa",
          "settings": {
            "q": "How is it delivered?",
            "a": "<p>Discreetly and tracked across the UK.</p>"
          }
        }
      },
