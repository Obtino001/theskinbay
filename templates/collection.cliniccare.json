    "section_bhHgzm": {
      "type": "section",
      "blocks": {
        "custom_liquid_ejjKke": {
          "type": "custom-liquid",
          "name": "Description Liquid -DO NOT DELETE",
          "settings": {
            "custom_liquid": "<style>\n  \/* 2. Container Styling *\/\n  .lux-desc-container {\n    font-family: var(--font-body--family), sans-serif !important;\n    text-align: center;\n    max-width: 800px;\n    margin: 0 auto;\n    padding: 20px 20px;\n    color: #1a1a1a;\n  }\n\n  .lux-desc-text {\n    font-size: 16px;\n    line-height: 1.7;\n    font-weight: 400;\n    margin: 0;\n    display: inline; \/* Keeps text flowing naturally *\/\n  }\n\n  \/* 3. The 'Indescript' Button Styling *\/\n  .lux-read-more-btn {\n    background: none;\n    border: none;\n    padding: 0;\n    margin-left: 5px;\n    font-family: var(--font-body--family), sans-serif;\n    font-size: 12px;\n    font-weight: 600;\n    text-transform: uppercase;\n    text-decoration: underline;\n    color: #555; \/* Slightly lighter than text to be subtle *\/\n    cursor: pointer;\n    transition: color 0.3s ease;\n  }\n\n  .lux-read-more-btn:hover {\n    color: #000;\n  }\n\n  \/* Utility classes for toggling *\/\n  .lux-hidden {\n    display: none;\n  }\n<\/style>\n\n<div class=\"lux-desc-container\">\n  {% if collection.description != blank %}\n    \n    {% comment %} Clean the description first {% endcomment %}\n    {% assign clean_desc = collection.description | strip_html %}\n    \n    {% comment %} Define the limit (45 words) {% endcomment %}\n    {% assign word_limit = 45 %}\n    {% assign short_desc = clean_desc | truncatewords: word_limit, \"...\" %}\n    \n    <!-- The Text Block -->\n    <div class=\"lux-desc-wrapper\">\n      \n      <!-- Short Version (Visible initially) -->\n      <span id=\"lux-short-text\" class=\"lux-desc-text\">\n        {{ short_desc }}\n      <\/span>\n\n      <!-- Full Version (Hidden initially) -->\n      <span id=\"lux-full-text\" class=\"lux-desc-text lux-hidden\">\n        {{ clean_desc }}\n      <\/span>\n\n      <!-- Read More Button (Only shows if description was actually cut off) -->\n      {% if clean_desc.size > short_desc.size %}\n        <button id=\"lux-read-more\" class=\"lux-read-more-btn\" onclick=\"toggleLuxText()\">Read more<\/button>\n      {% endif %}\n      \n    <\/div>\n\n  {% else %}\n    <p class=\"lux-desc-text\">Add a description to this collection to see it appear here.<\/p>\n  {% endif %}\n<\/div>\n\n<script>\n  function toggleLuxText() {\n    var shortText = document.getElementById('lux-short-text');\n    var fullText = document.getElementById('lux-full-text');\n    var btn = document.getElementById('lux-read-more');\n\n    if (shortText.style.display === 'none') {\n      \/\/ If currently expanded, collapse it (optional logic, mostly not needed here)\n      shortText.style.display = 'inline';\n      fullText.style.display = 'none';\n      btn.innerHTML = \"Read more\";\n    } else {\n      \/\/ Expand: Hide short, show full, hide button\n      shortText.style.display = 'none';\n      fullText.style.display = 'inline'; \/\/ Display inline to keep formatting\n      fullText.classList.remove('lux-hidden'); \n      btn.style.display = 'none'; \/\/ Completely remove button after clicking\n    }\n  }\n<\/script>"
          },
          "blocks": {}
        }
      },
