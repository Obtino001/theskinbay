    "custom_liquid_eApdee": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{%- if collection.metafields.custom.branded_banner != blank -%}\n<div class=\"branded-banner-container\">\n  {{ collection.metafields.custom.branded_banner | image_url: width: 2400 | image_tag: \n    loading: 'lazy', \n    widths: '375, 550, 750, 1100, 1500, 1780, 2000, 2400',\n    alt: collection.title,\n    class: 'branded-banner-img'\n  }}\n<\/div>\n\n<style>\n  .branded-banner-container {\n    width: 100%;\n    margin-bottom: 30px;\n    line-height: 0; \/* Fixes tiny white gap at bottom *\/\n    overflow: hidden;\n  }\n\n  .branded-banner-img {\n    width: 100%;\n    height: auto;\n    display: block;\n    object-fit: cover;\n    \/* Sets an elegant slim height for skincare branding *\/\n    max-height: 450px; \n  }\n\n  \/* Mobile settings *\/\n  @media screen and (max-width: 749px) {\n    .branded-banner-container {\n      margin-bottom: 20px;\n    }\n    .branded-banner-img {\n      max-height: 250px; \/* Slightly shorter on mobile *\/\n    }\n  }\n<\/style>\n{%- endif -%}",
        "color_scheme": "",
        "section_width": "full-width",
