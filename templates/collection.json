in: 0 auto;\n    padding: 20px 20px;\n    color: #1a1a1a;\n  }\n\n  .lux-desc-text {\n    font-size: 16px;\n    line-height: 1.7;\n    font-weight: 400;\n    margin: 0;\n    display: inline; \/* Keeps text flowing naturally *\/\n  }\n\n  \/* 3. The 'Indescript' Button Styling *\/\n  .lux-read-more-btn {\n    background: none;\n    border: none;\n    padding: 0;\n    margin-left: 5px;\n    font-family: 'Lato', sans-serif;\n    font-size: 12px;\n    font-weight: 600;\n    text-transform: uppercase;\n    text-decoration: underline;\n    color: #555; \/* Slightly lighter than text to be subtle *\/\n    cursor: pointer;\n    transition: color 0.3s ease;\n  }\n\n  .lux-read-more-btn:hover {\n    color: #000;\n  }\n\n  \/* Utility classes for toggling *\/\n  .lux-hidden {\n    display: none;\n  }\n<\/style>\n\n<div class=\"lux-desc-container\">\n  {% if collection.description != blank %}\n    \n    {% comment %} Clean the description first {% endcomment %}\n    {% assign clean_desc = collection.description | strip_html %}\n    \n    {% comment %} Define the limit (45 words) {% endcomment %}\n    {% assign word_limit = 45 %}\n    {% assign short_desc = clean_desc | truncatewords: word_limit, \"...\" %}\n    \n    <!-- The Text Block -->\n    <div class=\"lux-desc-wrapper\">\n      \n      <!-- Short Version (Visible initially) -->\n      <span id=\"lux-short-text\" class=\"lux-desc-text\">\n        {{ short_desc }}\n      <\/span>\n\n      <!-- Full Version (Hidden initially) -->\n      <span id=\"lux-full-text\" class=\"lux-desc-text lux-hidden\">\n        {{ clean_desc }}\n      <\/span>\n\n      <!-- Read More Button (Only shows if description was actually cut off) -->\n      {% if clean_desc.size > short_desc.size %}\n        <button id=\"lux-read-more\" class=\"lux-read-more-btn\" onclick=\"toggleLuxText()\">Read more<\/button>\n      {% endif %}\n      \n    <\/div>\n\n  {% else %}\n    <p class=\"lux-desc-text\">Add a description to this collection to see it appear here.<\/p>\n  {% endif %}\n<\/div>\n\n<script>\n  function toggleLuxText() {\n    var shortText = document.getElementById('lux-short-text');\n    var fullText = document.getElementById('lux-full-text');\n    var btn = document.getElementById('lux-read-more');\n\n    if (shortText.style.display === 'none') {\n      \/\/ If currently expanded, collapse it (optional logic, mostly not needed here)\n      shortText.style.display = 'inline';\n      fullText.style.display = 'none';\n      btn.innerHTML = \"Read more\";\n    } else {\n      \/\/ Expand: Hide short, show full, hide button\n      shortText.style.display = 'none';\n      fullText.style.display = 'inline'; \/\/ Display inline to keep formatting\n      fullText.classList.remove('lux-hidden'); \n      btn.style.display = 'none'; \/\/ Completely remove button after clicking\n    }\n  }\n<\/script>"},"blocks":{}}},"block_order":["custom_liquid_ejjKke"],"disabled":true,"name":"Collection Description DO NOT DELETE","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"full-width","section_height":"","section_height_custom":50,"color_scheme":"","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":0,"padding-block-end":0}},"main":{"type":"main-collection","blocks":{"filters":{"type":"filters","static":true,"settings":{"enable_filtering":false,"filter_style":"horizontal","filter_width":"centered","text_label_case":"uppercase","show_swatch_label":false,"show_filter_label":false,"enable_sorting":true,"enable_grid_density":true,"inherit_color_scheme":true,"color_sch