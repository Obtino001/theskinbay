    "custom_liquid_AF4h6g": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "\n<style>\n  \/* --- MAIN WRAPPER & TYPOGRAPHY --- *\/\n  .comp-page-wrapper {\n    width: 100%;\n    font-family: var(--font-body--family), sans-serif;\n    color: #1a1a1a;\n    line-height: 1.6;\n    overflow-x: hidden;\n  }\n\n  .comp-container {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n\n  \/* --- HERO SECTION --- *\/\n  .comp-hero {\n    background-color: #000;\n    color: #fff;\n    text-align: center;\n    padding: 60px 20px; \/* Reduced from 100px *\/\n    margin-bottom: 50px; \/* Reduced from 80px *\/\n  }\n\n  .comp-hero h1 {\n    font-family: var(--font-body--family), sans-serif;\n    font-weight: 600;\n    font-size: 2.5rem;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    margin: 0 0 15px 0;\n    color: #fff;\n  }\n\n  .comp-hero p {\n    font-size: 1.1rem;\n    font-weight: 300;\n    max-width: 600px;\n    margin: 0 auto 30px auto;\n    color: #e0e0e0;\n    line-height: 1.5;\n  }\n\n  \/* --- BUTTON STYLE --- *\/\n  .comp-btn {\n    display: inline-block;\n    background-color: #fff;\n    color: #000;\n    padding: 15px 35px;\n    text-decoration: none;\n    text-transform: uppercase;\n    font-weight: 500;\n    letter-spacing: 2px;\n    font-size: 0.85rem;\n    transition: all 0.3s ease;\n    border: 1px solid #fff;\n  }\n  \n  .comp-btn:hover {\n    background-color: transparent;\n    color: #fff;\n  }\n\n  \/* --- SECTION TITLES --- *\/\n  .comp-section-title {\n    text-align: center;\n    text-transform: uppercase;\n    font-weight: 500;\n    letter-spacing: 3px;\n    font-size: 1.6rem;\n    margin-bottom: 40px; \/* Reduced from 60px *\/\n    position: relative;\n  }\n  \n  \/* --- HOW TO ENTER CARDS --- *\/\n  .comp-grid-3 {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 30px;\n    margin-bottom: 60px; \/* Reduced from 100px *\/\n  }\n\n  .comp-step-card {\n    background: #fff;\n    box-shadow: 0 5px 20px rgba(0,0,0,0.05); \n    padding: 40px 20px;\n    text-align: center;\n    transition: transform 0.4s ease, box-shadow 0.4s ease;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .comp-step-card:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 15px 30px rgba(0,0,0,0.08);\n  }\n\n  .icon-wrapper {\n    margin-bottom: 20px;\n    color: #000;\n  }\n  \n  .comp-icon-svg {\n    width: 40px;\n    height: 40px;\n    stroke-width: 1.2px;\n    stroke: #000;\n    fill: none;\n  }\n\n  .step-number {\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    color: #999;\n    margin-bottom: 10px;\n    display: block;\n    font-weight: 500;\n  }\n  \n  .step-desc {\n    font-size: 0.95rem;\n    color: #333;\n    font-weight: 400;\n  }\n\n  \/* --- INFO GRID (Winner & Prize) --- *\/\n  .comp-info-section {\n    background-color: #f7f7f7;\n    padding: 60px 0; \/* Reduced vertical padding *\/\n    margin-bottom: 0; \/* Removed bottom margin completely to close gap to Terms *\/\n  }\n\n  .comp-grid-2 {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 60px;\n    align-items: start;\n  }\n\n  .comp-info-col h3 {\n    font-family: var(--font-body--family), sans-serif;\n    font-size: 1.2rem;\n    text-transform: uppercase;\n    font-weight: 500;\n    letter-spacing: 1.5px;\n    margin-bottom: 20px;\n    border-bottom: 1px solid #000;\n    padding-bottom: 10px;\n    display: inline-block;\n    width: 100%;\n  }\n\n  .comp-list {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n  }\n\n  .comp-list li {\n    margin-bottom: 12px;\n    padding-left: 0;\n    font-size: 0.95rem;\n    color: #444;\n    display: flex;\n    align-items: flex-start;\n  }\n  \n  .comp-list li span.bullet {\n    margin-right: 12px;\n    font-size: 1.2rem;\n    line-height: 1rem;\n    color: #000;\n  }\n\n  .important-note {\n    margin-top: 25px;\n    font-size: 0.85rem;\n    color: #666;\n    padding: 15px;\n    background: #fff;\n    border: 1px solid #eee;\n  }\n\n  \/* --- TERMS SECTION --- *\/\n  .comp-terms {\n    max-width: 900px;\n    margin: 0 auto 60px auto;\n    \/* Removed border-top here to make it feel seamless with the section above, \n       or we can keep it but reduce padding. I'll reduce padding. *\/\n    padding-top: 40px; \n    font-size: 0.8rem;\n    color: #777;\n    line-height: 1.6;\n  }\n\n  .comp-terms h4 {\n    text-transform: uppercase;\n    margin-bottom: 20px;\n    color: #000;\n    font-size: 0.9rem;\n    letter-spacing: 1px;\n  }\n\n  .comp-terms ol {\n    padding-left: 20px;\n  }\n  \n  .comp-terms li {\n    margin-bottom: 8px;\n  }\n\n  \/* --- RESPONSIVE MOBILE --- *\/\n  @media (max-width: 768px) {\n    .comp-grid-3, .comp-grid-2 {\n      grid-template-columns: 1fr;\n      gap: 30px;\n    }\n    \n    .comp-hero {\n        padding: 40px 20px;\n        margin-bottom: 40px;\n    }\n\n    .comp-hero h1 {\n      font-size: 1.8rem;\n    }\n    \n    .comp-step-card {\n      padding: 30px 20px;\n    }\n    \n    .comp-info-section {\n        padding: 40px 0;\n    }\n    \n    .comp-terms {\n        padding-top: 30px;\n    }\n  }\n<\/style>\n\n<div class=\"comp-page-wrapper\">\n\n  <!-- Hero Section -->\n  <div class=\"comp-hero\">\n    <div class=\"comp-container\">\n      <h1>Win Your Entire Order Back<\/h1>\n      <p>Every month, one lucky customer will have their entire order value refunded.<br>Simply share your experience to enter.<\/p>\n      \n      <a href=\"https:\/\/www.instagram.com\/theskinbay.co.uk\/\" target=\"_blank\" class=\"comp-btn\">\n        @theskinbay.co.uk\n      <\/a>\n    <\/div>\n  <\/div>\n\n  <div class=\"comp-container\">\n    \n    <!-- How to Enter -->\n    <h2 class=\"comp-section-title\">How To Enter<\/h2>\n    <div class=\"comp-grid-3\">\n      \n      <!-- Step 1: Camera Icon -->\n      <div class=\"comp-step-card\">\n        <span class=\"step-number\">Step 01<\/span>\n        <div class=\"icon-wrapper\">\n            <svg class=\"comp-icon-svg\" viewBox=\"0 0 24 24\">\n                <path d=\"M23,19a2,2,0,0,1-2,2H3a2,2,0,0,1-2-2V8A2,2,0,0,1,3,6H7L9,3h6l2,3h4a2,2,0,0,1,2,2Z\" \/>\n                <circle cx=\"12\" cy=\"13\" r=\"4\" \/>\n            <\/svg>\n        <\/div>\n        <div class=\"step-desc\">\n            <strong>Post a photo or video<\/strong> of your order on Instagram (Feed post or Reel).<br><br>\n            <span style=\"color:#888; font-size:0.85rem;\">(Reels receive 2 entries)<\/span>\n        <\/div>\n      <\/div>\n\n      <!-- Step 2: Tag Icon -->\n      <div class=\"comp-step-card\">\n        <span class=\"step-number\">Step 02<\/span>\n        <div class=\"icon-wrapper\">\n             <svg class=\"comp-icon-svg\" viewBox=\"0 0 24 24\">\n                <path d=\"M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z\"><\/path>\n                <line x1=\"7\" y1=\"7\" x2=\"7.01\" y2=\"7\"><\/line>\n            <\/svg>\n        <\/div>\n        <div class=\"step-desc\">\n            <strong>Tag @theskinbay.co.uk<\/strong> and include the competition hashtag:<br><br>\n            <strong>#TheSkinBayWin<\/strong>\n        <\/div>\n      <\/div>\n\n      <!-- Step 3: Lock Icon -->\n      <div class=\"comp-step-card\">\n        <span class=\"step-number\">Step 03<\/span>\n        <div class=\"icon-wrapper\">\n            <svg class=\"comp-icon-svg\" viewBox=\"0 0 24 24\">\n                <rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\" ry=\"2\"><\/rect>\n                <path d=\"M7 11V7a5 5 0 0 1 10 0v4\"><\/path>\n            <\/svg>\n        <\/div>\n        <div class=\"step-desc\">\n            <strong>Keep it public<\/strong> until the winner is announced so we can verify your entry.\n        <\/div>\n      <\/div>\n      \n    <\/div>\n  <\/div>\n\n  <!-- Info Section: Winner & Prize -->\n  <div class=\"comp-info-section\">\n    <div class=\"comp-container\">\n      <div class=\"comp-grid-2\">\n        \n        <!-- Winner Column -->\n        <div class=\"comp-info-col\">\n          <h3>Winner Announcement<\/h3>\n          <p style=\"margin-bottom:20px; font-weight:300;\">One winner is selected at random every month from all valid entries.<\/p>\n          <ul class=\"comp-list\">\n            <li><span class=\"bullet\">—<\/span>Announced: The last Friday of each month.<\/li>\n            <li><span class=\"bullet\">—<\/span>Where: Our Instagram Stories.<\/li>\n            <li><span class=\"bullet\">—<\/span>Contact: DM from <strong>@theskinbay.co.uk<\/strong> only.<\/li>\n          <\/ul>\n          <div class=\"important-note\">\n            Please be cautious of fake accounts. We will never ask for card details via DM.\n          <\/div>\n        <\/div>\n\n        <!-- Prize Column -->\n        <div class=\"comp-info-col\">\n          <h3>The Prize<\/h3>\n          <p style=\"margin-bottom:20px; font-weight:300;\">The winner receives a full refund equal to the value of the order featured in their entry.<\/p>\n          <ul class=\"comp-list\">\n            <li><span class=\"bullet\">—<\/span>Refund processed to original payment method.<\/li>\n            <li><span class=\"bullet\">—<\/span>Store credit or bank transfer available if refund fails.<\/li>\n            <li><span class=\"bullet\">—<\/span><strong>Maximum prize value: £250<\/strong><\/li>\n            <li><span class=\"bullet\">—<\/span>Delivery charges are included.<\/li>\n          <\/ul>\n        <\/div>\n\n      <\/div>\n    <\/div>\n  <\/div>\n\n  <!-- Terms Section -->\n  <div class=\"comp-container\">\n    <div class=\"comp-terms\">\n      <h4>Terms & Conditions<\/h4>\n      <ol>\n        <li><strong>Promoter:<\/strong> This competition is run by The Skin Bay. It is not sponsored, endorsed or administered by Instagram.<\/li>\n        <li><strong>Eligibility:<\/strong> Open to United Kingdom residents aged 18+. Employees of The Skin Bay are excluded.<\/li>\n        <li><strong>Promotion Period:<\/strong> Monthly. Opens 00:01 on the 1st, closes 23:59 on the last day of the month.<\/li>\n        <li><strong>Entry Requirements:<\/strong> Valid entries must be posted within the current month, tag @theskinbay.co.uk, use #TheSkinBayWin, and remain public.<\/li>\n        <li><strong>Entry Limit:<\/strong> One entry per order\/post. Reels count as two entries.<\/li>\n        <li><strong>Winner Selection:<\/strong> Random draw will take place within 72 hours of the month closing.<\/li>\n        <li><strong>Claiming Prize:<\/strong> Winner must respond to the winning DM within 72 hours.<\/li>\n        <li><strong>Content Usage:<\/strong> By entering, participants agree The Skin Bay may repost\/share content for marketing purposes.<\/li>\n        <li><strong>General:<\/strong> The Promoter reserves the right to amend or cancel the competition at any time.<\/li>\n      <\/ol>\n      <div style=\"text-align:center; margin-top:40px;\">\n        <strong>Questions?<\/strong> DM us on Instagram or use our website contact page.\n      <\/div>\n    <\/div>\n  <\/div>\n\n<\/div>",
